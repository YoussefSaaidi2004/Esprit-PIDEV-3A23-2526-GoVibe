<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="root"
            fx:controller="org.example.controllers.AdminLocationListController"
            stylesheets="@voiture.css"
            styleClass="app-root">

    <left>
        <VBox prefWidth="240" spacing="0" alignment="TOP_CENTER"
              style="-fx-background-color: #013220;">
            <padding><Insets top="25" right="15" bottom="25" left="15"/></padding>

            <VBox alignment="CENTER" spacing="5">
                <ImageView fitHeight="55.0" fitWidth="55.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@org/example/images/logo.png"/></image>
                </ImageView>
                <Label text="GoVibe" style="-fx-text-fill: #D1F2EB; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Panneau d'administration" style="-fx-text-fill: #A0E0C9; -fx-font-size: 11px;"/>
            </VBox>

            <Region prefHeight="30"/>

            <VBox spacing="4">
                <Button text="📋 Dashboard" onAction="#handleGoDashboard" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
                <Button text="👤 Personnes" onAction="#handleGoPersonnes" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
                <Button text="🚗 Voitures" onAction="#handleGoVoitures" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
                <Button maxWidth="Infinity"
                        style="-fx-background-color: rgba(80,200,120,0.2); -fx-text-fill: #D1F2EB; -fx-font-size: 14px; -fx-padding: 12 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT;">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <SVGPath content="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"
                                     style="-fx-fill: #D1F2EB;" scaleX="0.9" scaleY="0.9"/>
                            <Label text="Locations" style="-fx-text-fill: #D1F2EB; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </HBox>
                    </graphic>
                </Button>
                <Button onAction="#handleGoFlights" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
                                     style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
                            <Label text="Vols" style="-fx-text-fill: #A0E0C9; -fx-font-size: 14px;"/>
                        </HBox>
                    </graphic>
                </Button>
                <Button onAction="#handleGoCheckouts" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <SVGPath content="M19.5 6h-15c-.83 0-1.5.67-1.5 1.5v3c0 .55.45 1 1 1s1 .45 1 1-.45 1-1 1v3c0 .83.67 1.5 1.5 1.5h15c.83 0 1.5-.67 1.5-1.5v-3c0-.55-.45-1-1-1s-1-.45-1-1 .45-1 1-1v-3c0-.83-.67-1.5-1.5-1.5z"
                                     style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
                            <Label text="Checkouts" style="-fx-text-fill: #A0E0C9; -fx-font-size: 14px;"/>
                        </HBox>
                    </graphic>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="8" alignment="CENTER">
                <Separator style="-fx-border-color: #084E36;"/>
                <Button text="🚪 Déconnexion" onAction="#handleLogout" maxWidth="Infinity"
                        style="-fx-background-color: rgba(231,76,60,0.15); -fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-padding: 10 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="18.0">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <children>
                <Label text="Admin - Gestion des Locations" styleClass="page-title"/>
                <HBox spacing="12.0" styleClass="toolbar">
                    <children>
                        <TextField fx:id="searchField" promptText="Rechercher..."
                                   styleClass="input-field search-field"/>
                        <ComboBox fx:id="voitureFilter" promptText="Voiture"
                                  styleClass="input-field filter-combo"/>
                        <ComboBox fx:id="sortChoice" promptText="Tri"
                                  styleClass="input-field filter-combo"/>
                        <ComboBox fx:id="pageSizeBox" promptText="Page"
                                  styleClass="input-field page-size"/>
                        <Button fx:id="exportPdfButton" text="Exporter PDF" onAction="#handleExportPdf"
                                styleClass="btn btn-primary"/>
                        <Button fx:id="exportExcelButton" text="Exporter Excel" onAction="#handleExportExcel"
                                styleClass="btn btn-primary"/>
                        <Button fx:id="themeToggleButton" text="Mode sombre" onAction="#handleToggleTheme"
                                styleClass="btn"/>
                    </children>
                </HBox>
                <HBox spacing="12.0" styleClass="stats-row">
                    <children>
                        <VBox styleClass="stat-card">
                            <children>
                                <Label text="Total" styleClass="stat-label"/>
                                <Label fx:id="totalCountLabel" text="0" styleClass="stat-value"/>
                            </children>
                        </VBox>
                        <VBox styleClass="stat-card">
                            <children>
                                <Label text="Confirmees" styleClass="stat-label"/>
                                <Label fx:id="confirmedCountLabel" text="0" styleClass="stat-value"/>
                            </children>
                        </VBox>
                        <VBox styleClass="stat-card">
                            <children>
                                <Label text="Montant total" styleClass="stat-label"/>
                                <Label fx:id="totalRevenueLabel" text="0" styleClass="stat-value"/>
                            </children>
                        </VBox>
                        <VBox styleClass="stat-card">
                            <children>
                                <Label text="Top voiture" styleClass="stat-label"/>
                                <Label fx:id="topVoitureLabel" text="-" styleClass="stat-value"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox spacing="12.0">
                    <children>
                        <Label text="Liste des locations" styleClass="section-title"/>
                        <ListView fx:id="locationList" prefHeight="560.0" styleClass="voiture-list"/>
                        <HBox spacing="10.0" styleClass="pagination-bar">
                            <children>
                                <Button fx:id="prevPageButton" text="Precedent" onAction="#handlePrevPage"
                                        styleClass="btn btn-primary"/>
                                <Label fx:id="pageInfoLabel" text="Page 0 / 0" styleClass="page-info"/>
                                <Button fx:id="nextPageButton" text="Suivant" onAction="#handleNextPage"
                                        styleClass="btn btn-primary"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>

</BorderPane>

