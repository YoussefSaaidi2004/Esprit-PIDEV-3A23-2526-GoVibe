<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.AdminMessagesController"
            style="-fx-background-color: #f8f9fa;">

    <!-- Sidebar Admin -->
    <left>
        <fx:include source="org/example/AdminSidebar.fxml" fx:id="adminSidebar"/>
    </left>

    <!-- Main Content -->
    <center>
        <VBox spacing="15" style="-fx-padding: 25;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: linear-gradient(to right, #013220, #0B4F35); -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 5);">
                <VBox spacing="5">
                    <Label text="📨 Messagerie Admin" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Gérez les messages des clients" style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblCount" text="0 messages en attente" style="-fx-font-size: 14px; -fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Filtres -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Filtrer par status:" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                <ComboBox fx:id="comboFiltre" prefWidth="150" 
                         style="-fx-background-radius: 20; -fx-font-size: 13px;"/>
                <Button fx:id="btnRafraichir" onAction="#rafraichir"
                       style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 20; -fx-background-radius: 20; -fx-cursor: hand;"
                       text="🔄 Rafraîchir"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Table des messages -->
            <TableView fx:id="tableMessages" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                <columns>
                    <TableColumn fx:id="colClient" text="Client" prefWidth="150" style="-fx-font-size: 13px;"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="180" style="-fx-font-size: 13px;"/>
                    <TableColumn fx:id="colSujet" text="Sujet" prefWidth="200" style="-fx-font-size: 13px;"/>
                    <TableColumn fx:id="colMessage" text="Message" prefWidth="250" style="-fx-font-size: 13px;"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="100" style="-fx-font-size: 13px; -fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="120" style="-fx-font-size: 13px;"/>
                </columns>
                <placeholder>
                    <Label text="Aucun message reçu 📭" style="-fx-font-size: 14px; -fx-text-fill: #888;"/>
                </placeholder>
            </TableView>

            <!-- Boutons d'action Admin -->
            <HBox spacing="12" alignment="CENTER" style="-fx-padding: 10 0;">
                <Button fx:id="btnVoir" onAction="#voirDetails"
                       style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 10 20; -fx-background-radius: 20; -fx-cursor: hand;"
                       text="👁️ Voir"/>
                <Button fx:id="btnRepondre" onAction="#repondre"
                       style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 10 20; -fx-background-radius: 20; -fx-cursor: hand;"
                       text="💬 Répondre"/>
                <Button fx:id="btnModifierRep" onAction="#modifierReponse"
                       style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 10 20; -fx-background-radius: 20; -fx-cursor: hand;"
                       text="✏️ Modif. Réponse"/>
                <Button fx:id="btnSupprimer" onAction="#supprimerMessage"
                       style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 10 20; -fx-background-radius: 20; -fx-cursor: hand;"
                       text="🗑️ Supprimer"/>
                <Button fx:id="btnFermer" onAction="#fermerMessage"
                       style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 10 20; -fx-background-radius: 20; -fx-cursor: hand;"
                       text="✅ Fermer"/>
            </HBox>

        </VBox>
    </center>
</BorderPane>
