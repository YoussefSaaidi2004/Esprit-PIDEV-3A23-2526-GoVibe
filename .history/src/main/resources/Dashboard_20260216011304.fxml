<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.DashboardActiviteController">

    <!-- ==================== LEFT SIDEBAR (Menu Admin Commun) ==================== -->
    <left>
        <fx:include source="org/example/AdminSidebar.fxml" fx:id="adminSidebar"/>
    </left>

    <!-- ==================== TOP HEADER Avec Sous-Navigation Activités ==================== -->
    <top>
        <VBox spacing="0">
            <!-- Sub-Navigation: Activités -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: #013220; -fx-padding: 12 28;">

                <Button text="▣ Dashboard" maxWidth="Infinity"
                        onAction="#openDashboard"
                        style="-fx-background-color: rgba(80,200,120,0.25); -fx-text-fill: #D1F2EB; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: #50C878; -fx-border-width: 1; -fx-border-radius: 8;"/>

                <Button text="+ Ajouter" maxWidth="Infinity"
                        onAction="#openAjout"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;"/>

                <Button text="✎ Modifier" maxWidth="Infinity"
                        onAction="#openModifier"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;"/>

                <Button text="🗑 Supprimer" maxWidth="Infinity"
                        onAction="#openSuppression"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;"/>

                <Button text="✅ Valider" maxWidth="Infinity"
                        onAction="#validerActivite"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;"/>

                <Button text="📅 Sessions" maxWidth="Infinity"
                        onAction="#openSessionsDashboard"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="⬅ Retour Dashboard Admin"
                        onAction="#goBackToDashboard"
                        style="-fx-background-color: rgba(160,224,201,0.15); -fx-text-fill: #A0E0C9; -fx-padding: 8 16; -fx-background-radius: 6; -fx-font-size: 12px; -fx-cursor: hand;"/>
            </HBox>

            <!-- Title Bar -->
            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color:#F5F3E7; -fx-border-color:#A0E0C9; -fx-border-width:0 0 1 0;">
                <padding><Insets top="16" right="28" bottom="16" left="28"/></padding>

                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Dashboard - Activités"
                           style="-fx-text-fill:#013220; -fx-font-size:22px; -fx-font-weight:bold;"/>
                    <Label text="Affichage de la liste des activités"
                           style="-fx-text-fill:#084E36; -fx-font-size:13px;"/>
                </VBox>

                <Button text="Rafraîchir" onAction="#rafraichir"
                        style="-fx-background-color:#084E36; -fx-text-fill:white; -fx-font-weight:bold;
                               -fx-padding:10 18; -fx-background-radius:10; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ==================== CENTER ==================== -->
    <center>
        <StackPane style="-fx-background-color:#D1F2EB; -fx-padding:22;">
            <VBox spacing="12"
                  style="-fx-background-color:#F5F3E7; -fx-background-radius:14; -fx-padding:22;
                         -fx-effect:dropshadow(three-pass-box, rgba(1,50,32,0.12), 10, 0, 0, 4);"
                  maxWidth="900">

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Liste des Activités"
                           style="-fx-text-fill:#013220; -fx-font-size:18px; -fx-font-weight:bold;"/>
                    <Label fx:id="lblCount" text=""
                           style="-fx-text-fill:#084E36; -fx-font-weight:bold;"/>
                </HBox>

                <TableView fx:id="tableActivite" prefHeight="520">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                        <TableColumn fx:id="colName" text="Nom" prefWidth="160"/>
                        <TableColumn fx:id="colDesc" text="Description" prefWidth="240"/>
                        <TableColumn fx:id="colType" text="Type" prefWidth="120"/>
                        <TableColumn fx:id="colLoc" text="Localisation" prefWidth="140"/>
                        <TableColumn fx:id="colPrix" text="Prix" prefWidth="80"/>
                        <TableColumn fx:id="colStatus" text="Statut" prefWidth="100"/>
                    </columns>
                </TableView>

                <Label fx:id="lblMsg" text=""
                       style="-fx-text-fill:#084E36; -fx-font-size:12px;"/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>