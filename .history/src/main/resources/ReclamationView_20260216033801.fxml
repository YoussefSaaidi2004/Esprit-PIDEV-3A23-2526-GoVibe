<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane style="-fx-background-color: #F5F3E7;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ReclamationController">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;" vbarPolicy="AS_NEEDED">
        <content>
            <VBox spacing="0" style="-fx-background-color: #F5F3E7;">

                <!-- Header Section -->
                <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #013220; -fx-padding: 60 20 40 20;">
                    <Label style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: white;" text="📋 Mes Réclamations" />
                    <Label style="-fx-font-size: 16; -fx-text-fill: rgba(255,255,255,0.8);" text="Gérez vos réclamations et suivez leur statut" />
                </VBox>

                <!-- Mes Réclamations Section (Main Content) -->
                <VBox spacing="20.0" style="-fx-padding: 40 50 50 50;">
                    <!-- Header with Title, Filter and New Button -->
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #013220;" text="Liste des Réclamations" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="comboFiltre" promptText="Toutes" style="-fx-background-color: white; -fx-border-color: #ddd;" />
                        <Button onAction="#openNewReclamationForm" style="-fx-background-color: #013220; -fx-background-radius: 25; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 12 25; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(1,50,32,0.3), 10, 0, 0, 4);" text="+ Faire une réclamation" />
                    </HBox>

                    <!-- Reclamations List -->
                    <VBox fx:id="reclamationsList" spacing="15" style="-fx-background-color: transparent;">
                        <!-- Dynamic content will be added here -->
                    </VBox>

                    <!-- Empty State -->
                    <VBox fx:id="emptyState" alignment="CENTER" spacing="15" visible="true">
                        <Label style="-fx-font-size: 50; -fx-opacity: 0.5;" text="📭" />
                        <Label style="-fx-font-size: 16; -fx-text-fill: #555;" text="Aucune réclamation pour le moment" />
                        <Button onAction="#openNewReclamationForm" style="-fx-background-color: #013220; -fx-background-radius: 25; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 12 30; -fx-cursor: hand;" text="Faire ma première réclamation" />
                    </VBox>
                </VBox>

                <!-- FOOTER -->
                <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #002211; -fx-padding: 50;">
                    <HBox alignment="CENTER" spacing="10">
                        <Label style="-fx-font-size: 24; -fx-font-weight: 900; -fx-text-fill: white;" text="Go" />
                        <Label style="-fx-font-size: 24; -fx-font-weight: 300; -fx-text-fill: #50C878;" text="Vibe" />
                    </HBox>
                    <Label style="-fx-text-fill: rgba(255,255,255,0.6);" text="© 2024 GoVibe - Tous droits réservés" />
                </VBox>

            </VBox>
        </content>
    </ScrollPane>

    <!-- FLOATING NAVIGATION BAR (Fixed at Top) -->
    <HBox alignment="CENTER_LEFT" maxHeight="80.0" minHeight="80.0" spacing="20.0" style="-fx-padding: 0 50; -fx-background-color: transparent;" StackPane.alignment="TOP_CENTER">

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="5">
            <Circle fill="#50C878" radius="20.0" style="-fx-effect: dropshadow(gaussian, rgba(80,200,120,0.4), 10, 0, 0, 2);" />
            <Label style="-fx-font-size: 24; -fx-font-weight: 900; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 5, 0, 0, 1);" text="Go" />
            <Label style="-fx-font-size: 24; -fx-font-weight: 300; -fx-text-fill: #50C878; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 5, 0, 0, 1);" text="Vibe" />
        </HBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Navigation Links -->
        <HBox alignment="CENTER" spacing="30.0">
            <Button onAction="#handleHome" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0, 0, 1);" text="Accueil" />
            <Button onAction="#handleActivities" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: 500; -fx-font-size: 14; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0, 0, 1);" text="Activités" />
            <Button onAction="#handleLocations" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: 500; -fx-font-size: 14; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0, 0, 1);" text="Voitures" />
            <Button onAction="#handleFlights" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: 500; -fx-font-size: 14; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0, 0, 1);" text="Vols" />
            <Button onAction="#handleChambres" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: 500; -fx-font-size: 14; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0, 0, 1);" text="Hôtels" />
            <Button onAction="#handleForums" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: 500; -fx-font-size: 14; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0, 0, 1);" text="Forums" />
            <Button style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0, 0, 1);" text="Réclamation" />
        </HBox>

        <Region HBox.hgrow="ALWAYS" />

    </HBox>

</StackPane>
