<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<!-- 
  PAGE ACTIVITÉS PROFESSIONNELLE
  Design moderne avec navigation commune, filtres avancés, et cartes interactives
-->

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.UserHomeController"
            style="-fx-background-color: #F5F3E7;"
            prefHeight="900" prefWidth="1400">

    <!-- ==================== TOP NAVIGATION BAR (COMMUNE À TOUTES LES PAGES) ==================== -->
    <top>
        <VBox spacing="0">
            <!-- Barre de Navigation Principale -->
            <HBox alignment="CENTER_LEFT" spacing="0" 
                  style="-fx-background-color: linear-gradient(to right, #013220 0%, #0B4F35 50%, #013220 100%);
                         -fx-padding: 0 40 0 40;
                         -fx-pref-height: 75;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 12, 0, 0, 4);">
                
                <!-- Logo Section -->
                <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="NEVER">
                    <StackPane>
                        <Circle radius="28" fill="#50C878" style="-fx-effect: dropshadow(gaussian, rgba(80,200,120,0.4), 8, 0, 0, 2);"/>
                        <Label text="G" style="-fx-font-size: 22; -fx-font-weight: 900; -fx-text-fill: #013220;"/>
                    </StackPane>
                    <VBox spacing="-2" alignment="CENTER_LEFT">
                        <Label text="Go" style="-fx-font-size: 24; -fx-font-weight: 900; -fx-text-fill: white;"/>
                        <Label text="Vibe" style="-fx-font-size: 24; -fx-font-weight: 300; -fx-text-fill: #50C878;"/>
                    </VBox>
                    <Label fx:id="welcomeLabel" visible="false" managed="false"/>
                    <Region prefWidth="40"/>
                    
                    <!-- Menu Navigation -->
                    <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 0 0 30;">
                        <!-- Accueil -->
                        <Button text="🏠 Accueil" onAction="#handleHome"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8); 
                                       -fx-font-size: 14; -fx-font-weight: 500; -fx-padding: 12 22;
                                       -fx-cursor: hand; -fx-background-radius: 10;"/>
                        
                        <!-- Activités - ACTIVE -->
                        <Button text="✨ Activités" onAction="#handleActivities"
                                style="-fx-background-color: rgba(80,200,120,0.25); -fx-text-fill: white; 
                                       -fx-font-size: 14; -fx-font-weight: 600; -fx-padding: 12 22;
                                       -fx-cursor: hand; -fx-background-radius: 10;
                                       -fx-border-color: rgba(80,200,120,0.5); -fx-border-width: 1; -fx-border-radius: 10;"/>
                        
                        <!-- Voitures -->
                        <Button text="🚗 Voitures" onAction="#handleLocations"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8); 
                                       -fx-font-size: 14; -fx-font-weight: 500; -fx-padding: 12 22;
                                       -fx-cursor: hand; -fx-background-radius: 10;"/>
                        
                        <!-- Vols -->
                        <Button text="✈️ Vols" onAction="#handleFlights"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8); 
                                       -fx-font-size: 14; -fx-font-weight: 500; -fx-padding: 12 22;
                                       -fx-cursor: hand; -fx-background-radius: 10;"/>
                        
                        <!-- Hôtels -->
                        <Button text="🏨 Hôtels" onAction="#handleChambres"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8); 
                                       -fx-font-size: 14; -fx-font-weight: 500; -fx-padding: 12 22;
                                       -fx-cursor: hand; -fx-background-radius: 10;"/>
                        
                        <!-- Forums -->
                        <Button text="💬 Forums" onAction="#handleForums"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8); 
                                       -fx-font-size: 14; -fx-font-weight: 500; -fx-padding: 12 22;
                                       -fx-cursor: hand; -fx-background-radius: 10;"/>
                    </HBox>
                </HBox>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                <!-- Section Droite: Actions & Profil -->
                <HBox alignment="CENTER_RIGHT" spacing="18">
                    <!-- Bouton Proposer -->
                    <Button text="➕ Proposer" onAction="#openProposeActivity"
                            style="-fx-background-color: linear-gradient(to bottom, #50C878, #3DAF62); 
                                   -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 600; 
                                   -fx-padding: 10 20; -fx-background-radius: 20; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(80,200,120,0.5), 10, 0, 0, 3);">
                        <tooltip>
                            <Tooltip text="Proposer une nouvelle activité" style="-fx-font-size: 12;"/>
                        </tooltip>
                    </Button>
                    
                    <!-- Séparateur -->
                    <Line startY="0" endY="35" stroke="rgba(255,255,255,0.2)" strokeWidth="1"/>
                    
                    <!-- Menu Profil -->
                    <MenuButton fx:id="profileMenu" 
                                style="-fx-background-color: transparent; -fx-cursor: hand;
                                       -fx-padding: 3; -fx-background-radius: 25;">
                        <graphic>
                            <StackPane>
                                <Circle radius="26" fill="white" 
                                        style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 8, 0, 0, 2);"/>
                                <Label fx:id="profileInitials" text="U" 
                                       style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #013220;"/>
                                <Circle radius="8" fill="#50C878" translateX="16" translateY="16"
                                        style="-fx-effect: dropshadow(gaussian, rgba(80,200,120,0.5), 2, 0, 0, 1);">
                                </Circle>
                            </StackPane>
                        </graphic>
                        
                        <items>
                            <MenuItem text="👤 Mon Profil" onAction="#handleProfile"/>
                            <MenuItem text="📋 Mes Réservations" onAction="#handleMyReservations"/>
                            <MenuItem text="🚗 Mes Locations" onAction="#handleMyLocations"/>
                            <MenuItem text="✈️ Mes Vols" onAction="#handleMyFlights"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="⚙️ Paramètres" onAction="#handleSettings"/>
                            <MenuItem text="❓ Centre d'aide" onAction="#handleHelp"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="🚪 Déconnexion" onAction="#handleLogout" 
                                      style="-fx-text-fill: #E74C3C;"/>
                        </items>
                        
                        <tooltip>
                            <Tooltip text="Menu utilisateur"/>
                        </tooltip>
                    </MenuButton>
                </HBox>
            </HBox>
            
            <!-- Sous-barre: Filtres et Recherche -->
            <HBox alignment="CENTER" spacing="15" 
                  style="-fx-background-color: white; -fx-padding: 18 40;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 3);">
                
                <!-- Recherche -->
                <HBox alignment="CENTER_LEFT" spacing="10" 
                      style="-fx-background-color: #F5F3E7; -fx-padding: 10 18;
                             -fx-background-radius: 25; -fx-pref-width: 350;">
                    <Label text="🔍" style="-fx-font-size: 16;"/>
                    <TextField fx:id="searchField" promptText="Rechercher une activité..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-font-size: 14;
                                      -fx-prompt-text-fill: #888; -fx-border-color: transparent;"/>
                </HBox>
                
                <Separator orientation="VERTICAL" style="-fx-padding: 0 10;"/>
                
                <!-- Filtre Type -->
                <ComboBox fx:id="filterType" promptText="🎯 Type d'activité"
                          style="-fx-background-color: #F5F3E7; -fx-font-size: 13;
                                 -fx-background-radius: 8;"/>
                
                <!-- Filtre Localisation -->
                <ComboBox fx:id="filterLocation" promptText="📍 Localisation"
                          style="-fx-background-color: #F5F3E7; -fx-font-size: 13;
                                 -fx-background-radius: 8;"/>
                
                <!-- Filtre Prix -->
                <ComboBox fx:id="filterPrix" promptText="💰 Prix"
                          style="-fx-background-color: #F5F3E7; -fx-font-size: 13;
                                 -fx-background-radius: 8;"/>
                
                <Separator orientation="VERTICAL" style="-fx-padding: 0 10;"/>
                
                <!-- Bouton Rechercher -->
                <Button text="Rechercher" onAction="#handleSearch"
                        style="-fx-background-color: #013220; -fx-text-fill: white;
                               -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 25;
                               -fx-background-radius: 20; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(1,50,32,0.3), 8, 0, 0, 2);"/>
                
                <!-- Bouton Réinitialiser -->
                <Button text="↺" onAction="#handleResetFilters"
                        style="-fx-background-color: transparent; -fx-text-fill: #084E36;
                               -fx-font-size: 18; -fx-pref-width: 40; -fx-pref-height: 40;
                               -fx-background-radius: 20; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ==================== CONTENU CENTRAL ==================== -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;"
                    VBox.vgrow="ALWAYS" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="0" style="-fx-background-color: #F5F3E7;">
                    
                    <!-- Header Section -->
                    <VBox spacing="8" style="-fx-padding: 35 50 25 50;">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <StackPane>
                                <Circle radius="35" fill="#D1F2EB"/>
                                <Label text="✨" style="-fx-font-size: 32;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label text="Activités &amp; Expériences" 
                                       style="-fx-font-size: 32; -fx-font-weight: 700; -fx-text-fill: #013220;"/>
                                <Label text="Découvrez des activités uniques et réservez votre prochaine aventure" 
                                       style="-fx-font-size: 15; -fx-text-fill: #5a7d6e;"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            
                            <!-- Statistiques -->
                            <HBox spacing="25" alignment="CENTER">
                                <VBox alignment="CENTER" spacing="2">
                                    <Label text="150+" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #50C878;"/>
                                    <Label text="Activités" style="-fx-font-size: 12; -fx-text-fill: #5a7d6e;"/>
                                </VBox>
                                <Separator orientation="VERTICAL" style="-fx-padding: 0;"/>
                                <VBox alignment="CENTER" spacing="2">
                                    <Label text="50+" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #50C878;"/>
                                    <Label text="Destinations" style="-fx-font-size: 12; -fx-text-fill: #5a7d6e;"/>
                                </VBox>
                                <Separator orientation="VERTICAL" style="-fx-padding: 0;"/>
                                <VBox alignment="CENTER" spacing="2">
                                    <Label text="4.8" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #50C878;"/>
                                    <Label text="Note moyenne" style="-fx-font-size: 12; -fx-text-fill: #5a7d6e;"/>
                                </VBox>
                            </HBox>
                        </HBox>
                    </VBox>
                    
                    <!-- Section Catégories Populaires -->
                    <VBox spacing="20" style="-fx-padding: 0 50 30 50;">
                        <Label text="Catégories populaires" 
                               style="-fx-font-size: 20; -fx-font-weight: 600; -fx-text-fill: #013220;"/>
                        
                        <HBox spacing="15">
                            <!-- Aventure -->
                            <VBox alignment="CENTER" spacing="8" 
                                  style="-fx-background-color: white; -fx-padding: 20 30;
                                         -fx-background-radius: 16; -fx-cursor: hand;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                                <Label text="🏔️" style="-fx-font-size: 28;"/>
                                <Label text="Aventure" style="-fx-font-size: 14; -fx-font-weight: 600;"/>
                                <Label text="24 activités" style="-fx-font-size: 11; -fx-text-fill: #888;"/>
                            </VBox>
                            
                            <!-- Culture -->
                            <VBox alignment="CENTER" spacing="8" 
                                  style="-fx-background-color: white; -fx-padding: 20 30;
                                         -fx-background-radius: 16; -fx-cursor: hand;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                                <Label text="🏛️" style="-fx-font-size: 28;"/>
                                <Label text="Culture" style="-fx-font-size: 14; -fx-font-weight: 600;"/>
                                <Label text="18 activités" style="-fx-font-size: 11; -fx-text-fill: #888;"/>
                            </VBox>
                            
                            <!-- Sport -->
                            <VBox alignment="CENTER" spacing="8" 
                                  style="-fx-background-color: white; -fx-padding: 20 30;
                                         -fx-background-radius: 16; -fx-cursor: hand;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                                <Label text="⚽" style="-fx-font-size: 28;"/>
                                <Label text="Sport" style="-fx-font-size: 14; -fx-font-weight: 600;"/>
                                <Label text="32 activités" style="-fx-font-size: 11; -fx-text-fill: #888;"/>
                            </VBox>
                            
                            <!-- Détente -->
                            <VBox alignment="CENTER" spacing="8" 
                                  style="-fx-background-color: white; -fx-padding: 20 30;
                                         -fx-background-radius: 16; -fx-cursor: hand;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                                <Label text="🧘" style="-fx-font-size: 28;"/>
                                <Label text="Détente" style="-fx-font-size: 14; -fx-font-weight: 600;"/>
                                <Label text="15 activités" style="-fx-font-size: 11; -fx-text-fill: #888;"/>
                            </VBox>
                            
                            <!-- Gastronomie -->
                            <VBox alignment="CENTER" spacing="8" 
                                  style="-fx-background-color: white; -fx-padding: 20 30;
                                         -fx-background-radius: 16; -fx-cursor: hand;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                                <Label text="🍽️" style="-fx-font-size: 28;"/>
                                <Label text="Gastronomie" style="-fx-font-size: 14; -fx-font-weight: 600;"/>
                                <Label text="21 activités" style="-fx-font-size: 11; -fx-text-fill: #888;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    
                    <!-- Section Activités Disponibles -->
                    <VBox spacing="20" style="-fx-padding: 0 50 50 50;">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label text="Toutes les activités" 
                                   style="-fx-font-size: 22; -fx-font-weight: 600; -fx-text-fill: #013220;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            
                            <!-- Options d'affichage -->
                            <HBox spacing="8" alignment="CENTER">
                                <ToggleButton text="🔲 Grille" selected="true"
                                              style="-fx-background-color: #013220; -fx-text-fill: white;
                                                     -fx-font-size: 12; -fx-padding: 8 15;
                                                     -fx-background-radius: 8; -fx-cursor: hand;"/>
                                <ToggleButton text="☰ Liste"
                                              style="-fx-background-color: #F5F3E7; -fx-text-fill: #013220;
                                                     -fx-font-size: 12; -fx-padding: 8 15;
                                                     -fx-background-radius: 8; -fx-cursor: hand;"/>
                            </HBox>
                            
                            <Separator orientation="VERTICAL"/>
                            
                            <!-- Tri -->
                            <ComboBox promptText="Trier par : Populaire" 
                                      style="-fx-background-color: white; -fx-font-size: 12;
                                             -fx-background-radius: 8;"/>
                        </HBox>
                        
                        <!-- Grille d'Activités -->
                        <TilePane fx:id="activitiesPane" 
                                  style="-fx-background-color: transparent;"
                                  hgap="25" vgap="25" prefColumns="3">
                            <!-- Les activités seront chargées dynamiquement -->
                        </TilePane>
                        
                        <!-- État Vide -->
                        <VBox fx:id="emptyState" alignment="CENTER" spacing="15" 
                              style="-fx-padding: 80;" visible="false">
                            <Label text="🔍" style="-fx-font-size: 72; -fx-opacity: 0.5;"/>
                            <Label text="Aucune activité trouvée" 
                                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #013220;"/>
                            <Label text="Essayez de modifier vos critères de recherche" 
                                   style="-fx-font-size: 14; -fx-text-fill: #5a7d6e;"/>
                            <Button text="Réinitialiser les filtres" onAction="#handleResetFilters"
                                    style="-fx-background-color: #50C878; -fx-text-fill: white;
                                           -fx-font-size: 14; -fx-padding: 10 25;
                                           -fx-background-radius: 20; -fx-cursor: hand;"/>
                        </VBox>
                    </VBox>
                    
                    <!-- Footer -->
                    <VBox alignment="CENTER" spacing="20" 
                          style="-fx-background-color: linear-gradient(to bottom, #013220, #0B4F35); 
                                 -fx-padding: 50;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, -5);">
                        <HBox alignment="CENTER" spacing="12">
                            <StackPane>
                                <Circle radius="25" fill="#50C878" opacity="0.2"/>
                                <Label text="G" style="-fx-font-size: 20; -fx-font-weight: 900; -fx-text-fill: #50C878;"/>
                            </StackPane>
                            <Label text="Go" style="-fx-font-size: 26; -fx-font-weight: 900; -fx-text-fill: white;"/>
                            <Label text="Vibe" style="-fx-font-size: 26; -fx-font-weight: 300; -fx-text-fill: #50C878;"/>
                        </HBox>
                        <Label text="© 2024 GoVibe. Tous droits réservés." 
                               style="-fx-font-size: 13; -fx-text-fill: rgba(255,255,255,0.6);"/>
                        <HBox alignment="CENTER" spacing="25">
                            <Hyperlink text="À propos" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 13;"/>
                            <Hyperlink text="Confidentialité" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 13;"/>
                            <Hyperlink text="Conditions" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 13;"/>
                            <Hyperlink text="Contact" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 13;"/>
                        </HBox>
                    </VBox>
                    
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>