<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<!-- 
    Admin Sidebar Component - Réutilisable pour toutes les pages admin
    Usage: Inclure dans le <left> d'un BorderPane
    Le contrôleur doit implémenter les méthodes de navigation
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.AdminSidebarController"
      prefWidth="240" minWidth="240" maxWidth="240" spacing="0"
      style="-fx-background-color: #013220;">
    <padding><Insets top="30" right="0" bottom="20" left="0"/></padding>

    <!-- Logo Section -->
    <VBox alignment="CENTER" spacing="8" style="-fx-padding: 0 20 30 20;">
        <HBox alignment="CENTER" spacing="8">
            <SVGPath content="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                     style="-fx-fill: #50C878;" scaleX="1.2" scaleY="1.2"/>
            <Label text="GoVibe" style="-fx-text-fill: #F5F3E7; -fx-font-size: 24px; -fx-font-weight: 700;"/>
        </HBox>
        <Label text="Administration" style="-fx-text-fill: #A0E0C9; -fx-font-size: 12px; -fx-font-weight: 400;"/>
    </VBox>

    <!-- Navigation Menu -->
    <VBox spacing="4" style="-fx-padding: 0 12;">
        
        <!-- Dashboard -->
        <Button fx:id="navDashboard" onAction="#handleGoDashboard" maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;">
            <graphic>
                <SVGPath content="M4 13h6c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v8c0 .55.45 1 1 1zm0 8h6c.55 0 1-.45 1-1v-4c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v4c0 .55.45 1 1 1zm10 0h6c.55 0 1-.45 1-1v-8c0-.55-.45-1-1-1h-6c-.55 0-1 .45-1 1v8c0 .55.45 1 1 1zm0-11h6c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1h-6c-.55 0-1 .45-1 1v5c0 .55.45 1 1 1z"
                         style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
            </graphic>
            <text>Dashboard</text>
        </Button>

        <!-- Personnes -->
        <Button fx:id="navPersonnes" onAction="#handleGoPersonnes" maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;">
            <graphic>
                <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                         style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
            </graphic>
            <text>Personnes</text>
        </Button>

        <!-- Section: GESTION -->
        <Label text="GESTION" style="-fx-text-fill: #5a7d6e; -fx-font-size: 10px; -fx-font-weight: 700; -fx-padding: 20 16 8 16;"/>

        <!-- Voitures -->
        <Button fx:id="navVoitures" onAction="#handleGoVoitures" maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;">
            <graphic>
                <SVGPath content="M18.92 5.01C18.72 4.42 18.16 4 17.5 4h-11c-.66 0-1.21.42-1.42 1.01L3 11v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 15c-.83 0-1.5-.67-1.5-1.5S5.67 12 6.5 12s1.5.67 1.5 1.5S7.33 15 6.5 15zm11 0c-.83 0-1.5-.67-1.5-1.5S16.67 12 17.5 12s1.5.67 1.5 1.5S18.33 15 17.5 15zM5 10l1.5-4.5h11L19 10H5z"
                         style="-fx-fill: #A0E0C9;" scaleX="0.85" scaleY="0.85"/>
            </graphic>
            <text>Voitures</text>
        </Button>

        <!-- Vols -->
        <Button fx:id="navVols" onAction="#handleGoFlights" maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;">
            <graphic>
                <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
                         style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
            </graphic>
            <text>Vols</text>
        </Button>

        <!-- Hôtels -->
        <Button fx:id="navHotels" onAction="#handleGoHotels" maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;">
            <graphic>
                <SVGPath content="M7 13.5c.83 0 1.5-.67 1.5-1.5 0-.83-.67-1.5-1.5-1.5S5.5 11.17 5.5 12c0 .83.67 1.5 1.5 1.5zm0 3.5c.83 0 1.5-.67 1.5-1.5S7.83 14 7 14s-1.5.67-1.5 1.5S6.17 17 7 17zm0 3.5c.83 0 1.5-.67 1.5-1.5S7.83 17.5 7 17.5s-1.5.67-1.5 1.5S6.17 20.5 7 20.5zM19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z"
                         style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
            </graphic>
            <text>Hôtels</text>
        </Button>

        <!-- Activités -->
        <Button fx:id="navActivites" onAction="#handleGoActivites" maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;">
            <graphic>
                <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                         style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
            </graphic>
            <text>Activités</text>
        </Button>

        <!-- Forums -->
        <Button fx:id="navForums" onAction="#handleGoForums" maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;">
            <graphic>
                <SVGPath content="M20 2H4c-1.1 0-2 .9-2 2v14l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 13H6l-2 2V4h16v11z"
                         style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
            </graphic>
            <text>Forums</text>
        </Button>

        <!-- Réclamations -->
        <Button fx:id="navReclamations" onAction="#handleGoReclamations" maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;">
            <graphic>
                <SVGPath content="M14.4 6L14 4H5v17h2v-7h5.6l.4 2h7V6z"
                         style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
            </graphic>
            <text>Réclamations</text>
        </Button>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <!-- Logout Section -->
    <VBox spacing="4" style="-fx-padding: 0 12;">
        <Separator style="-fx-background-color: rgba(160,224,201,0.2);"/>
        <Region prefHeight="10"/>
        <Button onAction="#handleLogout" maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;">
            <graphic>
                <SVGPath content="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"
                         style="-fx-fill: #e74c3c;" scaleX="0.9" scaleY="0.9"/>
            </graphic>
            <text>Déconnexion</text>
        </Button>
    </VBox>
</VBox>
