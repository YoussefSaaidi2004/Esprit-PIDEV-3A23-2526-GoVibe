<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>

<!-- 
  PAGE FORUMS PROFESSIONNELLE
  Design moderne avec navigation commune et gestion des forums
-->

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.ListForumController"
            style="-fx-background-color: #F5F3E7;"
            prefHeight="900" prefWidth="1400">

    <!-- ==================== LEFT SIDEBAR (Menu Admin Commun) ==================== -->
    <left>
        <fx:include source="../org/example/AdminSidebar.fxml" fx:id="adminSidebar"/>
    </left>

    <!-- ==================== TOP HEADER (Simplifié) ==================== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #ffffff; -fx-border-color: #E5E5E5; -fx-border-width: 0 0 1 0;">
            <padding><Insets top="16" right="30" bottom="16" left="30"/></padding>
            
            <!-- Breadcrumb / Title -->
            <VBox HBox.hgrow="ALWAYS" spacing="2">
                <Label text="Forums" style="-fx-text-fill: #013220; -fx-font-size: 20px; -fx-font-weight: 700;"/>
                <Label text="Gestion des forums et discussions" style="-fx-text-fill: #5a7d6e; -fx-font-size: 13px;"/>
            </VBox>

            <!-- Actions -->
            <Button text="➕ Créer forum" onAction="#handleAjoutForum"
                    style="-fx-background-color: #50C878; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 600; 
                           -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- ==================== CONTENU CENTRAL ==================== -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;"
                    VBox.vgrow="ALWAYS" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="0" style="-fx-background-color: #F5F3E7;">
                    
                    <!-- Header Section -->
                    <VBox spacing="8" style="-fx-padding: 35 50 25 50;">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <StackPane>
                                <Circle radius="35" fill="#D1F2EB"/>
                                <Label text="💬" style="-fx-font-size: 32;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label text="Forums &amp; Discussions" 
                                       style="-fx-font-size: 32; -fx-font-weight: 700; -fx-text-fill: #013220;"/>
                                <Label text="Rejoignez des communautés et participez aux discussions" 
                                       style="-fx-font-size: 15; -fx-text-fill: #5a7d6e;"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            
                            <!-- Statistiques -->
                            <HBox spacing="25" alignment="CENTER">
                                <VBox alignment="CENTER" spacing="2">
                                    <Label text="25+" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #50C878;"/>
                                    <Label text="Forums" style="-fx-font-size: 12; -fx-text-fill: #5a7d6e;"/>
                                </VBox>
                                <Separator orientation="VERTICAL" style="-fx-padding: 0;"/>
                                <VBox alignment="CENTER" spacing="2">
                                    <Label text="1.2K+" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #50C878;"/>
                                    <Label text="Membres" style="-fx-font-size: 12; -fx-text-fill: #5a7d6e;"/>
                                </VBox>
                                <Separator orientation="VERTICAL" style="-fx-padding: 0;"/>
                                <VBox alignment="CENTER" spacing="2">
                                    <Label text="5K+" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #50C878;"/>
                                    <Label text="Publications" style="-fx-font-size: 12; -fx-text-fill: #5a7d6e;"/>
                                </VBox>
                            </HBox>
                        </HBox>
                    </VBox>
                    
                    <!-- Section Forums -->
                    <VBox spacing="20" style="-fx-padding: 0 50 50 50;">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label text="Tous les forums" 
                                   style="-fx-font-size: 22; -fx-font-weight: 600; -fx-text-fill: #013220;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            
                            <!-- Onglets -->
                            <HBox spacing="8" alignment="CENTER">
                                <ToggleButton text="🔥 Populaires" selected="true"
                                              style="-fx-background-color: #013220; -fx-text-fill: white;
                                                     -fx-font-size: 12; -fx-padding: 8 15;
                                                     -fx-background-radius: 8; -fx-cursor: hand;"/>
                                <ToggleButton text="🆕 Récents"
                                              style="-fx-background-color: #F5F3E7; -fx-text-fill: #013220;
                                                     -fx-font-size: 12; -fx-padding: 8 15;
                                                     -fx-background-radius: 8; -fx-cursor: hand;"/>
                                <ToggleButton text="👤 Mes forums"
                                              style="-fx-background-color: #F5F3E7; -fx-text-fill: #013220;
                                                     -fx-font-size: 12; -fx-padding: 8 15;
                                                     -fx-background-radius: 8; -fx-cursor: hand;"/>
                            </HBox>
                        </HBox>
                        
                        <!-- Liste des Forums -->
                        <VBox fx:id="forumsContainer" spacing="15"
                              style="-fx-background-color: transparent;">
                            <padding><Insets bottom="20" right="10"/></padding>
                            <!-- Forums will be loaded here -->
                        </VBox>
                        
                        <!-- État Vide -->
                        <VBox fx:id="emptyState" alignment="CENTER" spacing="15" 
                              style="-fx-padding: 80;" visible="false">
                            <Label text="💬" style="-fx-font-size: 72; -fx-opacity: 0.5;"/>
                            <Label text="Aucun forum trouvé" 
                                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #013220;"/>
                            <Label text="Créez le premier forum ou modifiez vos critères de recherche" 
                                   style="-fx-font-size: 14; -fx-text-fill: #5a7d6e;"/>
                            <Button text="➕ Créer un forum" onAction="#handleAjoutForum"
                                    style="-fx-background-color: #50C878; -fx-text-fill: white;
                                           -fx-font-size: 14; -fx-padding: 12 30;
                                           -fx-background-radius: 25; -fx-cursor: hand;"/>
                        </VBox>
                    </VBox>
                    
                    <!-- Footer -->
                    <VBox alignment="CENTER" spacing="20" 
                          style="-fx-background-color: linear-gradient(to bottom, #013220, #0B4F35); 
                                 -fx-padding: 50;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, -5);">
                        <HBox alignment="CENTER" spacing="12">
                            <StackPane>
                                <Circle radius="25" fill="#50C878" opacity="0.2"/>
                                <Label text="G" style="-fx-font-size: 20; -fx-font-weight: 900; -fx-text-fill: #50C878;"/>
                            </StackPane>
                            <Label text="Go" style="-fx-font-size: 26; -fx-font-weight: 900; -fx-text-fill: white;"/>
                            <Label text="Vibe" style="-fx-font-size: 26; -fx-font-weight: 300; -fx-text-fill: #50C878;"/>
                        </HBox>
                        <Label text="© 2024 GoVibe. Tous droits réservés." 
                               style="-fx-font-size: 13; -fx-text-fill: rgba(255,255,255,0.6);"/>
                        <HBox alignment="CENTER" spacing="25">
                            <Hyperlink text="À propos" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 13;"/>
                            <Hyperlink text="Confidentialité" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 13;"/>
                            <Hyperlink text="Conditions" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 13;"/>
                            <Hyperlink text="Contact" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 13;"/>
                        </HBox>
                    </VBox>
                    
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
