<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.DetailsForumController">

    <!-- Top Navigation Bar -->
    <top>
        <HBox alignment="CENTER" spacing="0" style="-fx-background-color: white; -fx-border-color: #A0E0C9; -fx-border-width: 0 0 1 0;">
            <padding><Insets bottom="10" left="40" right="40" top="10" /></padding>

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="NEVER">
                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@images/logo.png" /></image>
                </ImageView>
                <Label style="-fx-text-fill: #013220; -fx-font-size: 20px; -fx-font-weight: bold;" text="GoVibe" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Nav Links -->
            <HBox alignment="CENTER" spacing="30">
                <Hyperlink onAction="#handleGoToPosts" style="-fx-text-fill: #013220; -fx-font-size: 14px; -fx-font-weight: bold; -fx-underline: false;" text="Accueil" />
                <Hyperlink onAction="#handleGoToForums" style="-fx-text-fill: #084E36; -fx-font-size: 14px; -fx-underline: false;" text="Forums" />
                <Hyperlink style="-fx-text-fill: #084E36; -fx-font-size: 14px; -fx-underline: false;" text="Événements" />
                <Hyperlink style="-fx-text-fill: #084E36; -fx-font-size: 14px; -fx-underline: false;" text="À propos" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- User Info -->
            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Label style="-fx-text-fill: #013220; -fx-font-size: 14px; -fx-font-weight: bold;" text="Bonjour !" />
                <Button onAction="#handleLogout" style="-fx-background-color: #50C878; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;" text="Déconnexion" />
            </HBox>
        </HBox>
    </top>

    <!-- Main Content Area -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #F4F7F6; -fx-background: #F4F7F6;" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <content>
                <VBox alignment="TOP_CENTER" spacing="30" style="-fx-background-color: #F4F7F6; -fx-padding: 0 0 50 0;">
                    
                    <!-- Hero/Cover Section -->
                    <StackPane alignment="BOTTOM_LEFT" prefHeight="300.0" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 0);">
                        <ImageView fx:id="coverImage" fitHeight="300.0" fitWidth="1600.0" preserveRatio="false" style="-fx-opacity: 0.9;" />
                        
                        <!-- Gradient Overlay for Readability -->
                        <Region style="-fx-background-color: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0) 100%);" />
                        
                        <!-- Forum Info Overlay -->
                        <VBox spacing="10" style="-fx-padding: 40;">
                            <Label fx:id="forumNameLabel" style="-fx-text-fill: white; -fx-font-size: 42px; -fx-font-weight: 900; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0.5, 0, 0);" text="Nom du Forum" />
                            <Label fx:id="forumDescriptionLabel" maxWidth="800" text="Description du forum..." wrapText="true" style="-fx-text-fill: #E0E0E0; -fx-font-size: 18px; -fx-font-weight: 500; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 5, 0.5, 0, 0); -fx-line-spacing: 5;" />
                            
                            <HBox spacing="15" style="-fx-padding: 15 0 0 0;">
                                <Label style="-fx-text-fill: #50C878; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: rgba(255,255,255,0.1); -fx-padding: 5 12; -fx-background-radius: 20; -fx-border-color: #50C878; -fx-border-radius: 20;" text="Communauté Officielle" />
                                <Label fx:id="creatorLabel" style="-fx-text-fill: #E0E0E0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 5 0;" text="Créé par Admin" />
                            </HBox>
                        </VBox>
                        

                    </StackPane>

                    <!-- Content Container (Centered Limited Width) -->
                    <VBox maxWidth="1100" spacing="25" style="-fx-padding: 0 20;">
                        
                        <!-- Actions Bar -->
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="5">
                                <Label style="-fx-text-fill: #013220; -fx-font-size: 24px; -fx-font-weight: 800;" text="Discussion" />
                                <Region style="-fx-background-color: #50C878; -fx-min-height: 4; -fx-pref-width: 50;" />
                            </VBox>
                            
                            <Region HBox.hgrow="ALWAYS" />
                            
                            <Button onAction="#handleAjoutPost" style="-fx-background-color: transparent; -fx-cursor: hand;">
                                <graphic>
                                    <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                        <image>
                                            <Image url="@images/add.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                        </HBox>

                        <HBox spacing="25" alignment="TOP_CENTER">
                            <!-- Posts Feed (Left) -->
                            <VBox fx:id="postsContainer" spacing="20" HBox.hgrow="ALWAYS">
                                <!-- Posts will be loaded here dynamically -->
                            </VBox>

                            <!-- Members Sidebar (Right) -->
                            <VBox minWidth="300" maxWidth="300" spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 0); -fx-padding: 20;">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="Membres" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #013220;" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="membersCountLabel" style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 2 8; -fx-background-radius: 10;" text="0" />
                                </HBox>
                                <Region style="-fx-min-height: 1; -fx-background-color: #F0F0F0;" />
                                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" prefHeight="400">
                                    <content>
                                        <VBox fx:id="membersContainer" spacing="10" style="-fx-background-color: transparent;">
                                            <!-- Members will be loaded here -->
                                        </VBox>
                                    </content>
                                </ScrollPane>
                                
                                <!-- Creator Controls (Add Member) -->
                                <VBox fx:id="creatorControls" managed="false" visible="false" spacing="10" style="-fx-border-color: #E0E0E0; -fx-border-width: 1 0 0 0; -fx-padding: 15 0 0 0;">
                                    <Label text="Ajouter un membre" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #013220;" />
                                    <javafx.scene.control.TextField fx:id="memberEmailField" promptText="Adresse email du membre" style="-fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" />
                                    <Button onAction="#handleAddMember" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-cursor: hand;">
                                        <graphic>
                                            <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                                                <image>
                                                    <Image url="@images/add.png" />
                                                </image>
                                            </ImageView>
                                        </graphic>
                                    </Button>
                                </VBox>
                            </VBox>
                        </HBox>
                        
                        <!-- Footer / End of List -->
                        <HBox alignment="CENTER" style="-fx-padding: 20;">
                            <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 14px;" text="Vous avez vu toutes les publications." />
                        </HBox>
                        
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
