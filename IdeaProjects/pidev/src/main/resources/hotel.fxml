<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.HotelController">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="260" alignment="TOP_CENTER"
              style="-fx-background-color: #013220;">
            <padding><Insets top="25" right="15" bottom="25" left="15"/></padding>

            <Label text="GoVibe"
                   style="-fx-text-fill: #D1F2EB; -fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Region prefHeight="30"/>

            <VBox spacing="4">
                <Button text="🏨 Hôtels" maxWidth="Infinity"
                        style="-fx-background-color: rgba(80,200,120,0.2); -fx-text-fill: #D1F2EB; -fx-padding: 12 18; -fx-background-radius: 8; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="🚪 Déconnexion"
                    onAction="#deconnexion"
                    maxWidth="Infinity"
                    style="-fx-background-color: rgba(231,76,60,0.15); -fx-text-fill: #e74c3c; -fx-padding: 10 18; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;"/>
        </VBox>
    </left>

    <!-- MAIN -->
    <center>
        <VBox style="-fx-background-color: #D1F2EB;">

            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color: #F5F3E7;">
                <padding><Insets top="18" right="40" bottom="18" left="40"/></padding>

                <Label text="Gestion des Hôtels"
                       style="-fx-text-fill: #013220; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            </HBox>

            <VBox spacing="25" VBox.vgrow="ALWAYS">
                <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

                <VBox spacing="15"
                      style="-fx-background-color: #F5F3E7; -fx-background-radius: 12; -fx-padding: 25;">

                    <Label text="Liste des Hôtels"
                           style="-fx-text-fill: #013220; -fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <TableView fx:id="hotelTable" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="nomColumn" text="Nom" prefWidth="150"/>
                            <TableColumn fx:id="adresseColumn" text="Adresse" prefWidth="180"/>
                            <TableColumn fx:id="villeColumn" text="Ville" prefWidth="120"/>
                            <TableColumn fx:id="etoilesColumn" text="Étoiles" prefWidth="80"/>
                            <TableColumn fx:id="budgetColumn" text="Budget (DT)" prefWidth="120"/>
                        </columns>
                    </TableView>

                    <HBox spacing="15">
                        <Button text="➕ Ajouter Hôtel"
                                onAction="#ajouterHotel"/>

                        <Button text="🗑 Supprimer"
                                onAction="#supprimerHotel"/>
                    </HBox>

                </VBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>





