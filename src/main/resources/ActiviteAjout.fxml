<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.ActiviteAjoutController">

    <!-- SIDEBAR (même style que Dashboard) -->
    <left>
        <VBox prefWidth="280" spacing="18" alignment="TOP_CENTER"
              style="-fx-background-color:#073B2A;">
            <padding><Insets top="25" right="18" bottom="25" left="18"/></padding>

            <VBox alignment="CENTER" spacing="8"
                  style="-fx-background-color:#0A4A33; -fx-background-radius:18; -fx-padding:26;">
                <Label text="GoVibe" style="-fx-text-fill:white; -fx-font-size:28px; -fx-font-weight:bold;"/>
                <Label text="Administration" style="-fx-text-fill:#8FE7C9; -fx-font-size:13px;"/>
                <Label text="Dashboard Activités" style="-fx-text-fill:#8FE7C9; -fx-font-size:13px;"/>
            </VBox>

            <Region prefHeight="8"/>

            <Button text="▣  Dashboard" maxWidth="Infinity"
                    onAction="#openDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: #CFF6E8;
                           -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 12;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

            <Button text="+  Ajouter Activité" maxWidth="Infinity"
                    onAction="#openAjout"
                    style="-fx-background-color: rgba(80,200,120,0.25); -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 12;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-font-weight: bold;"/>

            <Button text="✎  Modifier Activité" maxWidth="Infinity"
                    onAction="#openModifier"
                    style="-fx-background-color: transparent; -fx-text-fill: #CFF6E8;
                           -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 12;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

            <Button text="🗑  Suppression Activité" maxWidth="Infinity"
                    onAction="#openSuppression"
                    style="-fx-background-color: transparent; -fx-text-fill: #CFF6E8;
                           -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 12;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-border-color: rgba(255,255,255,0.25);"/>

            <Label text="● En ligne"
                   style="-fx-background-color: rgba(80,200,120,0.15); -fx-text-fill:#50C878;
                          -fx-padding:8 18; -fx-background-radius:20; -fx-font-size:12px; -fx-font-weight:bold;"/>
        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <VBox spacing="0" style="-fx-background-color:#D1F2EB;">

            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color:#F5F3E7; -fx-border-color:#A0E0C9; -fx-border-width:0 0 1 0;">
                <padding><Insets top="16" right="28" bottom="16" left="28"/></padding>
                <VBox spacing="3">
                    <Label text="Ajouter une Activité"
                           style="-fx-text-fill:#013220; -fx-font-size:22px; -fx-font-weight:bold;"/>
                    <Label text="Remplis le formulaire puis clique sur Ajouter"
                           style="-fx-text-fill:#084E36; -fx-font-size:13px;"/>
                </VBox>
            </HBox>

            <StackPane style="-fx-background-color:#D1F2EB; -fx-padding:22;">
                <VBox spacing="16" maxWidth="700"
                      style="-fx-background-color:#F5F3E7; -fx-background-radius:14; -fx-padding:26;
                             -fx-effect:dropshadow(three-pass-box, rgba(1,50,32,0.12), 10, 0, 0, 4);">

                    <Label text="Formulaire Activité"
                           style="-fx-text-fill:#013220; -fx-font-size:18px; -fx-font-weight:bold;"/>

                    <GridPane hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfName" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Description :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfDescription" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Type :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfType" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Localisation :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfLocalisation" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Prix :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfPrix" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    </GridPane>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button text="➕ Ajouter" onAction="#ajouter"
                                style="-fx-background-color:#50C878; -fx-text-fill:white; -fx-font-weight:bold;
                                       -fx-padding:12 24; -fx-background-radius:10; -fx-cursor:hand;"/>
                        <Label fx:id="lblMsg" text="" style="-fx-text-fill: green; -fx-font-weight: bold;"/>
                    </HBox>

                </VBox>
            </StackPane>

        </VBox>
    </center>

</BorderPane>