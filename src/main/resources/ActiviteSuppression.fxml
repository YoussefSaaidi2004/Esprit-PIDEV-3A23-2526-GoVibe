<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox alignment="CENTER" spacing="30" styleClass="glass-panel" style="-fx-padding: 40; -fx-background-radius: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 40, 0, 0, 20);" stylesheets="@styles/unified-styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ActiviteSuppressionController">
    <children>
        <!-- Modal Header -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <StackPane styleClass="icon-circle-emerald" prefWidth="50" prefHeight="50" minWidth="50" minHeight="50" style="-fx-background-color: rgba(239,71,111,0.2);">
                <Label text="🗑️" style="-fx-font-size: 24;"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="Supprimer l'Activité" style="-fx-font-size: 24; -fx-font-weight: 900; -fx-text-fill: white;"/>
                <Label text="Attention: cette action est irréversible" style="-fx-font-size: 13; -fx-text-fill: rgba(255,255,255,0.6);"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleRetour" styleClass="icon-btn-ghost" text="✕" style="-fx-font-size: 18;"/>
        </HBox>

        <!-- Search/ID Section -->
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="glass-panel" style="-fx-padding: 15; -fx-background-radius: 15;">
            <Label text="ID" styleClass="tile-label-tiny" />
            <TextField fx:id="tfId" prefWidth="120" promptText="ID à supprimer" styleClass="transparent-field" style="-fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 0 0 1 0;"/>
            <Button onAction="#charger" text="Charger" styleClass="btn-outline-white-mini" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#vider" text="Réinitialiser" styleClass="icon-btn-ghost" />
        </HBox>

        <!-- Read-Only Info Grid -->
        <GridPane hgap="25" vgap="25" styleClass="premium-info-grid" style="-fx-padding: 30; -fx-background-radius: 20; -fx-background-color: rgba(255,255,255,0.03);">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="280" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="280" />
            </columnConstraints>
            
            <children>
                <VBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="0">
                    <Label text="NOM" styleClass="tile-label-tiny" />
                    <TextField fx:id="tfName" editable="false" styleClass="transparent-field" style="-fx-opacity: 0.7;"/>
                </VBox>

                <VBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <Label text="TYPE" styleClass="tile-label-tiny" />
                    <TextField fx:id="tfType" editable="false" styleClass="transparent-field" style="-fx-opacity: 0.7;"/>
                </VBox>

                <VBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2">
                    <Label text="DESCRIPTION" styleClass="tile-label-tiny" />
                    <TextField fx:id="tfDescription" editable="false" styleClass="transparent-field" style="-fx-opacity: 0.7;"/>
                </VBox>

                <VBox spacing="8" GridPane.rowIndex="2" GridPane.columnIndex="0">
                    <Label text="LOCALISATION" styleClass="tile-label-tiny" />
                    <TextField fx:id="tfLocalisation" editable="false" styleClass="transparent-field" style="-fx-opacity: 0.7;"/>
                </VBox>

                <VBox spacing="8" GridPane.rowIndex="2" GridPane.columnIndex="1">
                    <Label text="PRIX" styleClass="tile-label-tiny" />
                    <TextField fx:id="tfPrix" editable="false" styleClass="transparent-field" style="-fx-opacity: 0.7; -fx-text-fill: #ef476f; -fx-font-weight: 900;"/>
                </VBox>
            </children>
        </GridPane>

        <!-- Actions -->
        <HBox alignment="CENTER_RIGHT" spacing="15">
            <Label fx:id="lblMsg" style="-fx-text-fill: #ef476f; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleRetour" text="Conserver" styleClass="btn-outline-white-mini" prefWidth="120" prefHeight="45"/>
            <Button onAction="#supprimer" text="Supprimer Définitivement" styleClass="btn-primary-emerald" style="-fx-background-color: #ef476f;" prefWidth="240" prefHeight="45"/>
        </HBox>
    </children>
</VBox>
