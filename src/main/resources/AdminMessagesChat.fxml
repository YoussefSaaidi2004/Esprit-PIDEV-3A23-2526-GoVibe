<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.AdminMessagesController"
      style="-fx-background-color: #F5F3E7;" prefWidth="1400" prefHeight="900">

    <!-- Sidebar Admin -->
    <fx:include source="org/example/AdminSidebar.fxml" fx:id="adminSidebar"/>

    <!-- CENTER: Interface conversationnelle -->
    <SplitPane dividerPositions="0.30" style="-fx-background-color: #F5F3E7;" HBox.hgrow="ALWAYS" minWidth="0">
            
            <!-- LEFT: Liste des clients/conversations -->
            <VBox style="-fx-background-color: #F5F3E7;">
                <!-- Header liste -->
                <HBox style="-fx-background-color: #013220; -fx-padding: 15;" spacing="10" alignment="CENTER_LEFT">
                    <Label text="💬 Conversations" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotalNonLus" text="0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 3 8; -fx-background-radius: 10; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                </HBox>
                
                <!-- Filtres -->
                <HBox style="-fx-background-color: white; -fx-padding: 10;" spacing="8">
                    <ComboBox fx:id="comboFiltre" promptText="Toutes" style="-fx-pref-width: 120;"/>
                    <TextField fx:id="txtRecherche" promptText="🔍 Rechercher client..." HBox.hgrow="ALWAYS" style="-fx-background-radius: 15;"/>
                </HBox>
                
                <!-- Liste des conversations (cards) -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: #F5F3E7;">
                    <VBox fx:id="conversationsList" spacing="3" style="-fx-background-color: #F5F3E7; -fx-padding: 5;">
                        <Label text="Sélectionnez une conversation" style="-fx-padding: 20; -fx-text-fill: #666;"/>
                    </VBox>
                </ScrollPane>
            </VBox>
            
            <!-- RIGHT: Zone de chat admin -->
            <VBox style="-fx-background-color: white;">
                <!-- Header -->
                <HBox fx:id="chatHeader" style="-fx-background-color: #013220; -fx-padding: 15;" spacing="12" alignment="CENTER_LEFT">
                    <Circle fx:id="clientAvatar" radius="22" style="-fx-fill: #50C878;"/>
                    <VBox spacing="2">
                        <Label fx:id="lblClientNom" text="Sélectionnez un client" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblClientEmail" text="" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12px;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnArchiver" onAction="#archiverConversation"
                           style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 20; -fx-cursor: hand;"
                           text="🗃️ Archiver"/>
                    <Button fx:id="btnSupprimerConv" onAction="#supprimerConversation"
                           style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 20; -fx-cursor: hand;"
                           text="🗑️"/>
                </HBox>
                
                <!-- Zone messages (bulles) -->
                <ScrollPane fx:id="messagesScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" 
                           style="-fx-background-color: #e5ddd5; -fx-padding: 15;">
                    <VBox fx:id="messagesContainer" spacing="12" style="-fx-background-color: #e5ddd5;">
                        <Label text="Sélectionnez une conversation pour voir les messages" 
                               style="-fx-text-fill: #666; -fx-font-size: 14px; -fx-alignment: CENTER;"/>
                    </VBox>
                </ScrollPane>
                
                <!-- Input -->
                <HBox style="-fx-background-color: #f0f0f0; -fx-padding: 15;" spacing="10" alignment="CENTER">
                    <Button style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-font-size: 18px; -fx-cursor: hand;" text="😊"/>
                    <TextField fx:id="txtMessageInput" HBox.hgrow="ALWAYS" 
                              promptText="Écrivez votre réponse..."
                              style="-fx-background-color: white; -fx-padding: 12 15; -fx-background-radius: 25; -fx-font-size: 14px;"/>
                    <Button fx:id="btnEnvoyer" onAction="#envoyerMessage"
                           style="-fx-background-color: #50C878; -fx-text-fill: white; -fx-padding: 12 20; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;"
                           text="📤 Envoyer"/>
                </HBox>
            </VBox>
    </SplitPane>
</HBox>
