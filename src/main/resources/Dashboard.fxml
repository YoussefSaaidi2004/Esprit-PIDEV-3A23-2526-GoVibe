<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.DashboardActiviteController"
      stylesheets="@styles/unified-styles.css">

    <!-- Sidebar -->
    <fx:include fx:id="adminSidebar" source="org/example/AdminSidebar.fxml"/>

    <!-- Main Content -->
    <StackPane fx:id="mainStack" HBox.hgrow="ALWAYS" minWidth="0">
            <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false"/>
            <Region style="-fx-background-color: linear-gradient(to bottom right, rgba(0,8,4,0.58) 0%, rgba(1,20,11,0.52) 40%, rgba(1,30,16,0.60) 100%);"/>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox fx:id="contentRoot" spacing="18" style="-fx-padding: 24;">

                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <StackPane style="-fx-background-color: rgba(80,200,120,0.18); -fx-background-radius: 12; -fx-padding: 10; -fx-effect: dropshadow(gaussian, rgba(80,200,120,0.45), 15, 0, 0, 0);">
                        <Text text="🎒" style="-fx-font-size: 22px;"/>
                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Text text="Gestion des Activités"
                              style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 10, 0, 0, 1);"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label fx:id="lblCount" text=""
                                   style="-fx-background-color: rgba(80,200,120,0.22); -fx-background-radius: 20; -fx-text-fill: #50C878; -fx-font-weight: 800; -fx-font-size: 13; -fx-padding: 3 12;"/>
                            <Label fx:id="lblMsg" text="" style="-fx-text-fill: rgba(200,240,220,0.60); -fx-font-size: 12;"/>
                        </HBox>
                    </VBox>
                    <Button onAction="#rafraichir" prefHeight="36"
                            style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1.2; -fx-border-radius: 10; -fx-padding: 8 16; -fx-cursor: hand;">
                        <graphic><Text text="↻  Rafraîchir" style="-fx-fill: rgba(220,250,235,0.88); -fx-font-weight: 700; -fx-font-size: 12;"/></graphic>
                    </Button>
                    <Button onAction="#openSessionsDashboard" prefHeight="36"
                            style="-fx-background-color: rgba(80,200,120,0.14); -fx-background-radius: 10; -fx-border-color: rgba(80,200,120,0.40); -fx-border-width: 1.2; -fx-border-radius: 10; -fx-padding: 8 16; -fx-cursor: hand;">
                        <graphic><Text text="📅  Sessions" style="-fx-fill: #50C878; -fx-font-weight: 700; -fx-font-size: 12;"/></graphic>
                    </Button>
                    <Button onAction="#openAjout" prefHeight="36"
                            style="-fx-background-color: linear-gradient(to bottom right, #50C878, #2e9952); -fx-background-radius: 10; -fx-border-width: 0; -fx-padding: 8 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(80,200,120,0.65), 18, 0, 0, 4);">
                        <graphic><Text text="＋  NOUVELLE ACTIVITÉ" style="-fx-fill: white; -fx-font-weight: 900; -fx-font-size: 12;"/></graphic>
                    </Button>
                </HBox>

                <!-- Search bar -->
                <HBox spacing="14" alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(255,255,255,0.07); -fx-background-radius: 14; -fx-border-color: rgba(80,200,120,0.30); -fx-border-width: 1.2; -fx-border-radius: 14; -fx-padding: 6 16;">
                    <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                             style="-fx-fill: rgba(80,200,120,0.65);" scaleX="0.8" scaleY="0.8"/>
                    <TextField fx:id="searchField" promptText="Filtrer par nom ou localisation..." HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: rgba(180,220,200,0.42); -fx-font-size: 13; -fx-border-width: 0; -fx-padding: 8 6;"/>
                </HBox>

                <FlowPane fx:id="activitesContainer" hgap="22" vgap="22"
                          style="-fx-padding: 4 4 24 4; -fx-background-color: transparent;"/>

                    </VBox>
                </content>
            </ScrollPane>

            <!-- Modal overlay (top layer) -->
            <StackPane fx:id="modalOverlay" visible="false"
                       style="-fx-background-color: rgba(0,0,0,0.60);">
                <VBox fx:id="modalContent" alignment="CENTER" maxWidth="800" maxHeight="750"/>
            </StackPane>

    </StackPane>
</HBox>
