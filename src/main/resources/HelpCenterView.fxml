<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<VBox prefWidth="550" spacing="0" styleClass="glass-card" stylesheets="@styles/unified-styles.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.HelpCenterController">
    <children>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 20 25; -fx-background-color: rgba(80, 200, 120, 0.1); -fx-background-radius: 20 20 0 0;">
            <Label text="💡" style="-fx-font-size: 24;"/>
            <VBox>
                <Label text="Guide des Nouvelles Fonctionnalités" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #013220;"/>
                <Label text="Apprenez à utiliser les outils Open Source GoVibe" style="-fx-font-size: 11; -fx-text-fill: #5a7d6e;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#close" styleClass="icon-btn" text="✕" style="-fx-font-size: 16; -fx-text-fill: #5a7d6e;"/>
        </HBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-padding: 20;" VBox.vgrow="ALWAYS">
            <VBox spacing="25">
                <!-- GPS Section -->
                <VBox spacing="10" styleClass="glass-panel" style="-fx-padding: 15;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📍" style="-fx-font-size: 18;"/>
                        <Label text="Suivi GPS en Temps Réel" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #013220;"/>
                    </HBox>
                    <Label text="Localisez votre véhicule en direct grâce à l'intégration Traccar. Cliquez sur l'icône GPS d'une réservation pour ouvrir la carte interactive." wrapText="true" style="-fx-font-size: 12; -fx-text-fill: #444;"/>
                </VBox>

                <!-- Routing Section -->
                <VBox spacing="10" styleClass="glass-panel" style="-fx-padding: 15;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🛣️" style="-fx-font-size: 18;"/>
                        <Label text="Routage &amp; Estimation" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #013220;"/>
                    </HBox>
                    <Label text="Consultez la distance et l'heure d'arrivée estimée (ETA) entre vous et le véhicule. Ces données sont calculées dynamiquement via RoutingService." wrapText="true" style="-fx-font-size: 12; -fx-text-fill: #444;"/>
                </VBox>

                <!-- Fleet Section -->
                <VBox spacing="10" styleClass="glass-panel" style="-fx-padding: 15;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🚀" style="-fx-font-size: 18;"/>
                        <Label text="Statut de la Flotte Live" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #013220;"/>
                    </HBox>
                    <Label text="Suivez l'état global du parc automobile en temps réel (total, disponibles, loués). La bannière se rafraîchit automatiquement toutes les 30 secondes." wrapText="true" style="-fx-font-size: 12; -fx-text-fill: #444;"/>
                </VBox>
            </VBox>
        </ScrollPane>

        <!-- Footer -->
        <HBox alignment="CENTER" style="-fx-padding: 20;">
            <Button onAction="#close" styleClass="btn-primary" text="J'ai compris" prefWidth="200"/>
        </HBox>
    </children>
</VBox>
