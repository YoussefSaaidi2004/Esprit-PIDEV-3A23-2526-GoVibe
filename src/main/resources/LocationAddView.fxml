<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.LocationAddController"
            stylesheets="@voiture.css"
            styleClass="app-root">
    <children>
        <VBox spacing="18.0" AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="20.0">
            <children>
                <Label text="Ajout d'une location" styleClass="page-title"/>

                <VBox spacing="12.0">
                    <children>
                        <Label text="Formulaire d'ajout" styleClass="section-title"/>
                        <GridPane hgap="14.0" vgap="12.0" styleClass="card">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="32"/>
                                <RowConstraints minHeight="32"/>
                                <RowConstraints minHeight="32"/>
                                <RowConstraints minHeight="32"/>
                                <RowConstraints minHeight="32"/>
                            </rowConstraints>
                            <children>
                                <Label text="Reference" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                                <TextField fx:id="referenceField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                           promptText="LOC-2026-0001" styleClass="input-field"/>

                                <Label text="Voiture" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="form-label"/>
                                <ComboBox fx:id="voitureBox" GridPane.rowIndex="0" GridPane.columnIndex="3"
                                          promptText="Choisir" styleClass="input-field"/>

                                <Label text="Date debut" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                                <DatePicker fx:id="dateDebutPicker" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                            styleClass="input-field"/>

                                <Label text="Date fin" GridPane.rowIndex="1" GridPane.columnIndex="2" styleClass="form-label"/>
                                <DatePicker fx:id="dateFinPicker" GridPane.rowIndex="1" GridPane.columnIndex="3"
                                            styleClass="input-field"/>

                                <Label text="Nb jours" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                                <TextField fx:id="nbJoursField" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                           promptText="3" styleClass="input-field"/>

                                <Label text="Montant total" GridPane.rowIndex="2" GridPane.columnIndex="2" styleClass="form-label"/>
                                <TextField fx:id="montantTotalField" GridPane.rowIndex="2" GridPane.columnIndex="3"
                                           promptText="360" styleClass="input-field"/>

                                <Label text="Statut" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                                <ComboBox fx:id="statutBox" GridPane.rowIndex="3" GridPane.columnIndex="1"
                                          promptText="Choisir" styleClass="input-field"/>
                            </children>
                        </GridPane>

                        <HBox spacing="12.0" styleClass="actions">
                            <children>
                                <Button fx:id="backButton" text="Retour" onAction="#handleRetour"
                                        styleClass="btn btn-danger"/>
                                <Button fx:id="addButton" text="Ajouter" onAction="#handleAjouter"
                                        styleClass="btn btn-primary"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
