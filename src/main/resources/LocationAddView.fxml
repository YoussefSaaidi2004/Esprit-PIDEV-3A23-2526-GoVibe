<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.LocationAddController"
            stylesheets="@voiture.css"
            styleClass="app-root">

    <left>
        <VBox prefWidth="240" spacing="0" alignment="TOP_CENTER"
              style="-fx-background-color: #013220;">
            <padding><Insets top="25" right="15" bottom="25" left="15"/></padding>

            <VBox alignment="CENTER" spacing="5">
                <ImageView fitHeight="55.0" fitWidth="55.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@org/example/images/logo.png"/></image>
                </ImageView>
                <Label text="GoVibe" style="-fx-text-fill: #D1F2EB; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Espace client" style="-fx-text-fill: #A0E0C9; -fx-font-size: 11px;"/>
            </VBox>

            <Region prefHeight="30"/>

            <VBox spacing="4">
                <Button text="🏠  Accueil" onAction="#handleGoHome" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
                <Button text="📅  Mes locations" onAction="#handleGoLocations" maxWidth="Infinity"
                        style="-fx-background-color: rgba(80,200,120,0.2); -fx-text-fill: #D1F2EB; -fx-font-size: 14px; -fx-padding: 12 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="8" alignment="CENTER">
                <Separator style="-fx-border-color: #084E36;"/>
                <Button text="🚪  Déconnexion" onAction="#handleLogout" maxWidth="Infinity"
                        style="-fx-background-color: rgba(231,76,60,0.15); -fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-padding: 10 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="18.0">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <children>
                <Label text="Ajout d'une location" styleClass="page-title"/>

                <VBox spacing="12.0">
                    <children>
                        <Label text="Formulaire d'ajout" styleClass="section-title"/>
                        <GridPane hgap="14.0" vgap="12.0" styleClass="card">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="32"/>
                                <RowConstraints minHeight="32"/>
                                <RowConstraints minHeight="32"/>
                                <RowConstraints minHeight="32"/>
                                <RowConstraints minHeight="32"/>
                            </rowConstraints>
                            <children>
                                <Label text="Reference" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                                <TextField fx:id="referenceField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                           promptText="LOC-2026-0001" styleClass="input-field"/>

                                <Label text="Voiture" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="form-label"/>
                                <ComboBox fx:id="voitureBox" GridPane.rowIndex="0" GridPane.columnIndex="3"
                                          promptText="Choisir" styleClass="input-field"/>

                                <Label text="Date debut" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                                <DatePicker fx:id="dateDebutPicker" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                            styleClass="input-field"/>

                                <Label text="Date fin" GridPane.rowIndex="1" GridPane.columnIndex="2" styleClass="form-label"/>
                                <DatePicker fx:id="dateFinPicker" GridPane.rowIndex="1" GridPane.columnIndex="3"
                                            styleClass="input-field"/>

                                <Label text="Nb jours" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                                <TextField fx:id="nbJoursField" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                           promptText="3" styleClass="input-field"/>

                                <Label text="Montant total" GridPane.rowIndex="2" GridPane.columnIndex="2" styleClass="form-label"/>
                                <TextField fx:id="montantTotalField" GridPane.rowIndex="2" GridPane.columnIndex="3"
                                           promptText="360" styleClass="input-field"/>

                                <Label text="Statut" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                                <ComboBox fx:id="statutBox" GridPane.rowIndex="3" GridPane.columnIndex="1"
                                          promptText="Choisir" styleClass="input-field"/>
                            </children>
                        </GridPane>

                        <HBox spacing="12.0" styleClass="actions">
                            <children>
                                <Button fx:id="backButton" text="Retour" onAction="#handleRetour"
                                        styleClass="btn btn-danger"/>
                                <Button fx:id="addButton" text="Ajouter" onAction="#handleAjouter"
                                        styleClass="btn btn-primary"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>

</BorderPane>
