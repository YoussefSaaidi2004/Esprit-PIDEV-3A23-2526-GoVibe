<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<!-- Full-screen backdrop with deep dark-green gradient -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controllers.ProposeActivityController"
           style="-fx-background-color: linear-gradient(135deg, #020f08 0%, #051a0e 45%, #07230f 100%);">

    <!-- Glass card centred in the screen -->
    <VBox spacing="0" maxWidth="580" alignment="CENTER"
          style="-fx-background-color: rgba(255,255,255,0.06);
                 -fx-background-radius: 28;
                 -fx-border-color: rgba(78,232,138,0.22);
                 -fx-border-width: 1.5;
                 -fx-border-radius: 28;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 50, 0, 0, 16);
                 -fx-min-width: 540;">

        <!-- ── Header gradient bar ───────────────────────── -->
        <VBox spacing="6"
              style="-fx-background-color: linear-gradient(135deg, rgba(26,143,78,0.55), rgba(11,42,28,0.85));
                     -fx-background-radius: 26 26 0 0;
                     -fx-padding: 30 36 24 36;">
            <!-- Icon + title row -->
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane minWidth="50" minHeight="50"
                           style="-fx-background-color: rgba(78,232,138,0.2);
                                  -fx-background-radius: 16;
                                  -fx-border-color: rgba(78,232,138,0.35);
                                  -fx-border-radius: 16;
                                  -fx-border-width: 1;">
                    <Label text="✨" style="-fx-font-size: 24;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="Proposer une activité"
                           style="-fx-font-size: 22; -fx-font-weight: 900; -fx-text-fill: white;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 6, 0, 0, 1);"/>
                    <Label text="Votre proposition sera soumise à validation par un administrateur."
                           style="-fx-font-size: 12; -fx-text-fill: rgba(255,255,255,0.55);"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Thin accent line -->
        <Region prefHeight="1"
                style="-fx-background-color: linear-gradient(to right, transparent, rgba(78,232,138,0.5), transparent);"/>

        <!-- ── Form body ─────────────────────────────────── -->
        <VBox spacing="18" style="-fx-padding: 30 36 10 36;">

            <!-- Nom de l'activité -->
            <VBox spacing="7">
                <Label text="NOM DE L'ACTIVITÉ"
                       style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: rgba(78,232,138,0.85);
                              -fx-letter-spacing: 1;"/>
                <TextField fx:id="txtName" promptText="Ex: Randonnée au clair de lune"
                           style="-fx-background-color: rgba(255,255,255,0.07);
                                  -fx-border-color: rgba(255,255,255,0.15);
                                  -fx-border-radius: 12; -fx-border-width: 1;
                                  -fx-background-radius: 12;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: rgba(255,255,255,0.3);
                                  -fx-padding: 12 16; -fx-font-size: 14;"/>
            </VBox>

            <!-- Type + Prix row -->
            <HBox spacing="16">
                <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label text="TYPE"
                           style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: rgba(78,232,138,0.85);
                                  -fx-letter-spacing: 1;"/>
                    <TextField fx:id="txtType" promptText="Ex: Sport / Culture"
                               style="-fx-background-color: rgba(255,255,255,0.07);
                                      -fx-border-color: rgba(255,255,255,0.15);
                                      -fx-border-radius: 12; -fx-border-width: 1;
                                      -fx-background-radius: 12;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: rgba(255,255,255,0.3);
                                      -fx-padding: 12 16; -fx-font-size: 14;"/>
                </VBox>
                <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label text="PRIX (TND)"
                           style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: rgba(78,232,138,0.85);
                                  -fx-letter-spacing: 1;"/>
                    <TextField fx:id="txtPrix" promptText="0.00"
                               style="-fx-background-color: rgba(255,255,255,0.07);
                                      -fx-border-color: rgba(255,255,255,0.15);
                                      -fx-border-radius: 12; -fx-border-width: 1;
                                      -fx-background-radius: 12;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: rgba(255,255,255,0.3);
                                      -fx-padding: 12 16; -fx-font-size: 14;"/>
                </VBox>
            </HBox>

            <!-- Localisation -->
            <VBox spacing="7">
                <Label text="LOCALISATION"
                       style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: rgba(78,232,138,0.85);
                              -fx-letter-spacing: 1;"/>
                <ComboBox fx:id="cmbLoc" promptText="Choisir une localisation" maxWidth="Infinity"
                          style="-fx-background-color: rgba(255,255,255,0.07);
                                 -fx-border-color: rgba(255,255,255,0.15);
                                 -fx-border-radius: 12; -fx-border-width: 1;
                                 -fx-background-radius: 12;
                                 -fx-text-fill: white;
                                 -fx-padding: 4 8; -fx-font-size: 14;"/>
            </VBox>

            <!-- Description -->
            <VBox spacing="7">
                <Label text="DESCRIPTION DÉTAILLÉE"
                       style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: rgba(78,232,138,0.85);
                              -fx-letter-spacing: 1;"/>
                <TextArea fx:id="txtDesc" wrapText="true" prefRowCount="4"
                          promptText="Décrivez l'activité en détail..."
                          style="-fx-background-color: rgba(255,255,255,0.07);
                                 -fx-border-color: rgba(255,255,255,0.15);
                                 -fx-border-radius: 12; -fx-border-width: 1;
                                 -fx-background-radius: 12;
                                 -fx-text-fill: white;
                                 -fx-prompt-text-fill: rgba(255,255,255,0.3);
                                 -fx-padding: 12 16; -fx-font-size: 14;
                                 -fx-control-inner-background: transparent;"/>
            </VBox>
        </VBox>

        <!-- Divider before buttons -->
        <Region prefHeight="1" style="-fx-background-color: rgba(255,255,255,0.07);">
            <VBox.margin><Insets top="10" bottom="0"/></VBox.margin>
        </Region>

        <!-- ── Action buttons ─────────────────────────────── -->
        <HBox spacing="14" alignment="CENTER_RIGHT"
              style="-fx-padding: 22 36 28 36;">
            <Button onAction="#cancel" text="Annuler"
                    style="-fx-background-color: rgba(255,255,255,0.08);
                           -fx-text-fill: rgba(255,255,255,0.7);
                           -fx-font-size: 13; -fx-font-weight: 600;
                           -fx-padding: 12 28; -fx-background-radius: 22;
                           -fx-border-color: rgba(255,255,255,0.18);
                           -fx-border-radius: 22; -fx-border-width: 1;
                           -fx-cursor: hand;"/>
            <Button onAction="#submitProposal" text="Envoyer la proposition"
                    style="-fx-background-color: linear-gradient(to bottom, #1a8f4e, #22b860);
                           -fx-text-fill: white;
                           -fx-font-size: 13; -fx-font-weight: 800;
                           -fx-padding: 12 30; -fx-background-radius: 22;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(34,184,96,0.55), 14, 0, 0, 4);"/>
        </HBox>
    </VBox>
</StackPane>
