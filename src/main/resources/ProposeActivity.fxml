<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #F5F3E7;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ProposeActivityController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <Label text="Proposer une Nouvelle Activité" textFill="#013220">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>
    <Label text="Votre activité sera soumise à validation par un administrateur." textFill="#084E36" />

    <VBox spacing="10.0" maxWidth="500">
        <Label style="-fx-font-weight: bold; -fx-text-fill: #013220;" text="Nom de l'activité" />
        <TextField fx:id="txtName" promptText="Ex: Randonnée au clair de lune" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #013220;" text="Type" />
        <TextField fx:id="txtType" promptText="Ex: Sport / Culture" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #013220;" text="Localisation" />
        <ComboBox fx:id="cmbLoc" promptText="Choisir une localisation" maxWidth="Infinity" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #013220;" text="Prix (TND)" />
        <TextField fx:id="txtPrix" promptText="0.0" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #013220;" text="Description détaillée" />
        <TextArea fx:id="txtDesc" wrapText="true" prefRowCount="4" promptText="Décrivez l'activité..." />
    </VBox>

    <HBox alignment="CENTER" spacing="20.0">
        <Button onAction="#submitProposal" style="-fx-background-color: #50C878; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Envoyer la proposition" />
        <Button onAction="#cancel" style="-fx-background-color: #E0E0E0; -fx-text-fill: #333; -fx-cursor: hand;" text="Annuler" />
    </HBox>
</VBox>
