<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.SessionAjoutController">

    <!-- SIDEBAR (même style) -->
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="280" spacing="18" style="-fx-background-color:#073B2A;">
            <padding><Insets bottom="25" left="18" right="18" top="25" /></padding>

            <VBox alignment="CENTER" spacing="8" style="-fx-background-color:#0A4A33; -fx-background-radius:18; -fx-padding:26;">
                <Label style="-fx-text-fill:white; -fx-font-size:28px; -fx-font-weight:bold;" text="GoVibe" />
                <Label style="-fx-text-fill:#8FE7C9; -fx-font-size:13px;" text="Administration" />
                <Label style="-fx-text-fill:#8FE7C9; -fx-font-size:13px;" text="Dashboard Sessions" />
            </VBox>

            <Region prefHeight="8" />

            <Button maxWidth="Infinity" onAction="#openDashboardSessions" style="-fx-background-color: transparent; -fx-text-fill: #CFF6E8;                            -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 12;                            -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="▣  Dashboard Sessions" />

            <Button maxWidth="Infinity" onAction="#openAjoutSession" style="-fx-background-color: rgba(80,200,120,0.25); -fx-text-fill: white;                            -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 12;                            -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-font-weight: bold;" text="+  Ajouter Session" />

            <Button maxWidth="Infinity" onAction="#openModifierSession" style="-fx-background-color: transparent; -fx-text-fill: #CFF6E8;                            -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 12;                            -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="✎  Modifier Session" />

            <Button maxWidth="Infinity" onAction="#openSuppressionSession" style="-fx-background-color: transparent; -fx-text-fill: #CFF6E8;                            -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 12;                            -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="🗑  Supprimer Session" />

            <Region VBox.vgrow="ALWAYS" />
            <Separator style="-fx-border-color: rgba(255,255,255,0.25);" />

            <Label style="-fx-background-color: rgba(80,200,120,0.15); -fx-text-fill:#50C878;                           -fx-padding:8 18; -fx-background-radius:20; -fx-font-size:12px; -fx-font-weight:bold;" text="● En ligne" />
        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <VBox spacing="0" style="-fx-background-color:#D1F2EB;">

            <HBox alignment="CENTER_LEFT" style="-fx-background-color:#F5F3E7; -fx-border-color:#A0E0C9; -fx-border-width:0 0 1 0;">
                <padding><Insets bottom="16" left="28" right="28" top="16" /></padding>
                <VBox spacing="3">
                    <Label style="-fx-text-fill:#013220; -fx-font-size:22px; -fx-font-weight:bold;" text="Ajouter une Session" />
                    <Label style="-fx-text-fill:#084E36; -fx-font-size:13px;" text="Choisis l’activité et ajoute la session" />
                </VBox>
            </HBox>

            <StackPane style="-fx-background-color:#D1F2EB; -fx-padding:22;">
                <VBox maxWidth="700" spacing="16" style="-fx-background-color:#F5F3E7; -fx-background-radius:14; -fx-padding:26;                              -fx-effect:dropshadow(three-pass-box, rgba(1,50,32,0.12), 10, 0, 0, 4);">

                    <Label style="-fx-text-fill:#013220; -fx-font-size:18px; -fx-font-weight:bold;" text="Formulaire Session" />

                    <GridPane hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="170" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>

                        <Label text="Activité :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <ComboBox fx:id="cbActivite" promptText="Choisir une activité..." GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Date (yyyy-mm-dd) :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="tfDate" promptText="2026-02-11" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Heure (HH:mm) :" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="tfHeure" promptText="14:30" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Capacité :" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <TextField fx:id="tfCapacite" promptText="ex: 20" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Places restantes :" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <TextField fx:id="tfRestant" promptText="ex: 20" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <rowConstraints>
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                  </rowConstraints>
                    </GridPane>

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Button onAction="#ajouter" style="-fx-background-color:#50C878; -fx-text-fill:white; -fx-font-weight:bold;                                        -fx-padding:12 24; -fx-background-radius:10; -fx-cursor:hand;" text="➕ Ajouter" />
                        <Label fx:id="lblMsg" style="-fx-text-fill: green; -fx-font-weight: bold;" text="" />
                    </HBox>

                </VBox>
            </StackPane>

        </VBox>
    </center>

</BorderPane>
