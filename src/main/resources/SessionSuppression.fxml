<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.SessionSuppressionController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="280" spacing="14" style="-fx-background-color:#013220;">
            <padding>
                <Insets bottom="25" left="18" right="18" top="25"/>
            </padding>

            <VBox alignment="CENTER" spacing="6"
                  style="-fx-background-color: rgba(255,255,255,0.06); -fx-padding: 18; -fx-background-radius: 14;">
                <Label text="GoVibe"
                       style="-fx-text-fill: #D1F2EB; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                <Label text="Administration"
                       style="-fx-text-fill: #A0E0C9; -fx-font-size: 12px;"/>
                <Label text="Suppression Session"
                       style="-fx-text-fill: #A0E0C9; -fx-font-size: 12px;"/>
            </VBox>

            <Region prefHeight="10"/>

            <!-- Menu Sessions -->
            <VBox spacing="10">
                <Button text="🧩  Dashboard Sessions" maxWidth="Infinity" onAction="#openDashboardSessions"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px;
                               -fx-padding: 12 16; -fx-background-radius: 12; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

                <Button text="➕  Ajouter Session" maxWidth="Infinity" onAction="#openAjoutSession"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px;
                               -fx-padding: 12 16; -fx-background-radius: 12; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

                <Button text="✏  Modifier Session" maxWidth="Infinity" onAction="#openModifierSession"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px;
                               -fx-padding: 12 16; -fx-background-radius: 12; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

                <!-- Actif -->
                <Button text="🗑  Supprimer Session" maxWidth="Infinity" onAction="#openSuppressionSession"
                        style="-fx-background-color: rgba(80,200,120,0.22); -fx-text-fill: #D1F2EB; -fx-font-size: 14px;
                               -fx-padding: 12 16; -fx-background-radius: 12; -fx-alignment: CENTER_LEFT;
                               -fx-cursor: hand; -fx-font-weight: bold;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator style="-fx-border-color: rgba(160,224,201,0.25);"/>

            <Label text="● En ligne"
                   style="-fx-background-color: rgba(80,200,120,0.15); -fx-text-fill: #50C878;
                          -fx-padding: 6 16; -fx-background-radius: 20; -fx-font-size: 12px; -fx-font-weight: bold;"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="0" style="-fx-background-color:#D1F2EB;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color:#F5F3E7; -fx-border-color:#A0E0C9; -fx-border-width:0 0 1 0;">
                <padding>
                    <Insets bottom="16" left="28" right="28" top="16"/>
                </padding>

                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Supprimer une Session"
                           style="-fx-text-fill:#013220; -fx-font-size:22px; -fx-font-weight:bold;"/>
                    <Label text="Charge la session par ID puis clique sur supprimer"
                           style="-fx-text-fill:#084E36; -fx-font-size:13px;"/>
                </VBox>
            </HBox>

            <!-- Content -->
            <ScrollPane fitToWidth="true"
                        style="-fx-background-color: transparent; -fx-background: #D1F2EB;"
                        VBox.vgrow="ALWAYS">
                <VBox spacing="22">
                    <padding>
                        <Insets bottom="30" left="35" right="35" top="30"/>
                    </padding>

                    <VBox spacing="16"
                          style="-fx-background-color:#F5F3E7; -fx-background-radius:14; -fx-padding:26;
                                 -fx-effect:dropshadow(three-pass-box, rgba(1,50,32,0.12), 10, 0, 0, 4);">

                        <Label text="Choisir la session à supprimer"
                               style="-fx-text-fill:#013220; -fx-font-size:18px; -fx-font-weight:bold;"/>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="ID Session :"
                                   style="-fx-text-fill:#084E36; -fx-font-weight:bold;"/>
                            <TextField fx:id="tfId" prefWidth="160" promptText="Ex: 1"
                                       style="-fx-background-radius:10; -fx-border-radius:10; -fx-border-color:#A0E0C9;
                                              -fx-border-width:1; -fx-padding:10;"/>
                            <Button text="Charger" onAction="#charger"
                                    style="-fx-background-color:#084E36; -fx-text-fill:white; -fx-font-weight:bold;
                                           -fx-padding:10 18; -fx-background-radius:10; -fx-cursor: hand;"/>
                        </HBox>

                        <Separator/>

                        <Label text="Informations (lecture seule)"
                               style="-fx-text-fill:#013220; -fx-font-size:18px; -fx-font-weight:bold;"/>

                        <GridPane hgap="12" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="170"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Date :" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                   style="-fx-text-fill:#084E36; -fx-font-weight:bold;"/>
                            <TextField fx:id="tfDate" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label text="Heure :" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                   style="-fx-text-fill:#084E36; -fx-font-weight:bold;"/>
                            <TextField fx:id="tfHeure" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="Capacité :" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                   style="-fx-text-fill:#084E36; -fx-font-weight:bold;"/>
                            <TextField fx:id="tfCapacite" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label text="Places restantes :" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                   style="-fx-text-fill:#084E36; -fx-font-weight:bold;"/>
                            <TextField fx:id="tfRestant" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <Label text="Activité ID :" GridPane.columnIndex="0" GridPane.rowIndex="4"
                                   style="-fx-text-fill:#084E36; -fx-font-weight:bold;"/>
                            <TextField fx:id="tfActiviteId" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        </GridPane>

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Button text="Supprimer" onAction="#supprimer"
                                    style="-fx-background-color:#e74c3c; -fx-text-fill:white; -fx-font-weight:bold;
                                           -fx-padding:10 18; -fx-background-radius:10; -fx-cursor: hand;"/>

                            <Button text="Vider" onAction="#vider"
                                    style="-fx-background-color: rgba(231,76,60,0.15); -fx-text-fill:#e74c3c; -fx-font-weight:bold;
                                           -fx-padding:10 18; -fx-background-radius:10; -fx-cursor: hand;"/>

                            <Label fx:id="lblMsg" text=""
                                   style="-fx-text-fill: green; -fx-font-weight: bold;"/>
                        </HBox>

                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
