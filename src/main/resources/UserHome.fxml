<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.UserHomeController"
      spacing="0">

    <!-- TOP NAV -->
    <HBox alignment="CENTER" spacing="0"
          style="-fx-background-color: white; -fx-border-color: #A0E0C9; -fx-border-width: 0 0 1 0;">
        <padding><Insets top="10" right="40" bottom="10" left="40"/></padding>

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <ImageView fitHeight="40.0" fitWidth="40.0" preserveRatio="true">
                <image>
                    <Image url="@images/logo.png"/>
                </image>
            </ImageView>

            <Label text="GoVibe"
                   style="-fx-text-fill: #013220; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        </HBox>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- User info -->
        <HBox alignment="CENTER_RIGHT" spacing="12">
            <Label fx:id="welcomeLabel" text="Bonjour !"
                   style="-fx-text-fill: #013220; -fx-font-size: 14px; -fx-font-weight: bold;"/>

            <Button text="Déconnexion" onAction="#handleLogout"
                    style="-fx-background-color: #50C878; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
        </HBox>
    </HBox>

    <!-- HERO -->
    <StackPane style="-fx-min-height: 260px;">
        <VBox alignment="CENTER"
              style="-fx-background-color: linear-gradient(to bottom, #084E36, #013220 40%, #50C878 90%, #A0E0C9);"/>
        <VBox alignment="CENTER" spacing="10">
            <padding><Insets top="30" right="60" bottom="30" left="60"/></padding>

            <Text text="Vivez l'aventure, explorez le monde"
                  style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-fill: white;"/>

            <Label text="Double‑clic sur une activité pour voir les détails"
                   style="-fx-text-fill: #D1F2EB; -fx-font-size: 14px;"/>
        </VBox>
    </StackPane>

    <!-- ACTIVITES -->
    <VBox spacing="12" style="-fx-background-color: #F5F3E7;">
        <padding><Insets top="18" right="40" bottom="18" left="40"/></padding>

        <Label text="✨ Activités populaires"
               style="-fx-text-fill: #013220; -fx-font-size: 18px; -fx-font-weight: bold;"/>

        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <content>
                <TilePane fx:id="activitiesPane"
                          prefColumns="3"
                          hgap="18" vgap="18"
                          style="-fx-padding: 6;">
                </TilePane>
            </content>
        </ScrollPane>
    </VBox>

</VBox>