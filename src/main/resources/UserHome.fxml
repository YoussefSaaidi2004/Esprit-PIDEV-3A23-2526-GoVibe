<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.UserHomeController"
            stylesheets="@org/example/styles.css">

    <!-- ==================== LEFT SIDEBAR ==================== -->
    <left>
        <VBox prefWidth="240" spacing="0" alignment="TOP_CENTER"
              style="-fx-background-color: #013220;">
            <padding><Insets top="25" right="15" bottom="25" left="15"/></padding>

            <VBox alignment="CENTER" spacing="5">
                <ImageView fitHeight="55.0" fitWidth="55.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@org/example/images/logo.png"/></image>
                </ImageView>
                <Label text="GoVibe" style="-fx-text-fill: #D1F2EB; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Espace client" style="-fx-text-fill: #A0E0C9; -fx-font-size: 11px;"/>
            </VBox>

            <Region prefHeight="30"/>

            <VBox spacing="4">
                <Button text="🏠 Accueil" onAction="#handleHome" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
                <Button onAction="#handleFlights" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
                                     style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
                            <Label text="Vols" style="-fx-text-fill: #A0E0C9; -fx-font-size: 14px;"/>
                        </HBox>
                    </graphic>
                </Button>
                <Button text="📍 Mes locations" onAction="#handleLocations" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
                <Button text="🛏️ Chambres" onAction="#handleChambres" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
                <!-- ACTIVE: Activités -->
                <Button text="✨ Activités" onAction="#handleActivities" maxWidth="Infinity"
                        style="-fx-background-color: rgba(80,200,120,0.2); -fx-text-fill: #D1F2EB; -fx-font-size: 14px; -fx-padding: 12 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT;"/>
                <Button text="💬 Forums" onAction="#handleForums" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 12 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="8" alignment="CENTER">
                <Separator style="-fx-border-color: #084E36;"/>
                <Button text="🚪 Déconnexion" onAction="#handleLogout" maxWidth="Infinity"
                        style="-fx-background-color: rgba(231,76,60,0.15); -fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-padding: 10 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
            </VBox>
        </VBox>
    </left>

    <!-- ==================== CENTER CONTENT ==================== -->
    <center>
        <VBox spacing="0">

            <!-- TOP HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="15"
                  style="-fx-background-color: #F5F3E7; -fx-border-color: #A0E0C9; -fx-border-width: 0 0 1 0;">
                <padding><Insets top="14" right="40" bottom="14" left="40"/></padding>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="welcomeLabel" text="Bonjour !"
                           style="-fx-text-fill: #013220; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Découvrez et réservez des activités"
                           style="-fx-text-fill: #084E36; -fx-font-size: 13px;"/>
                </VBox>
                <Button text="➕ Proposer une activité" onAction="#openProposeActivity"
                        style="-fx-background-color: #084E36; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;
                               -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>

            <!-- ACTIVITES LIST -->
            <VBox spacing="12" VBox.vgrow="ALWAYS" style="-fx-background-color: #D1F2EB;">
                <padding><Insets top="20" right="40" bottom="20" left="40"/></padding>

                <Label text="✨ Activités populaires"
                       style="-fx-text-fill: #013220; -fx-font-size: 18px; -fx-font-weight: bold;"/>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                    <content>
                        <TilePane fx:id="activitiesPane"
                                  prefColumns="3"
                                  hgap="18" vgap="18"
                                  style="-fx-padding: 6;"/>
                    </content>
                </ScrollPane>
            </VBox>

        </VBox>
    </center>

</BorderPane>