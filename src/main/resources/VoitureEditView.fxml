<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.VoitureEditController"
            stylesheets="@voiture.css"
            styleClass="app-root">
    <children>
        <VBox spacing="18.0" AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="20.0">
            <children>
                <Label text="Modification d'une voiture" styleClass="page-title"/>

                <VBox spacing="12.0">
                    <children>
                        <Label text="Formulaire de modification" styleClass="section-title"/>
                        <GridPane hgap="14.0" vgap="12.0" styleClass="card">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="32"/>
                                <RowConstraints minHeight="32"/>
                                <RowConstraints minHeight="32"/>
                                <RowConstraints minHeight="32"/>
                            </rowConstraints>
                            <children>
                                <Label text="Matricule" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                                <TextField fx:id="matriculeField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                           promptText="AB-123-CD" styleClass="input-field"/>

                                <Label text="Marque" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="form-label"/>
                                <TextField fx:id="marqueField" GridPane.rowIndex="0" GridPane.columnIndex="3"
                                           promptText="Toyota" styleClass="input-field"/>

                                <Label text="Modele" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                                <TextField fx:id="modeleField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                           promptText="Corolla" styleClass="input-field"/>

                                <Label text="Annee" GridPane.rowIndex="1" GridPane.columnIndex="2" styleClass="form-label"/>
                                <TextField fx:id="anneeField" GridPane.rowIndex="1" GridPane.columnIndex="3"
                                           promptText="2024" styleClass="input-field"/>

                                <Label text="Carburant" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                                <ComboBox fx:id="typeCarburantBox" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                          promptText="Choisir" styleClass="input-field"/>

                                <Label text="Prix/Jour" GridPane.rowIndex="2" GridPane.columnIndex="2" styleClass="form-label"/>
                                <TextField fx:id="prixJourField" GridPane.rowIndex="2" GridPane.columnIndex="3"
                                           promptText="120" styleClass="input-field"/>

                                <Label text="Statut" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                                <ComboBox fx:id="statutBox" GridPane.rowIndex="3" GridPane.columnIndex="1"
                                          promptText="Choisir" styleClass="input-field"/>

                                <Label text="Agence" GridPane.rowIndex="3" GridPane.columnIndex="2" styleClass="form-label"/>
                                <ComboBox fx:id="agenceBox" GridPane.rowIndex="3" GridPane.columnIndex="3"
                                          promptText="Choisir" styleClass="input-field"/>
                            </children>
                        </GridPane>

                        <GridPane hgap="14.0" vgap="12.0" styleClass="card">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                            </columnConstraints>
                            <children>
                                <Label text="Image URL" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                                <TextField fx:id="imageUrlField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                           promptText="https://..." styleClass="input-field"/>

                                <Label text="Description" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                                <TextArea fx:id="descriptionArea" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3"
                                          prefRowCount="4" wrapText="true"
                                          promptText="Decrivez la voiture, ses options, son etat et ses particularites"
                                          styleClass="description-area"/>
                            </children>
                            <padding>
                                <Insets top="0" right="0" bottom="0" left="0"/>
                            </padding>
                        </GridPane>

                        <HBox spacing="12.0" styleClass="actions">
                            <children>
                                <Button fx:id="backButton" text="Retour" onAction="#handleRetour"
                                        styleClass="btn btn-danger"/>
                                <Button fx:id="updateButton" text="Modifier" onAction="#handleModifier"
                                        styleClass="btn btn-accent"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
