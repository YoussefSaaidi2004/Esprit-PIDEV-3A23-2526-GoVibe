<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.VoitureListController"
            stylesheets="@styles/unified-styles.css, @styles.css, @voiture.css">

    <left>
        <fx:include source="org/example/AdminSidebar.fxml"/>
    </left>

    <center>
        <StackPane fx:id="rootStack">
            <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false"/>
            <Region style="-fx-background-color: linear-gradient(to bottom right, rgba(0,8,4,0.58) 0%, rgba(1,20,11,0.52) 40%, rgba(1,30,16,0.60) 100%);"/>

            <VBox spacing="24" maxWidth="Infinity" maxHeight="Infinity" style="-fx-padding: 40;">

                <!-- Header row -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <StackPane style="-fx-background-color: rgba(80,200,120,0.18); -fx-background-radius: 16; -fx-padding: 14; -fx-effect: dropshadow(gaussian, rgba(80,200,120,0.45), 20, 0, 0, 0);">
                        <Text text="🚗" style="-fx-font-size: 28px;"/>
                    </StackPane>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Text text="Gestion des Voitures"
                              style="-fx-font-size: 30px; -fx-font-weight: 900; -fx-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 12, 0, 0, 2);"/>
                        <Text text="Parc automobile, locations et statistiques"
                              style="-fx-font-size: 14px; -fx-fill: rgba(180,230,210,0.72);"/>
                    </VBox>
                    <Button fx:id="locationListButton" visible="false" managed="false"
                            onAction="#handleOpenLocations" prefHeight="42"
                            style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 11; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1.5; -fx-border-radius: 11; -fx-text-fill: white; -fx-font-weight: 700; -fx-padding: 10 18; -fx-cursor: hand;" text="Locations"/>
                    <Button fx:id="adminLocationButton" onAction="#handleOpenAdminLocations" prefHeight="42"
                            style="-fx-background-color: rgba(80,200,120,0.14); -fx-background-radius: 11; -fx-border-color: rgba(80,200,120,0.42); -fx-border-width: 1.5; -fx-border-radius: 11; -fx-padding: 10 18; -fx-cursor: hand;">
                        <graphic><Text text="📋  Admin Locations" style="-fx-fill: #50C878; -fx-font-weight: 700; -fx-font-size: 13;"/></graphic>
                    </Button>
                    <Button fx:id="addPageButton" onAction="#handleOpenAdd" prefHeight="42"
                            style="-fx-background-color: linear-gradient(to bottom right, #50C878, #2e9952); -fx-background-radius: 11; -fx-border-width: 0; -fx-padding: 10 24; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(80,200,120,0.65), 22, 0, 0, 5);">
                        <graphic><Text text="＋  AJOUTER" style="-fx-fill: white; -fx-font-weight: 900; -fx-font-size: 13;"/></graphic>
                    </Button>
                </HBox>

                <!-- Stat Tiles -->
                <HBox spacing="20">
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(255,255,255,0.07); -fx-background-radius: 16; -fx-border-color: rgba(80,200,120,0.28); -fx-border-width: 1.5; -fx-border-radius: 16; -fx-padding: 18 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.38), 18, 0, 0, 6);">
                        <Text text="TOTAL VOITURES" style="-fx-fill: rgba(180,230,210,0.65); -fx-font-size: 11; -fx-font-weight: 800;"/>
                        <Label fx:id="totalCountLabel" text="—" style="-fx-font-size: 30; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(255,255,255,0.07); -fx-background-radius: 16; -fx-border-color: rgba(80,200,120,0.28); -fx-border-width: 1.5; -fx-border-radius: 16; -fx-padding: 18 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.38), 18, 0, 0, 6);">
                        <Text text="DISPONIBLES" style="-fx-fill: rgba(180,230,210,0.65); -fx-font-size: 11; -fx-font-weight: 800;"/>
                        <Label fx:id="availableCountLabel" text="—" style="-fx-font-size: 30; -fx-font-weight: 900; -fx-text-fill: #50C878;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(255,255,255,0.07); -fx-background-radius: 16; -fx-border-color: rgba(80,200,120,0.28); -fx-border-width: 1.5; -fx-border-radius: 16; -fx-padding: 18 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.38), 18, 0, 0, 6);">
                        <Text text="PRIX MOYEN / JOUR" style="-fx-fill: rgba(180,230,210,0.65); -fx-font-size: 11; -fx-font-weight: 800;"/>
                        <Label fx:id="avgPriceLabel" text="—" style="-fx-font-size: 30; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(255,255,255,0.07); -fx-background-radius: 16; -fx-border-color: rgba(80,200,120,0.28); -fx-border-width: 1.5; -fx-border-radius: 16; -fx-padding: 18 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.38), 18, 0, 0, 6);">
                        <Text text="TOP AGENCE" style="-fx-fill: rgba(180,230,210,0.65); -fx-font-size: 11; -fx-font-weight: 800;"/>
                        <Label fx:id="topAgenceLabel" text="—" style="-fx-font-size: 18; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    </VBox>
                </HBox>

                <!-- Search / Filter / Export Toolbar -->
                <HBox spacing="14" alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(255,255,255,0.07); -fx-background-radius: 18; -fx-border-color: rgba(80,200,120,0.30); -fx-border-width: 1.5; -fx-border-radius: 18; -fx-padding: 10 20;">
                    <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                             style="-fx-fill: rgba(80,200,120,0.65);" scaleX="0.85" scaleY="0.85"/>
                    <TextField fx:id="searchField" promptText="Rechercher par modèle, marque, agence..." HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: rgba(180,220,200,0.42); -fx-font-size: 14; -fx-border-width: 0; -fx-padding: 8 6;"/>
                    <ComboBox fx:id="agenceFilter" promptText="Agence"
                              style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 10; -fx-border-color: rgba(80,200,120,0.30); -fx-border-width: 1; -fx-border-radius: 10;"/>
                    <ComboBox fx:id="sortChoice" promptText="Trier par"
                              style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 10; -fx-border-color: rgba(80,200,120,0.30); -fx-border-width: 1; -fx-border-radius: 10;"/>
                    <ComboBox fx:id="pageSizeBox" promptText="Par page"
                              style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 10; -fx-border-color: rgba(80,200,120,0.30); -fx-border-width: 1; -fx-border-radius: 10;"/>
                    <Button fx:id="exportPdfButton" onAction="#handleExportPdf" text="PDF"
                            style="-fx-background-color: rgba(255,80,80,0.18); -fx-background-radius: 9; -fx-border-color: rgba(255,80,80,0.40); -fx-border-width: 1.2; -fx-border-radius: 9; -fx-text-fill: rgba(255,160,160,0.90); -fx-font-weight: 700; -fx-padding: 8 14; -fx-cursor: hand;"/>
                    <Button fx:id="exportExcelButton" onAction="#handleExportExcel" text="Excel"
                            style="-fx-background-color: rgba(80,200,120,0.14); -fx-background-radius: 9; -fx-border-color: rgba(80,200,120,0.38); -fx-border-width: 1.2; -fx-border-radius: 9; -fx-text-fill: #50C878; -fx-font-weight: 700; -fx-padding: 8 14; -fx-cursor: hand;"/>
                    <Button fx:id="themeToggleButton" onAction="#handleToggleTheme" text="◑"
                            style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 9; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1.2; -fx-border-radius: 9; -fx-text-fill: white; -fx-font-size: 16; -fx-padding: 8 12; -fx-cursor: hand;"/>
                </HBox>

                <!-- Car List -->
                <VBox spacing="0" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 18; -fx-border-color: rgba(80,200,120,0.22); -fx-border-width: 1.5; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.38), 20, 0, 0, 8);">
                    <ListView fx:id="voitureList" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 8 0;"/>
                </VBox>

                <!-- Pagination -->
                <HBox alignment="CENTER" spacing="16">
                    <Button fx:id="prevPageButton" onAction="#handlePrevPage" text="◀  Préc"
                            style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1.5; -fx-border-radius: 10; -fx-text-fill: white; -fx-font-weight: 700; -fx-padding: 10 20; -fx-cursor: hand;"/>
                    <Label fx:id="pageInfoLabel" text="Page 1 / 1"
                           style="-fx-text-fill: rgba(200,240,220,0.80); -fx-font-size: 14; -fx-font-weight: 700;"/>
                    <Button fx:id="nextPageButton" onAction="#handleNextPage" text="Suiv  ▶"
                            style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1.5; -fx-border-radius: 10; -fx-text-fill: white; -fx-font-weight: 700; -fx-padding: 10 20; -fx-cursor: hand;"/>
                </HBox>

            </VBox>
        </StackPane>
    </center>
</BorderPane>
