<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.VoitureController"
            style="-fx-background-color: #F5F3E7;">
    <children>
        <VBox spacing="18.0" AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="20.0">
            <children>
                  <Label text="Gestion des Voitures"
                      style="-fx-font-size: 26px; -fx-text-fill: #013220; -fx-font-weight: bold; -fx-font-family: 'Sans Serif';"/>

                <GridPane hgap="14.0" vgap="12.0"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 18; -fx-border-radius: 18; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(1,50,32,0.12), 12, 0.2, 0, 3);">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="32"/>
                        <RowConstraints minHeight="32"/>
                        <RowConstraints minHeight="32"/>
                        <RowConstraints minHeight="32"/>
                    </rowConstraints>
                    <children>
                        <Label text="Matricule" GridPane.rowIndex="0" GridPane.columnIndex="0"
                               style="-fx-text-fill: #013220; -fx-font-weight: bold;"/>
                        <TextField fx:id="matriculeField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                   promptText="AB-123-CD"
                                   style="-fx-background-color: #D1F2EB; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #BFE7DA; -fx-padding: 8 12;"/>

                        <Label text="Marque" GridPane.rowIndex="0" GridPane.columnIndex="2"
                               style="-fx-text-fill: #013220; -fx-font-weight: bold;"/>
                        <TextField fx:id="marqueField" GridPane.rowIndex="0" GridPane.columnIndex="3"
                                   promptText="Toyota"
                                   style="-fx-background-color: #D1F2EB; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #BFE7DA; -fx-padding: 8 12;"/>

                        <Label text="Modèle" GridPane.rowIndex="1" GridPane.columnIndex="0"
                               style="-fx-text-fill: #013220; -fx-font-weight: bold;"/>
                        <TextField fx:id="modeleField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                   promptText="Corolla"
                                   style="-fx-background-color: #D1F2EB; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #BFE7DA; -fx-padding: 8 12;"/>

                        <Label text="Année" GridPane.rowIndex="1" GridPane.columnIndex="2"
                               style="-fx-text-fill: #013220; -fx-font-weight: bold;"/>
                        <TextField fx:id="anneeField" GridPane.rowIndex="1" GridPane.columnIndex="3"
                                   promptText="2024"
                                   style="-fx-background-color: #D1F2EB; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #BFE7DA; -fx-padding: 8 12;"/>

                        <Label text="Carburant" GridPane.rowIndex="2" GridPane.columnIndex="0"
                               style="-fx-text-fill: #013220; -fx-font-weight: bold;"/>
                        <TextField fx:id="typeCarburantField" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                   promptText="Essence"
                                   style="-fx-background-color: #D1F2EB; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #BFE7DA; -fx-padding: 8 12;"/>

                        <Label text="Prix/Jour" GridPane.rowIndex="2" GridPane.columnIndex="2"
                               style="-fx-text-fill: #013220; -fx-font-weight: bold;"/>
                        <TextField fx:id="prixJourField" GridPane.rowIndex="2" GridPane.columnIndex="3"
                                   promptText="120"
                                   style="-fx-background-color: #D1F2EB; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #BFE7DA; -fx-padding: 8 12;"/>

                        <Label text="Statut" GridPane.rowIndex="3" GridPane.columnIndex="0"
                               style="-fx-text-fill: #013220; -fx-font-weight: bold;"/>
                        <TextField fx:id="statutField" GridPane.rowIndex="3" GridPane.columnIndex="1"
                                   promptText="Disponible"
                                   style="-fx-background-color: #D1F2EB; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #BFE7DA; -fx-padding: 8 12;"/>

                        <Label text="Adresse" GridPane.rowIndex="3" GridPane.columnIndex="2"
                               style="-fx-text-fill: #013220; -fx-font-weight: bold;"/>
                        <TextField fx:id="adresseAgenceField" GridPane.rowIndex="3" GridPane.columnIndex="3"
                                   promptText="Rue des Oliviers"
                                   style="-fx-background-color: #D1F2EB; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #BFE7DA; -fx-padding: 8 12;"/>
                    </children>
                </GridPane>

                <GridPane hgap="14.0" vgap="12.0"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 18; -fx-border-radius: 18; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(1,50,32,0.12), 12, 0.2, 0, 3);">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>
                    <children>
                           <Label text="Latitude" GridPane.rowIndex="0" GridPane.columnIndex="0"
                               style="-fx-text-fill: #013220; -fx-font-weight: bold;"/>
                        <TextField fx:id="latitudeField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                promptText="36.8065"
                                style="-fx-background-color: #D1F2EB; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #BFE7DA; -fx-padding: 8 12;"/>

                           <Label text="Longitude" GridPane.rowIndex="0" GridPane.columnIndex="2"
                               style="-fx-text-fill: #013220; -fx-font-weight: bold;"/>
                        <TextField fx:id="longitudeField" GridPane.rowIndex="0" GridPane.columnIndex="3"
                                promptText="10.1815"
                                style="-fx-background-color: #D1F2EB; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #BFE7DA; -fx-padding: 8 12;"/>

                           <Label text="Image URL" GridPane.rowIndex="1" GridPane.columnIndex="0"
                               style="-fx-text-fill: #013220; -fx-font-weight: bold;"/>
                        <TextField fx:id="imageUrlField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                promptText="https://..."
                                style="-fx-background-color: #D1F2EB; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #BFE7DA; -fx-padding: 8 12;"/>

                           <Label text="Description" GridPane.rowIndex="2" GridPane.columnIndex="0"
                               style="-fx-text-fill: #013220; -fx-font-weight: bold;"/>
                        <TextArea fx:id="descriptionArea" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="3"
                                  prefRowCount="3"
                                  style="-fx-background-color: #D1F2EB; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #BFE7DA; -fx-padding: 8 12;"/>
                    </children>
                    <padding>
                        <Insets top="0" right="0" bottom="0" left="0"/>
                    </padding>
                </GridPane>

                <HBox spacing="12.0">
                    <children>
                        <Button text="Ajouter" onAction="#handleAjouter"
                        style="-fx-background-color: #50C878; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-padding: 10 18; -fx-effect: dropshadow(gaussian, rgba(80,200,120,0.35), 10, 0.2, 0, 2);"/>
                        <Button text="Modifier" onAction="#handleModifier"
                        style="-fx-background-color: #0B64EF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-padding: 10 18; -fx-effect: dropshadow(gaussian, rgba(11,100,239,0.35), 10, 0.2, 0, 2);"/>
                        <Button text="Supprimer" onAction="#handleSupprimer"
                        style="-fx-background-color: #013220; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-padding: 10 18; -fx-effect: dropshadow(gaussian, rgba(1,50,32,0.35), 10, 0.2, 0, 2);"/>
                    </children>
                </HBox>

                <TableView fx:id="voitureTable" prefHeight="300.0"
                       style="-fx-background-color: #FFFFFF; -fx-background-radius: 18; -fx-border-radius: 18; -fx-padding: 6; -fx-effect: dropshadow(gaussian, rgba(1,50,32,0.12), 12, 0.2, 0, 3);">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="matriculeColumn" text="Matricule" prefWidth="120"/>
                        <TableColumn fx:id="marqueColumn" text="Marque" prefWidth="120"/>
                        <TableColumn fx:id="modeleColumn" text="Modèle" prefWidth="120"/>
                        <TableColumn fx:id="anneeColumn" text="Année" prefWidth="80"/>
                        <TableColumn fx:id="typeCarburantColumn" text="Carburant" prefWidth="120"/>
                        <TableColumn fx:id="prixJourColumn" text="Prix/J" prefWidth="80"/>
                        <TableColumn fx:id="statutColumn" text="Statut" prefWidth="100"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>
