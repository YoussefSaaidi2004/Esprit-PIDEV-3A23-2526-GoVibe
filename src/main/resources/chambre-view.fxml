<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootStack" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controllers.ChambreViewController"
           style="-fx-background-color: #013220;">

    <!-- Background Image -->
    <ImageView fx:id="bgImageView" preserveRatio="false" smooth="true" opacity="0.85">
        <!-- Image is set dynamically in the controller -->
    </ImageView>

    <!-- Dark Gradient Overlay -->
    <Region style="-fx-background-color: linear-gradient(to bottom, rgba(1,50,32,0.6) 0%, rgba(1,50,32,0.95) 100%);"/>

    <!-- Main Content -->
    <VBox spacing="0">
        
        <!-- Navigation Bar -->
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: rgba(0,0,0,0.3); -fx-padding: 15 40; -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 0 0 1 0;">
            <Button text="🏨 Hôtels" onAction="#goToHotels"
                    styleClass="premium-nav-btn" />
            <Button text="🛏️ Chambres" onAction="#goToChambres"
                    styleClass="premium-nav-btn-active" />
            <Button text="📅 Réservations Client" onAction="#goToReservations"
                    styleClass="premium-nav-btn" />
            
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="⬅ Dashboard Admin" onAction="#backToDashboard"
                    styleClass="premium-sidebar-btn" />
        </HBox>

        <!-- Hero Title Section -->
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 60 40 40 40;">
            <Label text="Gestion des Hébergements" styleClass="hero-title" />
            <Label text="Configurez vos chambres et suites pour une expérience client inoubliable ✨" 
                   style="-fx-text-fill: #A0E0C9; -fx-font-size: 16px; -fx-font-weight: 500;" />
        </VBox>

        <!-- Toolbar: Filter, Search & Add -->
        <HBox alignment="CENTER" spacing="15" style="-fx-padding: 0 40 30 40;">
            <ComboBox fx:id="filterHotelCombo" promptText="Filtrer par hôtel"
                      onAction="#filterByHotel"
                      prefWidth="220"
                      styleClass="glass-combo-box" />

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="glass-search-box" prefWidth="400">
                <Label text="🔍" style="-fx-text-fill: #A0E0C9; -fx-font-size: 16px;"/>
                <TextField fx:id="searchField" promptText="Rechercher par numéro ou type..."
                           onKeyReleased="#searchChambres"
                           style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: #A0E0C9; -fx-font-size: 14px;"
                           HBox.hgrow="ALWAYS" />
            </HBox>

            <Button text="➕ Créer Chambre" onAction="#addChambre" styleClass="premium-button" />
        </HBox>

        <!-- Scrollable Cards Container -->
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
            <VBox style="-fx-background-color: transparent;">
                <padding><Insets top="10" right="40" bottom="50" left="40"/></padding>
                
                <FlowPane fx:id="chambreCardsContainer" hgap="30" vgap="30" alignment="TOP_CENTER"
                          style="-fx-background-color: transparent;"/>
            </VBox>
        </ScrollPane>
    </VBox>
</StackPane>
