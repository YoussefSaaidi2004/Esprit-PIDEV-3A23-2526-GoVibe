<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.ChambreController">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #F5F3E7; -fx-padding: 15;">
            <Label text="Gestion des Chambres"
                   style="-fx-text-fill: #013220; -fx-font-size: 22px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- CENTER TABLE -->
    <center>
        <VBox spacing="15" style="-fx-background-color: #F5F3E7; -fx-padding: 20;">
            <Label text="Liste des Chambres"
                   style="-fx-text-fill: #013220; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <TableView fx:id="chambreTable" prefHeight="400">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="numeroColumn" text="Numéro" prefWidth="100"/>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="100"/>
                    <TableColumn fx:id="capaciteColumn" text="Capacité" prefWidth="80"/>
                    <TableColumn fx:id="equipementsColumn" text="Équipements" prefWidth="150"/>
                    <TableColumn fx:id="hotelIdColumn" text="Hotel ID" prefWidth="80"/>
                    <TableColumn fx:id="prixStandardColumn" text="Prix Standard" prefWidth="100"/>
                </columns>
            </TableView>

            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button text="➕ Ajouter Chambre" style="-fx-background-color: #27AE60; -fx-text-fill: white;"/>
                <Button text="✏️ Modifier" style="-fx-background-color: #2980B9; -fx-text-fill: white;"/>
                <Button text="🗑 Supprimer" style="-fx-background-color: #C0392B; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
