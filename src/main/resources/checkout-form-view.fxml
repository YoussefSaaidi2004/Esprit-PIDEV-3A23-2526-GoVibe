<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.CheckoutFormController"
            stylesheets="@../styles.css"
            styleClass="glass-form-overlay">

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 40;">
            <VBox maxWidth="600" spacing="25" styleClass="glass-pane-premium" style="-fx-padding: 40; -fx-background-color: rgba(255, 255, 255, 0.15);">
                
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <StackPane style="-fx-background-color: rgba(80, 200, 120, 0.2); -fx-background-radius: 12; -fx-padding: 10;">
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10s10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm0-4h-2V7h2v6z" 
                                 styleClass="svg-icon-emerald" scaleX="1.3" scaleY="1.3"/>
                    </StackPane>
                    <VBox>
                        <Text fx:id="formTitle" text="Checkout Information" style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-fill: white;"/>
                        <Text text="Please provide the following details" style="-fx-font-size: 13px; -fx-fill: rgba(255,255,255,0.7);"/>
                    </VBox>
                </HBox>
                
                <Separator style="-fx-opacity: 0.15;"/>
                
                <GridPane vgap="20" hgap="25">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="100.0"/>
                    </columnConstraints>

                        </ComboBox>
                    </VBox>

                    <!-- Row 2 -->
                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Total Price (DT) *" styleClass="label"/>
                        <TextField fx:id="txtTotalPrice" promptText="Total price"/>
                    </VBox>
                    
                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Reservation Date" styleClass="label"/>
                        <TextField fx:id="txtReservationDate" promptText="Auto-generated" editable="false" style="-fx-background-color: #F5F5F5;"/>
                    </VBox>
                </GridPane>
                
                <Separator/>
                
                <HBox spacing="15" alignment="CENTER_RIGHT">
                        <Button fx:id="btnCancel" text="Cancel" styleClass="button, btn-cancel" 
                            onAction="#handleCancel"/>
                        <Button fx:id="btnSave" text="Save" styleClass="button, btn-save" 
                            onAction="#handleSave"/>
                </HBox>
                
            </VBox>
        </VBox>
    </center>

</BorderPane>
