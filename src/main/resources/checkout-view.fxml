<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.gestionvol.controller.CheckoutController"
            stylesheets="@../styles.css">

    <!-- Top Toolbar -->
    <top>
        <HBox styleClass="toolbar" spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Button fx:id="btnAddCheckout" text="➕ Add Checkout" styleClass="button, btn-add" onAction="#handleAddCheckout"/>
            <Button fx:id="btnRefreshCheckout" text="🔄 Refresh" styleClass="button, btn-refresh" onAction="#handleRefresh"/>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="searchField" promptText="🔍 Search checkouts..." prefWidth="250" styleClass="text-field"/>
        </HBox>
    </top>

    <!-- Center: cards scroll pane -->
    <center>
        <StackPane fx:id="checkoutCenterStack" style="-fx-padding: 15px;">
            <ScrollPane fitToWidth="true" styleClass="cards-scroll">
                <content>
                    <FlowPane fx:id="cardsFlow" hgap="20" vgap="20" prefWrapLength="1000" alignment="TOP_CENTER" style="-fx-padding: 20;">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                    </FlowPane>
                </content>
            </ScrollPane>
        </StackPane>
    </center>

</BorderPane>
