<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.SVGPath?>

<HBox alignment="CENTER_LEFT" spacing="0" 
      styleClass="header-glass"
      style="-fx-padding: 0 40 0 40; -fx-pref-height: 80;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.UserHeaderController">
    
    <!-- Logo Section -->
    <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="NEVER">
        <StackPane>
            <Circle radius="28" fill="#50C878" style="-fx-effect: dropshadow(gaussian, rgba(80,200,120,0.4), 8, 0, 0, 2);"/>
            <Label text="G" style="-fx-font-size: 22; -fx-font-weight: 900; -fx-text-fill: #013220;"/>
        </StackPane>
        <VBox spacing="-2" alignment="CENTER_LEFT">
            <Label text="Go" style="-fx-font-size: 24; -fx-font-weight: 900; -fx-text-fill: white;"/>
            <Label text="Vibe" style="-fx-font-size: 24; -fx-font-weight: 300; -fx-text-fill: #50C878;"/>
        </VBox>
        <Region prefWidth="40"/>
        
        <!-- Menu Navigation -->
        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 0 0 30;">
            <!-- Accueil -->
            <Button onAction="#handleHome" styleClass="nav-btn">
                <graphic><SVGPath content="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" fill="rgba(255,255,255,0.85)" scaleX="0.6" scaleY="0.6"/></graphic>
                <text> Accueil</text>
            </Button>
            
            <!-- Activités -->
            <Button onAction="#handleActivities" styleClass="nav-btn">
                <graphic><SVGPath content="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="rgba(255,255,255,0.85)" scaleX="0.55" scaleY="0.55"/></graphic>
                <text> Activités</text>
            </Button>
            
            <!-- Voitures -->
            <Button onAction="#handleLocations" styleClass="nav-btn">
                <graphic><SVGPath content="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z" fill="rgba(255,255,255,0.85)" scaleX="0.55" scaleY="0.55"/></graphic>
                <text> Voitures</text>
            </Button>
            
            <!-- Vols -->
            <Button onAction="#handleFlights" styleClass="nav-btn">
                <graphic><SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" fill="rgba(255,255,255,0.85)" scaleX="0.55" scaleY="0.55"/></graphic>
                <text> Vols</text>
            </Button>
            
            <!-- Hôtels -->
            <Button onAction="#handleChambres" styleClass="nav-btn">
                <graphic><SVGPath content="M7 13c1.66 0 3-1.34 3-3S8.66 7 7 7s-3 1.34-3 3 1.34 3 3 3zm12-6h-8v7H3V5H1v15h2v-3h18v3h2v-9c0-2.21-1.79-4-4-4z" fill="rgba(255,255,255,0.85)" scaleX="0.55" scaleY="0.55"/></graphic>
                <text> Hôtels</text>
            </Button>
            
            <!-- Forums -->
            <Button onAction="#handleForums" styleClass="nav-btn">
                <graphic><SVGPath content="M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1zm-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h10c.55 0 1-.45 1-1z" fill="rgba(255,255,255,0.85)" scaleX="0.55" scaleY="0.55"/></graphic>
                <text> Forums</text>
            </Button>
 
             <!-- Réclamation -->
            <Button onAction="#handleReclamation" styleClass="nav-btn">
                <graphic><SVGPath content="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" fill="rgba(255,255,255,0.85)" scaleX="0.55" scaleY="0.55"/></graphic>
                <text> Réclamation</text>
            </Button>


        </HBox>
    </HBox>
    
    <Region HBox.hgrow="ALWAYS"/>
    
    <!-- Section Droite: Actions & Profil -->
    <HBox alignment="CENTER_RIGHT" spacing="18">
        <!-- Séparateur -->
        <Line startY="0" endY="35" stroke="rgba(255,255,255,0.2)" strokeWidth="1"/>
        
        <!-- Menu Profil -->
        <MenuButton fx:id="profileMenu" 
                    style="-fx-background-color: transparent; -fx-cursor: hand;
                           -fx-padding: 3; -fx-background-radius: 25;">
            <graphic>
                <StackPane>
                    <Circle radius="26" fill="white" 
                            style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 8, 0, 0, 2);"/>
                    <Label fx:id="profileInitials" text="U" 
                           style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #013220;"/>
                    <Circle radius="8" fill="#50C878" translateX="16" translateY="16"
                            style="-fx-effect: dropshadow(gaussian, rgba(80,200,120,0.5), 2, 0, 0, 1);">
                    </Circle>
                </StackPane>
            </graphic>
            
            <items>
                <MenuItem text="Mon Profil" onAction="#handleProfile"/>
                <MenuItem text="Mes Locations" onAction="#handleMyLocations"/>
                <MenuItem text="Mes Vols" onAction="#handleMyFlights"/>
                <SeparatorMenuItem/>
                <MenuItem text="Paramètres" onAction="#handleSettings"/>
                <MenuItem text="Centre d'aide" onAction="#handleHelp"/>
                <SeparatorMenuItem/>
                <MenuItem text="Déconnexion" onAction="#handleLogout" 
                          style="-fx-text-fill: #E74C3C;"/>
            </items>
            
            <tooltip>
                <Tooltip text="Menu utilisateur"/>
            </tooltip>
        </MenuButton>
    </HBox>
</HBox>
