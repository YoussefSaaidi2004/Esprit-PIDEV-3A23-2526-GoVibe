<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.FlightFormController"
            stylesheets="@../styles.css"
            styleClass="glass-form-overlay">

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 40;">
            <VBox maxWidth="650" spacing="25" styleClass="glass-pane-premium" style="-fx-padding: 40; -fx-background-color: rgba(255, 255, 255, 0.15);">
                
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <StackPane style="-fx-background-color: rgba(80, 200, 120, 0.2); -fx-background-radius: 12; -fx-padding: 10;">
                        <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" 
                                 styleClass="svg-icon-emerald" scaleX="1.3" scaleY="1.3"/>
                    </StackPane>
                    <VBox>
                        <Text fx:id="formTitle" text="Add New Flight" style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-fill: white;"/>
                        <Text text="Complete the flight details below" style="-fx-font-size: 13px; -fx-fill: rgba(255,255,255,0.7);"/>
                    </VBox>
                </HBox>
                
                <Separator style="-fx-opacity: 0.15;"/>
                
                <GridPane vgap="20" hgap="25">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0"/>
                    </columnConstraints>

                    <!-- Row 0 -->
                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="FLIGHT ID *" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 10; -fx-letter-spacing: 0.5;"/>
                        <TextField fx:id="txtFlightId" promptText="e.g., GV001" styleClass="form-field" 
                                   style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4);"/>
                    </VBox>
                    
                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="AIRLINE *" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 10;"/>
                        <TextField fx:id="txtAirline" promptText="e.g., Tunisair" styleClass="form-field"
                                   style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4);"/>
                    </VBox>

                    <!-- Row 1 -->
                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="DEPARTURE AIRPORT *" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 10;"/>
                        <TextField fx:id="txtDepartureAirport" promptText="e.g., Tunis" styleClass="form-field"
                                   style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4);"/>
                    </VBox>
                    
                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="DESTINATION *" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 10;"/>
                        <TextField fx:id="txtDestination" promptText="e.g., Paris" styleClass="form-field"
                                   style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4);"/>
                    </VBox>

                    <!-- Row 2 -->
                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="DEPARTURE TIME *" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 10;"/>
                        <TextField fx:id="txtDepartureTime" promptText="HH:MM" styleClass="form-field"
                                   style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4);"/>
                    </VBox>
                    
                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="ARRIVAL TIME *" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 10;"/>
                        <TextField fx:id="txtArrivalTime" promptText="HH:MM" styleClass="form-field"
                                   style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4);"/>
                    </VBox>

                    <!-- Row 3 -->
                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <Label text="CLASS *" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 10;"/>
                        <ComboBox fx:id="cmbClass" maxWidth="Infinity" promptText="Select class" styleClass="form-field"
                                  style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white;">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Economy"/>
                                    <String fx:value="Business"/>
                                    <String fx:value="First Class"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>
                    
                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="3">
                        <Label text="PRICE (DT) *" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 10;"/>
                        <TextField fx:id="txtPrice" promptText="0" styleClass="form-field"
                                   style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4);"/>
                    </VBox>

                    <!-- Row 4 -->
                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="4">
                        <Label text="SEATS *" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 10;"/>
                        <TextField fx:id="txtSeats" promptText="0" styleClass="form-field"
                                   style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4);"/>
                    </VBox>
                </GridPane>

                <VBox spacing="8">
                    <Label text="DESCRIPTION" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 10;"/>
                    <TextArea fx:id="txtDescription" promptText="Flight description..." prefRowCount="3" styleClass="form-field"
                              style="-fx-control-inner-background: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4);"/>
                </VBox>
                
                <Separator style="-fx-opacity: 0.15;"/>
                
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Button fx:id="btnCancel" text="Cancel" styleClass="btn-cancel" 
                            style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-background-radius: 12;"
                            onAction="#handleCancel">
                        <graphic>
                            <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                     styleClass="svg-icon-white" scaleX="0.8" scaleY="0.8"/>
                        </graphic>
                    </Button>
                    <Button fx:id="btnSave" text="Save Flight" styleClass="btn-save" 
                            style="-fx-background-color: #50C878; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-weight: 900;"
                            onAction="#handleSave">
                        <graphic>
                            <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" 
                                     styleClass="svg-icon-white" scaleX="0.8" scaleY="0.8"/>
                        </graphic>
                    </Button>
                </HBox>
                
            </VBox>
        </VBox>
    </center>

</BorderPane>
