<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.gestionvol.controller.admin.FlightListController"
            stylesheets="@../styles.css">

    <!-- Top Toolbar -->
    <top>
        <VBox spacing="15" alignment="CENTER" style="-fx-padding: 20 20 10 20;">
            <HBox spacing="10" alignment="CENTER">
                 <Text text="Find your flight" style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-fill: #013220;"/>
            </HBox>

             <HBox spacing="10" alignment="CENTER">
                 <Button fx:id="btnAddFlight" text="➕" styleClass="button, btn-add" onAction="#handleAddFlight"/>
                 <Button fx:id="btnRefreshFlight" text="🔄" styleClass="button, btn-refresh" onAction="#handleRefresh"/>
            </HBox>
            
            <!-- Advanced Filter Bar -->
            <HBox styleClass="filter-bar" spacing="15" alignment="CENTER" maxWidth="900">
                <TextField fx:id="searchDest" promptText="📍 Destination" prefWidth="200" styleClass="text-field"/>
                <DatePicker fx:id="searchDate" promptText="📅 Date" prefWidth="150" styleClass="date-picker"/>
                <ComboBox fx:id="searchClass" promptText="💺 Class" prefWidth="150" styleClass="combo-box"/>
                <Button text="❌" onAction="#handleClearFilters" styleClass="button, btn-cancel"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center: Cards ScrollPane -->
    <center>
        <StackPane fx:id="flightCenterStack" style="-fx-padding: 15px;">
            <ScrollPane fitToWidth="true" styleClass="cards-scroll">
                <content>
                    <FlowPane fx:id="cardsFlow" hgap="20" vgap="20" prefWrapLength="1000" alignment="TOP_CENTER" style="-fx-padding: 20;">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                    </FlowPane>
                </content>
            </ScrollPane>
        </StackPane>
    </center>

</BorderPane>
