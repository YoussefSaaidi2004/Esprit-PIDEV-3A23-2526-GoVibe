<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.HotelViewController"
      stylesheets="@styles/unified-styles.css, @styles.css">

    <!-- Admin Sidebar -->
    <fx:include source="org/example/AdminSidebar.fxml"/>

    <!-- Main Content -->
    <StackPane fx:id="rootStack" HBox.hgrow="ALWAYS" minWidth="0">
            <!-- Blurred hero background -->
            <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false"/>
            <!-- Dark glassmorphism overlay -->
            <Region style="-fx-background-color: linear-gradient(to bottom right, rgba(0,8,4,0.58) 0%, rgba(1,20,11,0.52) 40%, rgba(1,30,16,0.60) 100%);"/>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox spacing="18" maxWidth="Infinity" style="-fx-padding: 24;">

                <!-- Hero Header -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <StackPane style="-fx-background-color: rgba(80,200,120,0.18); -fx-background-radius: 12; -fx-padding: 10; -fx-effect: dropshadow(gaussian, rgba(80,200,120,0.45), 15, 0, 0, 0);">
                        <Text text="🏨" style="-fx-font-size: 22px;"/>
                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Text text="Hotel Management"
                              style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 10, 0, 0, 1);"/>
                        <Text text="Find, add and manage premium hotel establishments"
                              style="-fx-font-size: 14px; -fx-fill: rgba(180,230,210,0.72);"/>
                    </VBox>
                    <HBox spacing="12" alignment="CENTER">
                        <!-- Sub-nav: Chambres -->
                        <Button onAction="#goToChambres" prefHeight="36"
                                style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1.2; -fx-border-radius: 10; -fx-padding: 8 14; -fx-cursor: hand;">
                            <graphic><Text text="🛏️  Chambres" style="-fx-fill: rgba(220,250,235,0.88); -fx-font-weight: 700; -fx-font-size: 12;"/></graphic>
                        </Button>
                        <!-- Sub-nav: Réservations -->
                        <Button onAction="#goToReservations" prefHeight="36"
                                style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1.2; -fx-border-radius: 10; -fx-padding: 8 14; -fx-cursor: hand;">
                            <graphic><Text text="📅  Réservations" style="-fx-fill: rgba(220,250,235,0.88); -fx-font-weight: 700; -fx-font-size: 12;"/></graphic>
                        </Button>
                        <!-- AI Chatbot -->
                        <Button onAction="#openGlobalChatbot" prefHeight="36"
                                style="-fx-background-color: rgba(80,200,120,0.14); -fx-background-radius: 10; -fx-border-color: rgba(80,200,120,0.42); -fx-border-width: 1.2; -fx-border-radius: 10; -fx-padding: 8 14; -fx-cursor: hand;">
                            <graphic><Text text="🤖  Chatbot IA" style="-fx-fill: #50C878; -fx-font-weight: 700; -fx-font-size: 12;"/></graphic>
                        </Button>
                        <!-- Add Hotel -->
                        <Button onAction="#addHotel" prefHeight="36"
                                style="-fx-background-color: linear-gradient(to bottom right, #50C878, #2e9952); -fx-background-radius: 10; -fx-border-width: 0; -fx-padding: 8 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(80,200,120,0.65), 18, 0, 0, 4);">
                            <graphic>
                                <HBox spacing="6" alignment="CENTER">
                                    <SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" style="-fx-fill: white;" scaleX="0.85" scaleY="0.85"/>
                                    <Text text="CRÉER HÔTEL" style="-fx-fill: white; -fx-font-weight: 900; -fx-font-size: 12;"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                </HBox>

                <!-- Search Bar -->
                <HBox spacing="16" alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(255,255,255,0.07); -fx-background-radius: 14; -fx-border-color: rgba(80,200,120,0.38); -fx-border-width: 1.2; -fx-border-radius: 14; -fx-padding: 2 16 2 4; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.32), 10, 0, 0, 3);">
                    <StackPane style="-fx-padding: 0 2 0 8;">
                        <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                 style="-fx-fill: rgba(80,200,120,0.65);" scaleX="0.8" scaleY="0.8"/>
                    </StackPane>
                    <TextField fx:id="searchField" onKeyReleased="#searchHotels"
                               promptText="Rechercher un hôtel par nom, adresse, ville..." HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: rgba(180,220,200,0.48); -fx-font-size: 13; -fx-border-width: 0; -fx-padding: 12 6;"/>
                </HBox>

                <FlowPane fx:id="hotelCardsContainer" hgap="26" vgap="26" alignment="TOP_LEFT"
                          style="-fx-padding: 8 4 24 4; -fx-background: transparent; -fx-background-color: transparent;"/>

                    </VBox>
                </content>
            </ScrollPane>
    </StackPane>
</HBox>
