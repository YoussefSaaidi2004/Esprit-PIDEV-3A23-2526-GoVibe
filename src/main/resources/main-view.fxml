<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.gestionvol.controller.MainController"
            prefHeight="700.0" prefWidth="1200.0"
            stylesheets="@../styles.css">

    <!-- Header -->
    <top>
        <StackPane>
             <VBox styleClass="header" alignment="CENTER" spacing="10">
                <!-- Brand / Logo Area -->
                <HBox alignment="CENTER" spacing="15">
                    <Text text="✈️" style="-fx-font-size: 48px; -fx-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);"/>
                    <Text text="GoVibe" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 48px; -fx-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 3, 0, 0, 1);"/>
                </HBox>
                
                <!-- Title & Subtitle -->
                <VBox alignment="CENTER" spacing="5">
                    <Text text="FLIGHT MANAGEMENT" styleClass="label-header" style="-fx-font-size: 24px; -fx-font-weight: normal; -fx-letter-spacing: 5px;"/>
                    <Text text="We make your flights easier" styleClass="label-subtitle"/>
                </VBox>
            </VBox>
            
            <!-- Theme Toggle Button (Top Right) -->
            <ToggleButton fx:id="btnTheme" onAction="#handleThemeToggle" 
                    styleClass="theme-switch"
                    StackPane.alignment="TOP_RIGHT">
                <graphic>
                    <Region styleClass="switch-thumb"/>
                </graphic>
                <StackPane.margin>
                    <Insets top="25" right="25"/>
                </StackPane.margin>
            </ToggleButton>
        </StackPane>
    </top>

    <!-- Main Content with Pages -->
    <center>
        <VBox spacing="25" style="-fx-padding: 25px;" alignment="TOP_CENTER">
            <!-- Navigation Buttons -->
            <HBox spacing="40" alignment="CENTER">
                <Button text="✈️ Flights" onAction="#showFlightsPage" styleClass="main-nav-btn"/>
                <Button text="🎫 Checkouts" onAction="#showCheckoutsPage" styleClass="main-nav-btn"/>
            </HBox>

            <!-- Page container -->
            <StackPane fx:id="pageContainer" id="pageContainer" VBox.vgrow="ALWAYS">
                <!-- default page -->
                <fx:include source="flight-list-view.fxml" />
            </StackPane>
        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #F5F5F5; -fx-padding: 10px; -fx-border-width: 1px 0 0 0; -fx-border-color: #E0E0E0;">
            <Text text="© 2026 GoVibe Flight Management System | Powered by JavaFX" 
                  style="-fx-fill: #777; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>

</BorderPane>
