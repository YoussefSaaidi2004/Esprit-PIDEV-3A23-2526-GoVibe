<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.AdminDashboardController"
            stylesheets="@../styles/unified-styles.css, @../styles.css"
            style="-fx-background-color: #010d08;">

    <!-- ==================== LEFT SIDEBAR ==================== -->
    <left>
        <fx:include source="AdminSidebar.fxml" fx:id="adminSidebar"/>
    </left>

    <!-- ==================== MAIN CONTENT ==================== -->
    <center>
        <StackPane fx:id="rootStack">

            <!-- Hero Background -->
            <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false"/>

            <!-- Dark overlay -->
            <Region mouseTransparent="true"
                    style="-fx-background-color: rgba(0,8,4,0.58);"/>

            <!-- Scrollable page content -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox spacing="24">
                        <padding><Insets top="24" right="30" bottom="30" left="30"/></padding>

                        <!-- PAGE HEADER -->
                        <HBox alignment="CENTER_LEFT" spacing="20"
                              style="-fx-background-color: rgba(255,255,255,0.07);
                                     -fx-border-color: rgba(255,255,255,0.12);
                                     -fx-border-width: 1; -fx-background-radius: 16;
                                     -fx-border-radius: 16; -fx-padding: 16 28;">
                            <VBox HBox.hgrow="ALWAYS" spacing="3">
                                <Label text="Dashboard"
                                       style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: 800;"/>
                                <Label text="Vue d ensemble du systeme GoVibe"
                                       style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 13px;"/>
                            </VBox>
                            <HBox alignment="CENTER" spacing="6"
                                  style="-fx-background-color: rgba(80,200,120,0.18);
                                         -fx-border-color: rgba(80,200,120,0.4); -fx-border-width: 1;
                                         -fx-padding: 6 16; -fx-background-radius: 20; -fx-border-radius: 20;">
                                <Region prefWidth="8" prefHeight="8"
                                        style="-fx-background-color: #50C878; -fx-background-radius: 4;"/>
                                <Label text="En ligne"
                                       style="-fx-text-fill: #50C878; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                            </HBox>
                            <Separator orientation="VERTICAL" prefHeight="28"/>
                            <HBox alignment="CENTER" spacing="10" onMouseClicked="#handleGoProfile"
                                  style="-fx-cursor: hand;">
                                <StackPane style="-fx-background-color: #50C878; -fx-background-radius: 22;
                                                  -fx-min-width: 40; -fx-min-height: 40;
                                                  -fx-max-width: 40; -fx-max-height: 40;">
                                    <Label fx:id="profileInitials" text="AD"
                                           style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 700;"/>
                                </StackPane>
                                <VBox alignment="CENTER_LEFT" spacing="2">
                                    <Label fx:id="welcomeLabel" text="Admin"
                                           style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                                    <Label fx:id="roleLabel" text="Administrateur"
                                           style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px;"/>
                                </VBox>
                            </HBox>
                        </HBox>

                        <!-- STAT CARDS ROW -->
                        <HBox spacing="18">
                            <!-- Users -->
                            <VBox HBox.hgrow="ALWAYS" spacing="14" alignment="TOP_LEFT"
                                  style="-fx-background-color: rgba(255,255,255,0.07);
                                         -fx-border-color: rgba(255,255,255,0.12); -fx-border-width: 1;
                                         -fx-background-radius: 16; -fx-border-radius: 16; -fx-padding: 22;">
                                <HBox alignment="CENTER_LEFT" spacing="14">
                                    <StackPane style="-fx-background-color: rgba(80,200,120,0.18);
                                                      -fx-background-radius: 12; -fx-min-width: 48; -fx-min-height: 48;">
                                        <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                                 style="-fx-fill: #50C878;" scaleX="0.9" scaleY="0.9"/>
                                    </StackPane>
                                    <VBox spacing="3">
                                        <Label text="Utilisateurs"
                                               style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 13px;"/>
                                        <Label fx:id="usersCountLabel" text="---"
                                               style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: 800;"/>
                                    </VBox>
                                </HBox>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label text="12% de plus" style="-fx-text-fill: #50C878; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                                    <Label text="vs mois dernier" style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 11px;"/>
                                </HBox>
                            </VBox>
                            <!-- Locations -->
                            <VBox HBox.hgrow="ALWAYS" spacing="14" alignment="TOP_LEFT"
                                  style="-fx-background-color: rgba(255,255,255,0.07);
                                         -fx-border-color: rgba(255,255,255,0.12); -fx-border-width: 1;
                                         -fx-background-radius: 16; -fx-border-radius: 16; -fx-padding: 22;">
                                <HBox alignment="CENTER_LEFT" spacing="14">
                                    <StackPane style="-fx-background-color: rgba(11,100,239,0.2);
                                                      -fx-background-radius: 12; -fx-min-width: 48; -fx-min-height: 48;">
                                        <SVGPath content="M18.92 5.01C18.72 4.42 18.16 4 17.5 4h-11c-.66 0-1.21.42-1.42 1.01L3 11v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 15c-.83 0-1.5-.67-1.5-1.5S5.67 12 6.5 12s1.5.67 1.5 1.5S7.33 15 6.5 15zm11 0c-.83 0-1.5-.67-1.5-1.5S16.67 12 17.5 12s1.5.67 1.5 1.5S18.33 15 17.5 15zM5 10l1.5-4.5h11L19 10H5z"
                                                 style="-fx-fill: #5B9DF4;" scaleX="0.9" scaleY="0.9"/>
                                    </StackPane>
                                    <VBox spacing="3">
                                        <Label text="Locations"
                                               style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 13px;"/>
                                        <Label fx:id="locationsCountLabel" text="---"
                                               style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: 800;"/>
                                    </VBox>
                                </HBox>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label text="8% de plus" style="-fx-text-fill: #50C878; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                                    <Label text="vs mois dernier" style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 11px;"/>
                                </HBox>
                            </VBox>
                            <!-- Hotels -->
                            <VBox HBox.hgrow="ALWAYS" spacing="14" alignment="TOP_LEFT"
                                  style="-fx-background-color: rgba(255,255,255,0.07);
                                         -fx-border-color: rgba(255,255,255,0.12); -fx-border-width: 1;
                                         -fx-background-radius: 16; -fx-border-radius: 16; -fx-padding: 22;">
                                <HBox alignment="CENTER_LEFT" spacing="14">
                                    <StackPane style="-fx-background-color: rgba(231,126,34,0.2);
                                                      -fx-background-radius: 12; -fx-min-width: 48; -fx-min-height: 48;">
                                        <SVGPath content="M7 13.5c.83 0 1.5-.67 1.5-1.5 0-.83-.67-1.5-1.5-1.5S5.5 11.17 5.5 12c0 .83.67 1.5 1.5 1.5zm0 3.5c.83 0 1.5-.67 1.5-1.5S7.83 14 7 14s-1.5.67-1.5 1.5S6.17 17 7 17zm0 3.5c.83 0 1.5-.67 1.5-1.5S7.83 17.5 7 17.5s-1.5.67-1.5 1.5S6.17 20.5 7 20.5zM19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z"
                                                 style="-fx-fill: #E8954A;" scaleX="0.9" scaleY="0.9"/>
                                    </StackPane>
                                    <VBox spacing="3">
                                        <Label text="Hotels" style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 13px;"/>
                                        <Label fx:id="hotelsCountLabel" text="---"
                                               style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: 800;"/>
                                    </VBox>
                                </HBox>
                                <Label text="Stable" style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 12px;"/>
                            </VBox>
                            <!-- Revenue -->
                            <VBox HBox.hgrow="ALWAYS" spacing="14" alignment="TOP_LEFT"
                                  style="-fx-background-color: rgba(255,255,255,0.07);
                                         -fx-border-color: rgba(80,200,120,0.3); -fx-border-width: 1;
                                         -fx-background-radius: 16; -fx-border-radius: 16; -fx-padding: 22;">
                                <HBox alignment="CENTER_LEFT" spacing="14">
                                    <StackPane style="-fx-background-color: rgba(80,200,120,0.25);
                                                      -fx-background-radius: 12; -fx-min-width: 48; -fx-min-height: 48;">
                                        <SVGPath content="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"
                                                 style="-fx-fill: #50C878;" scaleX="0.9" scaleY="0.9"/>
                                    </StackPane>
                                    <VBox spacing="3">
                                        <Label text="Revenus" style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 13px;"/>
                                        <Label fx:id="revenueLabel" text="---"
                                               style="-fx-text-fill: #50C878; -fx-font-size: 26px; -fx-font-weight: 800;"/>
                                    </VBox>
                                </HBox>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label text="24% de plus" style="-fx-text-fill: #50C878; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                                    <Label text="vs mois dernier" style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 11px;"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- ACTIONS RAPIDES -->
                        <VBox spacing="16"
                              style="-fx-background-color: rgba(255,255,255,0.07);
                                     -fx-border-color: rgba(255,255,255,0.12); -fx-border-width: 1;
                                     -fx-background-radius: 16; -fx-border-radius: 16; -fx-padding: 24;">
                            <Label text="Actions rapides"
                                   style="-fx-text-fill: white; -fx-font-size: 17px; -fx-font-weight: 700;"/>
                            <FlowPane hgap="12" vgap="12">
                                <Button text="+ Nouvelle personne" onAction="#handlePersonnes"
                                        style="-fx-background-color: #013220; -fx-text-fill: white; -fx-font-size: 13px;
                                               -fx-font-weight: 600; -fx-padding: 10 22; -fx-background-radius: 10;
                                               -fx-border-color: rgba(80,200,120,0.35); -fx-border-width: 1;
                                               -fx-border-radius: 10; -fx-cursor: hand;"/>
                                <Button text="+ Nouvelle voiture" onAction="#handleVoitures"
                                        style="-fx-background-color: #50C878; -fx-text-fill: white; -fx-font-size: 13px;
                                               -fx-font-weight: 600; -fx-padding: 10 22; -fx-background-radius: 10; -fx-cursor: hand;"/>
                                <Button text="+ Nouveau vol" onAction="#handleFlights"
                                        style="-fx-background-color: #E67E22; -fx-text-fill: white; -fx-font-size: 13px;
                                               -fx-font-weight: 600; -fx-padding: 10 22; -fx-background-radius: 10; -fx-cursor: hand;"/>
                                <Button text="+ Nouvel hotel" onAction="#handleHotels"
                                        style="-fx-background-color: #084E36; -fx-text-fill: white; -fx-font-size: 13px;
                                               -fx-font-weight: 600; -fx-padding: 10 22; -fx-background-radius: 10;
                                               -fx-border-color: rgba(80,200,120,0.35); -fx-border-width: 1;
                                               -fx-border-radius: 10; -fx-cursor: hand;"/>
                                <Button text="+ Nouvelle activite" onAction="#handleActivites"
                                        style="-fx-background-color: #7D3C98; -fx-text-fill: white; -fx-font-size: 13px;
                                               -fx-font-weight: 600; -fx-padding: 10 22; -fx-background-radius: 10; -fx-cursor: hand;"/>
                                <Button text="Voir les forums" onAction="#handleForums"
                                        style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: white;
                                               -fx-font-size: 13px; -fx-font-weight: 600; -fx-padding: 10 22;
                                               -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.25);
                                               -fx-border-width: 1; -fx-border-radius: 10; -fx-cursor: hand;"/>
                            </FlowPane>
                        </VBox>

                        <!-- BOTTOM ROW -->
                        <HBox spacing="18">
                            <!-- Recent Activity -->
                            <VBox HBox.hgrow="ALWAYS" spacing="16"
                                  style="-fx-background-color: rgba(255,255,255,0.07);
                                         -fx-border-color: rgba(255,255,255,0.12); -fx-border-width: 1;
                                         -fx-background-radius: 16; -fx-border-radius: 16; -fx-padding: 24;">
                                <Label text="Activite recente"
                                       style="-fx-text-fill: white; -fx-font-size: 17px; -fx-font-weight: 700;"/>
                                <VBox spacing="14">
                                    <HBox spacing="14" alignment="CENTER_LEFT">
                                        <StackPane style="-fx-background-color: rgba(80,200,120,0.18); -fx-background-radius: 10;
                                                          -fx-min-width: 36; -fx-min-height: 36;">
                                            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                                                     style="-fx-fill: #50C878;" scaleX="0.7" scaleY="0.7"/>
                                        </StackPane>
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label text="Nouvelle location creee"
                                                   style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 500;"/>
                                            <Label text="Il y a 5 minutes"
                                                   style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11px;"/>
                                        </VBox>
                                    </HBox>
                                    <HBox spacing="14" alignment="CENTER_LEFT">
                                        <StackPane style="-fx-background-color: rgba(91,157,244,0.18); -fx-background-radius: 10;
                                                          -fx-min-width: 36; -fx-min-height: 36;">
                                            <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                                     style="-fx-fill: #5B9DF4;" scaleX="0.7" scaleY="0.7"/>
                                        </StackPane>
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label text="Nouvel utilisateur inscrit"
                                                   style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 500;"/>
                                            <Label text="Il y a 12 minutes"
                                                   style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11px;"/>
                                        </VBox>
                                    </HBox>
                                    <HBox spacing="14" alignment="CENTER_LEFT">
                                        <StackPane style="-fx-background-color: rgba(232,149,74,0.18); -fx-background-radius: 10;
                                                          -fx-min-width: 36; -fx-min-height: 36;">
                                            <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z"
                                                     style="-fx-fill: #E8954A;" scaleX="0.7" scaleY="0.7"/>
                                        </StackPane>
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label text="Nouvelle reservation hotel"
                                                   style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 500;"/>
                                            <Label text="Il y a 25 minutes"
                                                   style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11px;"/>
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </VBox>
                            <!-- System Status -->
                            <VBox prefWidth="280" spacing="16"
                                  style="-fx-background-color: rgba(255,255,255,0.07);
                                         -fx-border-color: rgba(255,255,255,0.12); -fx-border-width: 1;
                                         -fx-background-radius: 16; -fx-border-radius: 16; -fx-padding: 24;">
                                <Label text="Etat du systeme"
                                       style="-fx-text-fill: white; -fx-font-size: 17px; -fx-font-weight: 700;"/>
                                <VBox spacing="12">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Region prefWidth="9" prefHeight="9" style="-fx-background-color: #50C878; -fx-background-radius: 5;"/>
                                        <Label text="Base de donnees" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 13px;" HBox.hgrow="ALWAYS"/>
                                        <Label text="OK" style="-fx-text-fill: #50C878; -fx-font-size: 12px; -fx-font-weight: 700;"/>
                                    </HBox>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Region prefWidth="9" prefHeight="9" style="-fx-background-color: #50C878; -fx-background-radius: 5;"/>
                                        <Label text="API" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 13px;" HBox.hgrow="ALWAYS"/>
                                        <Label text="OK" style="-fx-text-fill: #50C878; -fx-font-size: 12px; -fx-font-weight: 700;"/>
                                    </HBox>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Region prefWidth="9" prefHeight="9" style="-fx-background-color: #50C878; -fx-background-radius: 5;"/>
                                        <Label text="Services" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 13px;" HBox.hgrow="ALWAYS"/>
                                        <Label text="OK" style="-fx-text-fill: #50C878; -fx-font-size: 12px; -fx-font-weight: 700;"/>
                                    </HBox>
                                    <Separator style="-fx-background-color: rgba(255,255,255,0.15); -fx-padding: 4 0;"/>
                                    <Label text="Version: 1.0.0" style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 11px;"/>
                                    <Label text="Derniere mise a jour: 15/02/2026" style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 11px;"/>
                                </VBox>
                            </VBox>
                        </HBox>

                    </VBox>
                </content>
            </ScrollPane>

        </StackPane>
    </center>

</BorderPane>
