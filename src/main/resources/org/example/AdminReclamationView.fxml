<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.AdminReclamationController"
      stylesheets="@styles/unified-styles.css, @admin-reclamation.css">

    <!-- Sidebar -->
    <fx:include source="AdminSidebar.fxml" fx:id="adminSidebar"/>

    <!-- Main Content -->
    <StackPane fx:id="rootStackPane" HBox.hgrow="ALWAYS" minWidth="0">

            <!-- Hero Background -->
            <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" styleClass="premium-bg"/>
            <Pane styleClass="premium-bg-overlay" mouseTransparent="true"/>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox spacing="0" style="-fx-background-color: transparent;">

                <!-- Glass Hero Header -->
                <HBox alignment="CENTER_LEFT" spacing="15"
                      style="-fx-background-color: rgba(1,50,32,0.82); -fx-padding: 16 24;
                             -fx-border-color: rgba(80,200,120,0.18); -fx-border-width: 0 0 1 0;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 8, 0, 0, 2);">

                    <StackPane style="-fx-background-color: rgba(80,200,120,0.18); -fx-background-radius: 10; -fx-padding: 10;">
                        <Label text="📋" style="-fx-font-size: 20;"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label text="Gestion des Réclamations"
                               style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 800;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 4, 0, 0, 1);"/>
                        <Label text="Gérez les réclamations des utilisateurs"
                               style="-fx-text-fill: #A0E0C9; -fx-font-size: 10px;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Stats tiles -->
                    <HBox spacing="14" alignment="CENTER">
                        <VBox alignment="CENTER" spacing="2"
                               style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10;
                                      -fx-border-color: rgba(80,200,120,0.2); -fx-border-radius: 10;
                                      -fx-padding: 6 14;">
                            <Label fx:id="lblTotal" text="0"
                                   style="-fx-text-fill: #50C878; -fx-font-size: 20px; -fx-font-weight: 800;"/>
                            <Label text="Total" style="-fx-text-fill: #A0E0C9; -fx-font-size: 9px; -fx-font-weight: 700;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="2"
                               style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10;
                                      -fx-border-color: rgba(243,156,18,0.3); -fx-border-radius: 10;
                                      -fx-padding: 6 14;">
                            <Label fx:id="lblEnAttente" text="0"
                                   style="-fx-text-fill: #f39c12; -fx-font-size: 20px; -fx-font-weight: 800;"/>
                            <Label text="En attente" style="-fx-text-fill: #A0E0C9; -fx-font-size: 9px; -fx-font-weight: 700;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="2"
                               style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10;
                                      -fx-border-color: rgba(39,174,96,0.3); -fx-border-radius: 10;
                                      -fx-padding: 6 14;">
                            <Label fx:id="lblResolu" text="0"
                                   style="-fx-text-fill: #27ae60; -fx-font-size: 20px; -fx-font-weight: 800;"/>
                            <Label text="Résolus" style="-fx-text-fill: #A0E0C9; -fx-font-size: 9px; -fx-font-weight: 700;"/>
                        </VBox>
                    </HBox>
                </HBox>

                <!-- Filters & Search -->
                <HBox spacing="14" alignment="CENTER_LEFT"
                      style="-fx-padding: 10 24; -fx-background-color: rgba(255,255,255,0.76);
                             -fx-border-color: rgba(1,50,32,0.1); -fx-border-width: 0 0 1 0;">

                    <TextField fx:id="txtSearch" promptText="🔍 Rechercher par nom, sujet..."
                               style="-fx-background-color: white; -fx-border-color: #d4e8dc; -fx-border-radius: 16;
                                      -fx-background-radius: 16; -fx-padding: 7 14; -fx-font-size: 12px; -fx-pref-width: 250;"/>

                    <ComboBox fx:id="comboStatus" promptText="Tous"
                               style="-fx-background-color: white; -fx-border-color: #d4e8dc; -fx-border-radius: 16;
                                      -fx-background-radius: 16; -fx-padding: 2 4; -fx-font-size: 12px;"/>
 
                    <ComboBox fx:id="comboSort" promptText="Plus récent"
                               style="-fx-background-color: white; -fx-border-color: #d4e8dc; -fx-border-radius: 16;
                                      -fx-background-radius: 16; -fx-padding: 2 4; -fx-font-size: 12px;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button onAction="#handleRefresh" text="🔄 Actualiser"
                            style="-fx-background-color: #013220; -fx-border-radius: 16; -fx-background-radius: 16;
                                   -fx-text-fill: white; -fx-font-weight: 600; -fx-padding: 7 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
                </HBox>

                        <VBox fx:id="reclamationsContainer" spacing="14"
                              style="-fx-padding: 22 30; -fx-background-color: transparent;">

                            <!-- Empty State -->
                            <VBox fx:id="emptyState" alignment="CENTER" spacing="18" visible="false"
                                  style="-fx-padding: 80 20;">
                                <Circle radius="56" fill="rgba(80,200,120,0.12)"/>
                                <Label text="📭" style="-fx-font-size: 44;"/>
                                <Label text="Aucune réclamation trouvée"
                                       style="-fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: 700;
                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 6, 0, 0, 1);"/>
                                <Label text="Les réclamations des utilisateurs apparaîtront ici"
                                       style="-fx-font-size: 13px; -fx-text-fill: #A0E0C9;"/>
                            </VBox>
                        </VBox>

                    </VBox>
                </content>
            </ScrollPane>
    </StackPane>

</HBox>
