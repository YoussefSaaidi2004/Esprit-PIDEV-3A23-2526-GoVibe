<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.AdminReclamationController"
            stylesheets="@admin-reclamation.css"
            style="-fx-background-color: #F5F3E7;">

    <!-- Sidebar -->
    <left>
        <fx:include source="AdminSidebar.fxml"/>
    </left>

    <!-- Main Content -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #F5F3E7;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #013220; -fx-padding: 25 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);">
                <Label text="📋" style="-fx-font-size: 28;"/>
                <VBox spacing="2">
                    <Label text="Gestion des Réclamations" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: 700;"/>
                    <Label text="Gérez les réclamations des utilisateurs" style="-fx-text-fill: #A0E0C9; -fx-font-size: 13px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Stats -->
                <HBox spacing="25" alignment="CENTER">
                    <VBox alignment="CENTER" spacing="3">
                        <Label fx:id="lblTotal" text="0" style="-fx-text-fill: #50C878; -fx-font-size: 28px; -fx-font-weight: 700;"/>
                        <Label text="Total" style="-fx-text-fill: #A0E0C9; -fx-font-size: 11px;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="3">
                        <Label fx:id="lblEnAttente" text="0" style="-fx-text-fill: #f39c12; -fx-font-size: 28px; -fx-font-weight: 700;"/>
                        <Label text="En attente" style="-fx-text-fill: #A0E0C9; -fx-font-size: 11px;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="3">
                        <Label fx:id="lblResolu" text="0" style="-fx-text-fill: #27ae60; -fx-font-size: 28px; -fx-font-weight: 700;"/>
                        <Label text="Résolus" style="-fx-text-fill: #A0E0C9; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- Filters & Search -->
            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 20 30; -fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <TextField fx:id="txtSearch" promptText="🔍 Rechercher par nom, sujet..." 
                          style="-fx-background-color: #f8f9fa; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-padding: 10 15; -fx-font-size: 14px; -fx-pref-width: 300;"/>
                
                <ComboBox fx:id="comboStatus" promptText="Tous les statuts" 
                         style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-padding: 5;"/>
                
                <ComboBox fx:id="comboSort" promptText="Plus récent" 
                         style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-padding: 5;"/>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                <Button onAction="#handleRefresh" text="🔄 Actualiser" 
                       style="-fx-background-color: transparent; -fx-border-color: #013220; -fx-border-radius: 8; -fx-text-fill: #013220; -fx-font-weight: 600; -fx-padding: 10 20; -fx-cursor: hand;"/>
            </HBox>

            <!-- Reclamations Cards Container -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" 
                       style="-fx-background-color: #F5F3E7; -fx-padding: 0;">
                <content>
                    <VBox fx:id="reclamationsContainer" spacing="15" style="-fx-padding: 25 30; -fx-background-color: #F5F3E7;">
                        <!-- Cards will be added dynamically -->
                        
                        <!-- Empty State -->
                        <VBox fx:id="emptyState" alignment="CENTER" spacing="20" visible="false" 
                              style="-fx-padding: 80 20;">
                            <Circle radius="60" fill="#E8F8F5"/>
                            <Label text="📭" style="-fx-font-size: 48;"/>
                            <Label text="Aucune réclamation trouvée" 
                                   style="-fx-font-size: 18px; -fx-text-fill: #666; -fx-font-weight: 600;"/>
                            <Label text="Les réclamations des utilisateurs apparaîtront ici" 
                                   style="-fx-font-size: 13px; -fx-text-fill: #999;"/>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
