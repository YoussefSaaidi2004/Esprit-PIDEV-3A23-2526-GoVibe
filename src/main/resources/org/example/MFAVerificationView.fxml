<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<!-- MFA Verification Screen — Glassmorphism design matching LoginView -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controllers.MFAVerificationController"
           stylesheets="@styles.css"
           styleClass="auth-bg">

    <!-- Dark overlay for contrast -->
    <Pane styleClass="auth-overlay" />

    <!-- Glassmorphism card -->
    <VBox alignment="CENTER" spacing="18.0" maxWidth="440.0" maxHeight="580.0"
          styleClass="auth-container">

        <VBox alignment="CENTER" spacing="8">
            <ImageView fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@images/logo.png"/>
                </image>
            </ImageView>
            <Text text="GoVibe" styleClass="title-text"/>
            <Label text="Vérification de sécurité" styleClass="subtitle-text"/>
        </VBox>

        <!-- Risk level indicator -->
        <VBox alignment="CENTER" spacing="4" style="-fx-padding: 8 16; -fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 8;">
            <HBox alignment="CENTER" spacing="8">
                <Label text="Niveau de risque :" styleClass="label-text" style="-fx-text-fill: rgba(255,255,255,0.7);"/>
                <Label fx:id="lblRiskLevel" text="HIGH" style="-fx-text-fill: #ffaa00; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            </HBox>
            <Label fx:id="lblRiskDescription" text="" wrapText="true"
                   style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11px;" alignment="CENTER"/>
        </VBox>

        <VBox spacing="14" maxWidth="340">
            <!-- Info message -->
            <Label fx:id="lblMessage" text="" visible="false" wrapText="true"
                   style="-fx-text-fill: #50C878; -fx-font-size: 12px; -fx-padding: 8; -fx-background-color: rgba(80,200,120,0.1); -fx-background-radius: 6;"
                   alignment="CENTER" maxWidth="Infinity"/>

            <!-- OTP Input -->
            <VBox spacing="5">
                <Label text="Code OTP" styleClass="label-text"/>
                <TextField fx:id="tfOtp" promptText="Entrez le code à 6 chiffres" styleClass="text-field"
                           style="-fx-font-size: 18px; -fx-alignment: center; -fx-letter-spacing: 4px;"
                           maxWidth="Infinity"/>
            </VBox>

            <!-- Verify Button -->
            <Button fx:id="btnVerify" text="🔐  Vérifier" onAction="#handleVerifyOTP"
                    maxWidth="Infinity" styleClass="btn-primary"/>

            <!-- Progress indicator -->
            <HBox alignment="CENTER">
                <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="24" prefHeight="24"/>
            </HBox>

            <!-- Resend + Back links -->
            <HBox alignment="CENTER" spacing="16">
                <Hyperlink fx:id="linkResend" text="Renvoyer le code" onAction="#handleResendOTP" styleClass="link-text"/>
            </HBox>

            <HBox alignment="CENTER">
                <Hyperlink text="← Retour à la connexion" onAction="#handleBackToLogin" styleClass="link-text"/>
            </HBox>
        </VBox>

    </VBox>
</StackPane>
