<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane fx:id="mainStack" prefHeight="940.0" prefWidth="1440.0"
           stylesheets="@../../styles/unified-styles.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controllers.MapActivitiesController">

    <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" styleClass="premium-bg"/>
    <Pane styleClass="premium-bg-overlay"/>

    <VBox fx:id="root" spacing="0" style="-fx-background-color: transparent;">
        <StackPane styleClass="header-glass">
            <fx:include source="../../components/UserHeader.fxml"/>
        </StackPane>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <content>
                <VBox spacing="0" style="-fx-background-color: transparent;">

                    <!-- HERO BANNER -->
                    <HBox alignment="CENTER_LEFT" spacing="30"
                          style="-fx-padding: 32 50 28 50; -fx-background-color: rgba(1,18,10,0.55);">
                        <VBox spacing="6">
                            <HBox spacing="14" alignment="CENTER_LEFT">
                                <StackPane>
                                    <Circle radius="32" fill="rgba(80,200,120,0.25)"
                                            style="-fx-effect: dropshadow(gaussian,rgba(80,200,120,0.35),10,0,0,0);"/>
                                    <Label text="&#x1F3AF;" style="-fx-font-size: 28;"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Label text="Activites GoVibe"
                                           style="-fx-font-size: 30; -fx-font-weight: 900; -fx-text-fill: white;
                                                  -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.5),6,0,0,2);"/>
                                    <Label text="Decouvrez et proposez des experiences uniques"
                                           style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 14;"/>
                                </VBox>
                            </HBox>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox spacing="18" alignment="CENTER">
                            <VBox alignment="CENTER" spacing="3"
                                  style="-fx-background-color: rgba(255,255,255,0.07); -fx-background-radius: 14;
                                         -fx-border-color: rgba(80,200,120,0.2); -fx-border-radius: 14; -fx-padding: 10 20;">
                                <Label fx:id="activityCountLabel" text="0"
                                       style="-fx-font-size: 26; -fx-font-weight: 900; -fx-text-fill: #50C878;"/>
                                <Label text="ACTIVITES"
                                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 10; -fx-letter-spacing: 2;"/>
                            </VBox>
                            <Button fx:id="proposeBtn" onAction="#openProposePopup"
                                    style="-fx-background-color: linear-gradient(to right,#50C878,#3DAF62);
                                           -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 13;
                                           -fx-padding: 13 28; -fx-background-radius: 26; -fx-cursor: hand;
                                           -fx-effect: dropshadow(gaussian,rgba(80,200,120,0.55),16,0,0,5);"
                                    text="+ Proposer une activite">
                                <tooltip><Tooltip text="Proposer une nouvelle activite a la communaute"/></tooltip>
                            </Button>
                        </HBox>
                    </HBox>

                    <!-- DB ACTIVITIES GRID -->
                    <VBox spacing="0" style="-fx-padding: 28 50 36 50; -fx-background-color: rgba(1,12,6,0.35);">
                        <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 0 0 18 0;">
                            <Label text="NOS ACTIVITES"
                                   style="-fx-font-size: 11; -fx-font-weight: 900; -fx-text-fill: #50C878; -fx-letter-spacing: 3;"/>
                            <Region prefWidth="1" prefHeight="20" style="-fx-background-color: rgba(80,200,120,0.3);"/>
                            <Label fx:id="activitySubtitle" text="Chargement..."
                                   style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="activitySearchField" prefWidth="230"
                                       promptText="Filtrer les activites..."
                                       style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: white;
                                              -fx-prompt-text-fill: rgba(255,255,255,0.4); -fx-background-radius: 22;
                                              -fx-padding: 9 16; -fx-border-color: rgba(80,200,120,0.25);
                                              -fx-border-radius: 22; -fx-border-width: 1; -fx-font-size: 13;"/>
                        </HBox>
                        <TilePane fx:id="dbActivitiesPane" hgap="22" vgap="22" prefColumns="3"
                                  alignment="TOP_LEFT" style="-fx-background-color: transparent;"/>
                        <VBox fx:id="emptyActivities" alignment="CENTER" spacing="18"
                              managed="false" visible="false"
                              style="-fx-padding: 60 40; -fx-background-color: rgba(255,255,255,0.04);
                                     -fx-background-radius: 20; -fx-border-color: rgba(80,200,120,0.15);
                                     -fx-border-radius: 20; -fx-border-width: 1;">
                            <Label text="&#x1F3AF;" style="-fx-font-size: 52;"/>
                            <Label text="Aucune activite disponible pour le moment"
                                   style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 17; -fx-font-weight: 700;"/>
                            <Button onAction="#openProposePopup" text="+ Proposer la premiere activite"
                                    style="-fx-background-color: rgba(80,200,120,0.15); -fx-text-fill: #50C878;
                                           -fx-font-weight: 700; -fx-padding: 12 28; -fx-background-radius: 22;
                                           -fx-cursor: hand; -fx-border-color: rgba(80,200,120,0.35);
                                           -fx-border-radius: 22; -fx-border-width: 1;"/>
                        </VBox>
                        <HBox fx:id="activitiesLoading" alignment="CENTER" spacing="15"
                              style="-fx-padding: 40;" managed="false" visible="false">
                            <ProgressIndicator prefWidth="32" prefHeight="32"
                                               style="-fx-progress-color: #50C878;"/>
                            <Label text="Chargement des activites..."
                                   style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 14;"/>
                        </HBox>
                    </VBox>

                    <!-- MAP SECTION HEADER -->
                    <HBox alignment="CENTER_LEFT" spacing="16"
                          style="-fx-padding: 16 50 12 50; -fx-background-color: rgba(1,10,5,0.5);
                                 -fx-border-color: rgba(80,200,120,0.15) transparent transparent transparent;
                                 -fx-border-width: 1;">
                        <Label text="&#x1F5FA;&#xFE0F;" style="-fx-font-size: 20;"/>
                        <Label text="Explorer le Monde"
                               style="-fx-font-size: 18; -fx-font-weight: 900; -fx-text-fill: white;"/>
                        <Label text="." style="-fx-text-fill: rgba(255,255,255,0.3); -fx-font-size: 18;"/>
                        <Label text="Cliquez sur un pays pour ses attractions"
                               style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <TextField fx:id="searchField" prefWidth="250"
                                       promptText="Rechercher une destination..."
                                       styleClass="map-search-field-premium"/>
                            <Button onAction="#handleSearch" styleClass="icon-btn-success">
                                <graphic>
                                    <SVGPath content="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="white"/>
                                </graphic>
                            </Button>
                        </HBox>
                    </HBox>

                    <!-- MAP + SIDE PANEL -->
                    <SplitPane dividerPositions="0.65" styleClass="map-split-pane"
                               style="-fx-background-color: transparent; -fx-pref-height: 560; -fx-min-height: 460;">
                        <items>
                            <AnchorPane style="-fx-background-color: transparent;">
                                <WebView fx:id="mapWebView"
                                         AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                                         AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
                            </AnchorPane>
                            <VBox fx:id="sidePanel" spacing="0" styleClass="glass-panel">
                                <padding><Insets bottom="20" left="10" right="10" top="20"/></padding>
                                <ScrollPane fitToWidth="true" styleClass="transparent-scroll" VBox.vgrow="ALWAYS">
                                    <content>
                                        <StackPane>
                                            <VBox fx:id="detailsVBox" spacing="28" style="-fx-padding: 26;">
                                                <VBox fx:id="emptyState" alignment="CENTER" spacing="20" styleClass="ocean-state-container">
                                                    <SVGPath content="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                                                fill="rgba(80,200,120,0.4)" scaleX="4" scaleY="4"/>
                                                    <Label fx:id="emptyTitle" text="Explorez le monde"
                                                           style="-fx-font-size: 26; -fx-font-weight: 900; -fx-text-fill: white;"/>
                                                    <Label fx:id="emptySubtitle"
                                                           text="Cliquez sur la carte pour decouvrir les activites d'un pays."
                                                           style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13;"
                                                           textAlignment="CENTER" wrapText="true"/>
                                                </VBox>
                                                <VBox fx:id="countryContent" managed="false" spacing="22" visible="false">
                                                    <HBox alignment="CENTER_LEFT" spacing="18">
                                                        <ImageView fx:id="countryFlag" fitHeight="52" preserveRatio="true">
                                                            <effect><javafx.scene.effect.DropShadow color="rgba(0,0,0,0.5)" radius="10"/></effect>
                                                        </ImageView>
                                                        <VBox>
                                                            <Label fx:id="countryName" style="-fx-font-size: 26; -fx-font-weight: 900; -fx-text-fill: white;"/>
                                                            <Label fx:id="countryRegion" style="-fx-text-fill: #50C878; -fx-font-weight: 800; -fx-font-size: 12;"/>
                                                        </VBox>
                                                    </HBox>
                                                    <GridPane hgap="12" vgap="12" styleClass="premium-info-grid">
                                                        <columnConstraints>
                                                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="50"/>
                                                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="50"/>
                                                        </columnConstraints>
                                                        <children>
                                                            <VBox styleClass="glass-tile" GridPane.columnIndex="0">
                                                                <Label styleClass="tile-label" text="CAPITALE"/>
                                                                <Label fx:id="capitalLabel" styleClass="tile-value" text="-"/>
                                                            </VBox>
                                                            <VBox styleClass="glass-tile" GridPane.columnIndex="1">
                                                                <Label styleClass="tile-label" text="POPULATION"/>
                                                                <Label fx:id="populationLabel" styleClass="tile-value" text="-"/>
                                                            </VBox>
                                                            <VBox styleClass="glass-tile" GridPane.rowIndex="1" GridPane.columnIndex="0">
                                                                <Label styleClass="tile-label" text="MONNAIE"/>
                                                                <Label fx:id="currencyLabel" styleClass="tile-value" text="-"/>
                                                            </VBox>
                                                            <VBox styleClass="glass-tile" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                                                <Label styleClass="tile-label" text="LANGUES"/>
                                                                <Label fx:id="languageLabel" styleClass="tile-value" text="-"/>
                                                            </VBox>
                                                        </children>
                                                    </GridPane>
                                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                                        <Label style="-fx-font-size: 11; -fx-font-weight: 900; -fx-text-fill: #50C878; -fx-letter-spacing: 2;" text="EXPERIENCES IMMERSIVES"/>
                                                        <Region HBox.hgrow="ALWAYS"/>
                                                        <Button fx:id="aiInsightsBtn" onAction="#handleAskAI" styleClass="btn-ai-mini-premium" text="Conseils IA"/>
                                                    </HBox>
                                                    <VBox fx:id="attractionsContainer" spacing="14"/>
                                                </VBox>
                                            </VBox>
                                            <VBox fx:id="loadingOverlay" alignment="CENTER" spacing="20" visible="false"
                                                  style="-fx-background-color: rgba(1,46,32,0.75); -fx-background-radius: 20;">
                                                <ProgressIndicator prefHeight="55.0" prefWidth="55.0"/>
                                                <Label style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;" text="Exploration en cours..."/>
                                            </VBox>
                                            <VBox fx:id="errorOverlay" alignment="CENTER" spacing="16" visible="false"
                                                  style="-fx-background-color: rgba(1,46,32,0.9); -fx-background-radius: 20;">
                                                <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" fill="#E74C3C" scaleX="3" scaleY="3"/>
                                                <Label fx:id="errorMessage" style="-fx-text-fill: white; -fx-font-weight: bold;" textAlignment="CENTER" wrapText="true"/>
                                                <Button onAction="#handleRetry" styleClass="btn-retry" text="Reessayer"/>
                                            </VBox>
                                        </StackPane>
                                    </content>
                                </ScrollPane>
                            </VBox>
                        </items>
                    </SplitPane>

                    <Pane prefHeight="30" style="-fx-background-color: transparent;"/>
                </VBox>
            </content>
        </ScrollPane>
    </VBox>

    <!-- PROPOSE ACTIVITY MODAL OVERLAY -->
    <StackPane fx:id="modalOverlay" visible="false" managed="false"
               style="-fx-background-color: rgba(0,0,0,0.72);">
        <Pane onMouseClicked="#closeProposePopup" style="-fx-background-color: transparent;" mouseTransparent="false"/>
        <VBox fx:id="popupCard" alignment="TOP_CENTER" spacing="0"
              maxWidth="580" minWidth="460"
              onMouseClicked="#consumePopupClick"
              style="-fx-background-color: rgba(4,20,12,0.96);
                     -fx-background-radius: 24; -fx-border-color: rgba(80,200,120,0.35);
                     -fx-border-radius: 24; -fx-border-width: 1;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.7),40,0,0,10);
                     -fx-padding: 0;">
            <HBox alignment="CENTER_LEFT" spacing="14"
                  style="-fx-padding: 22 28 18 28;
                         -fx-background-color: linear-gradient(to right,rgba(80,200,120,0.18),rgba(61,175,98,0.06));
                         -fx-background-radius: 24 24 0 0;
                         -fx-border-color: transparent transparent rgba(80,200,120,0.2) transparent;
                         -fx-border-width: 0 0 1 0;">
                <StackPane>
                    <Circle radius="22" fill="rgba(80,200,120,0.2)"/>
                    <Label text="+" style="-fx-font-size: 20; -fx-font-weight: 900; -fx-text-fill: #50C878;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="Proposer une activite"
                           style="-fx-font-size: 18; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    <Label text="Soumise pour validation par un administrateur"
                           style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 11;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#closeProposePopup" text="x"
                        style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: rgba(255,255,255,0.7);
                               -fx-font-size: 14; -fx-font-weight: 700; -fx-background-radius: 50%;
                               -fx-padding: 5 10; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 50%; -fx-border-width: 1;"/>
            </HBox>
            <VBox spacing="15" style="-fx-padding: 24 28 28 28;">
                <VBox spacing="6">
                    <Label text="NOM DE L'ACTIVITE"
                           style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: #50C878; -fx-letter-spacing: 2;"/>
                    <TextField fx:id="popupName" promptText="Ex: Visite des ruines de Carthage..."
                               style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: white;
                                      -fx-prompt-text-fill: rgba(255,255,255,0.3); -fx-background-radius: 12;
                                      -fx-padding: 11 16; -fx-border-color: rgba(80,200,120,0.2);
                                      -fx-border-radius: 12; -fx-border-width: 1; -fx-font-size: 14;"/>
                </VBox>
                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="TYPE"
                               style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: #50C878; -fx-letter-spacing: 2;"/>
                        <TextField fx:id="popupType" promptText="Culture, Sport, Gastronomie..."
                                   style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: white;
                                          -fx-prompt-text-fill: rgba(255,255,255,0.3); -fx-background-radius: 12;
                                          -fx-padding: 11 16; -fx-border-color: rgba(80,200,120,0.2);
                                          -fx-border-radius: 12; -fx-border-width: 1; -fx-font-size: 14;"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="PRIX (DT)"
                               style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: #50C878; -fx-letter-spacing: 2;"/>
                        <TextField fx:id="popupPrix" promptText="0.00" prefWidth="120"
                                   style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: white;
                                          -fx-prompt-text-fill: rgba(255,255,255,0.3); -fx-background-radius: 12;
                                          -fx-padding: 11 16; -fx-border-color: rgba(80,200,120,0.2);
                                          -fx-border-radius: 12; -fx-border-width: 1; -fx-font-size: 14;"/>
                    </VBox>
                </HBox>
                <VBox spacing="6">
                    <Label text="LOCALISATION"
                           style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: #50C878; -fx-letter-spacing: 2;"/>
                    <ComboBox fx:id="popupLocCombo" promptText="Choisir une localisation..."
                              maxWidth="1.7976931348623157E308"
                              style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: white;
                                     -fx-background-radius: 12; -fx-border-color: rgba(80,200,120,0.2);
                                     -fx-border-radius: 12; -fx-border-width: 1; -fx-font-size: 13; -fx-padding: 4;"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="DESCRIPTION"
                           style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: #50C878; -fx-letter-spacing: 2;"/>
                    <TextArea fx:id="popupDesc" prefRowCount="3" wrapText="true"
                              promptText="Decrivez l'activite, ce que les participants vivront..."
                              style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: white;
                                     -fx-prompt-text-fill: rgba(255,255,255,0.3); -fx-background-radius: 12;
                                     -fx-padding: 10 14; -fx-border-color: rgba(80,200,120,0.2);
                                     -fx-border-radius: 12; -fx-border-width: 1; -fx-font-size: 13;
                                     -fx-control-inner-background: rgba(4,20,12,0.6);"/>
                </VBox>
                <Label fx:id="popupFeedback" text="" wrapText="true"
                       style="-fx-font-size: 12; -fx-text-fill: #E74C3C;" managed="false" visible="false"/>
                <HBox spacing="14" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
                    <Button onAction="#closeProposePopup" text="Annuler"
                            style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: rgba(255,255,255,0.75);
                                   -fx-font-size: 13; -fx-font-weight: 600; -fx-padding: 11 26;
                                   -fx-background-radius: 20; -fx-cursor: hand;
                                   -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 20; -fx-border-width: 1;"/>
                    <Button fx:id="submitPopupBtn" onAction="#submitProposalPopup"
                            text="Envoyer la proposition"
                            style="-fx-background-color: linear-gradient(to right,#50C878,#3DAF62);
                                   -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;
                                   -fx-padding: 11 26; -fx-background-radius: 20; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian,rgba(80,200,120,0.5),12,0,0,3);"/>
                </HBox>
            </VBox>
        </VBox>
    </StackPane>

</StackPane>
