<?xml version="1.0" encoding="UTF-8"?>
 
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>
 
<VBox fx:id="rootStack" prefHeight="900.0" prefWidth="1400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.UserHomeController">
    <stylesheets>
        <URL value="@../../styles.css" />
    </stylesheets>

    <!-- ==================== FIXED TOP HEADER ==================== -->
    <fx:include source="../../components/UserHeader.fxml"/>
    
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="transparent-scroll" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
        <content>
            <VBox spacing="0">
                
                <!-- HERO SECTION -->
                <StackPane fx:id="heroBanner" alignment="CENTER" minHeight="700.0" prefHeight="700.0" styleClass="hero-banner" style="-fx-background-color: #012E20;">
                   
                   <!-- Immersive Background Image (Animated in Controller) -->
                   <ImageView fx:id="heroImage" fitHeight="700.0" managed="false" preserveRatio="false" />
                   
                   <!-- Cinematic Overlay -->
                   <Region styleClass="dark-overlay-immersive" />
                   <Region styleClass="vignette-overlay" />

                   <!-- Hero Content -->
                   <VBox alignment="CENTER" spacing="40.0" style="-fx-padding: 60 20;">
                        
                        <!-- Premium Badge -->
                        <HBox alignment="CENTER" fillHeight="false">
                            <Label fx:id="heroBadge" style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 40; -fx-text-fill: white; -fx-padding: 12 30; -fx-font-size: 14; -fx-font-weight: 800; -fx-letter-spacing: 1; -fx-border-color: rgba(255,255,255,0.25); -fx-border-radius: 40;">
                                <graphic>
                                    <SVGPath content="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#50C878" scaleX="0.7" scaleY="0.7"/>
                                </graphic>
                                <text> EXPÉRIENCES D'EXCEPTION</text>
                            </Label>
                        </HBox>

                        <!-- Main Title -->
                        <VBox fx:id="heroTitleBox" alignment="CENTER" spacing="5">
                            <Label styleClass="hero-title" text="Visez l'aventure," />
                            <Label styleClass="hero-title" style="-fx-text-fill: #50C878;" text="explorez le monde" />
                        </VBox>

                        <!-- Subtitle -->
                        <Label fx:id="heroSubtitle" styleClass="hero-subtitle" maxWidth="800" text="Réservez des expériences authentiques avec des guides locaux, artisans et experts passionnés" textAlignment="CENTER" wrapText="true" />

                        <!-- Premium Search Bar -->
                        <HBox fx:id="heroSearchBox" alignment="CENTER" maxWidth="1000" styleClass="glass-panel-heavy" style="-fx-padding: 10;">
                            
                            <!-- Search Input -->
                            <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS" style="-fx-padding: 0 30;">
                                <SVGPath content="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="#50C878" scaleX="1.1" scaleY="1.1"/>
                                <TextField fx:id="searchField" promptText="Où allez-vous ?" style="-fx-background-color: transparent; -fx-font-size: 18; -fx-prompt-text-fill: #999; -fx-pref-width: 300;" />
                            </HBox>
                            
                            <Separator orientation="VERTICAL" style="-fx-padding: 15 0; -fx-opacity: 0.1;" />
                            
                            <!-- Date Picker -->
                            <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS" style="-fx-padding: 0 30;">
                                <SVGPath content="M19 3h-1V1h-2v2H8V1H6v3H5c-1.11 0-1.99.9-1.99 2L3 19a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z" fill="#50C878" scaleX="1.1" scaleY="1.1"/>
                                <DatePicker fx:id="datePicker" promptText="Quand ?" style="-fx-background-color: transparent; -fx-font-size: 16; -fx-border-color: transparent;" />
                            </HBox>
 
                            <!-- Search Button -->
                            <Button onAction="#handleSearch" text="RECHERCHER" styleClass="btn-search" style="-fx-padding: 18 55;" />
                        </HBox>

                   </VBox>
                </StackPane>

                <!-- STATS BAR - TRUST BADGES -->
                <HBox alignment="CENTER" spacing="100.0" style="-fx-background-color: #012E20; -fx-padding: 70 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 30, 0, 0, -10);">
                    <VBox alignment="CENTER" spacing="10">
                        <StackPane styleClass="trust-badge-circle">
                             <Label styleClass="stat-value" text="150+" />
                        </StackPane>
                        <Label styleClass="stat-label" text="Destinations" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="10">
                        <StackPane styleClass="trust-badge-circle">
                             <Label styleClass="stat-value" text="2K+" />
                        </StackPane>
                        <Label styleClass="stat-label" text="Expériences" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="10">
                        <StackPane styleClass="trust-badge-circle">
                             <Label styleClass="stat-value" text="50K+" />
                        </StackPane>
                        <Label styleClass="stat-label" text="Aventuriers" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="10">
                        <StackPane styleClass="trust-badge-circle">
                            <HBox alignment="CENTER" spacing="8">
                                <Label styleClass="stat-value" text="4.9" />
                                <SVGPath content="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#F1C40F" scaleX="1.3" scaleY="1.3"/>
                            </HBox>
                        </StackPane>
                        <Label styleClass="stat-label" text="Satisfaction" />
                    </VBox>
                </HBox>

                <!-- POPULAR CATEGORIES -->
                <VBox spacing="40.0" style="-fx-padding: 80 80;">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: #013220;" text="Explorer par catégorie" />
                            <Label style="-fx-font-size: 16; -fx-text-fill: #666;" text="Trouvez l'inspiration pour votre prochain voyage" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleViewAllCategories" style="-fx-background-color: transparent; -fx-text-fill: #50C878; -fx-font-size: 16; -fx-font-weight: bold; -fx-cursor: hand;">
                            <graphic>
                                <HBox alignment="CENTER" spacing="5">
                                    <Label text="Voir tout" style="-fx-text-fill: #50C878; -fx-font-size: 16; -fx-font-weight: bold;"/>
                                    <SVGPath content="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z" fill="#50C878" scaleX="0.8" scaleY="0.8"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                    
                    <HBox alignment="CENTER" spacing="40.0">
                        <!-- Aventure -->
                        <VBox alignment="CENTER" spacing="25" styleClass="category-orb" prefWidth="240" prefHeight="280" onMouseClicked="#handleActivities">
                            <StackPane>
                                <Circle fill="#E8F8F5" radius="55.0" />
                                <SVGPath content="M14 6l-3.75 5 2.85 3.8-1.6 1.2C9.81 13.75 7 10 7 10l-6 8h22L14 6z" fill="#2E8B57" scaleX="1.8" scaleY="1.8"/>
                            </StackPane>
                            <Label style="-fx-font-size: 20; -fx-font-weight: 800;" text="Aventure" />
                        </VBox>
                        <!-- Culture -->
                        <VBox alignment="CENTER" spacing="25" styleClass="category-orb" prefWidth="240" prefHeight="280" onMouseClicked="#handleActivities">
                            <StackPane>
                                <Circle fill="#FDEBD0" radius="55.0" />
                                <SVGPath content="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72z" fill="#E67E22" scaleX="1.8" scaleY="1.8"/>
                            </StackPane>
                            <Label style="-fx-font-size: 20; -fx-font-weight: 800;" text="Culture" />
                        </VBox>
                        <!-- Gastronomie -->
                        <VBox alignment="CENTER" spacing="25" styleClass="category-orb" prefWidth="240" prefHeight="280" onMouseClicked="#handleActivities">
                            <StackPane>
                                <Circle fill="#EBDEF0" radius="55.0" />
                                <SVGPath content="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z" fill="#8E44AD" scaleX="1.8" scaleY="1.8"/>
                            </StackPane>
                            <Label style="-fx-font-size: 20; -fx-font-weight: 800;" text="Gastronomie" />
                        </VBox>
                        <!-- Bien-être -->
                        <VBox alignment="CENTER" spacing="25" styleClass="category-orb" prefWidth="240" prefHeight="280" onMouseClicked="#handleActivities">
                            <StackPane>
                                <Circle fill="#EBF5FB" radius="55.0" />
                                <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="#2980B9" scaleX="1.8" scaleY="1.8"/>
                            </StackPane>
                            <Label style="-fx-font-size: 20; -fx-font-weight: 800;" text="Bien-être" />
                        </VBox>
                        <!-- Sport -->
                        <VBox alignment="CENTER" spacing="25" styleClass="category-orb" prefWidth="240" prefHeight="280" onMouseClicked="#handleActivities">
                            <StackPane>
                                <Circle fill="#FDEDEC" radius="55.0" />
                                <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 3.3l1.35-.95c1.82.56 3.37 1.76 4.38 3.34l-.39 1.34-1.35.46L13 7.5V5.3zm-3.35-.95L11 5.3V7.5L7.01 9.49l-1.35-.46-.39-1.34c1.01-1.58 2.56-2.78 4.38-3.34zM7.08 17.11l-1.14.1C4.73 15.81 4 13.99 4 12c0-.12.01-.23.02-.35l1-.73 1.38.48 1.46 4.34-.78 1.37zm7.42 2.48c-.79.26-1.63.41-2.5.41s-1.71-.15-2.5-.41l-.69-1.49.64-1.1h5.11l.64 1.11-.7 1.48zM14.27 15H9.73l-1.35-4.02L12 8.97l3.62 2.01L14.27 15zm3.79 2.21l-1.14-.1-.78-1.37 1.46-4.34 1.38-.48 1 .73c.01.12.02.23.02.35 0 1.99-.73 3.81-1.94 5.21z" fill="#E74C3C" scaleX="1.8" scaleY="1.8"/>
                            </StackPane>
                            <Label style="-fx-font-size: 20; -fx-font-weight: 800;" text="Sport" />
                        </VBox>
                    </HBox>
                </VBox>
                
                <!-- POPULAR ACTIVITIES GRID -->
                <VBox spacing="40.0" style="-fx-padding: 0 80 100 80;">
                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: #013220;" text="Activités du moment" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="15">
                            <Button onAction="#handlePrevActivities" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 12; -fx-background-radius: 50; -fx-cursor: hand;">
                                <graphic>
                                    <SVGPath content="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" fill="#013220" scaleX="1.1" scaleY="1.1"/>
                                </graphic>
                            </Button>
                            <Button onAction="#handleNextActivities" style="-fx-background-color: #50C878; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(80,200,120,0.4), 15, 0, 0, 5); -fx-padding: 12; -fx-background-radius: 50; -fx-cursor: hand;">
                                <graphic>
                                    <SVGPath content="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z" fill="white" scaleX="1.1" scaleY="1.1"/>
                                </graphic>
                            </Button>
                        </HBox>
                    </HBox>
                    
                    <TilePane fx:id="activitiesPane" alignment="CENTER" hgap="35.0" vgap="35.0" style="-fx-background-color: transparent;" prefColumns="3" />
                </VBox>

                <!-- FOOTER -->
                <VBox alignment="CENTER" spacing="30.0" style="-fx-background-color: #002211; -fx-padding: 80 0;">
                    <HBox alignment="CENTER" spacing="12">
                        <Circle radius="25" fill="#50C878" opacity="0.1"/>
                        <Label style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: white;" text="Go" />
                        <Label style="-fx-font-size: 32; -fx-font-weight: 300; -fx-text-fill: #50C878;" text="Vibe" />
                    </HBox>
                    <Label style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 14;" text="© 2024 GoVibe - Expériences authentiques à travers le monde" />
                    <HBox alignment="CENTER" spacing="30">
                        <Hyperlink text="À propos" style="-fx-text-fill: rgba(255,255,255,0.7);" />
                        <Hyperlink text="Confidentialité" style="-fx-text-fill: rgba(255,255,255,0.7);" />
                        <Hyperlink text="Contact" style="-fx-text-fill: rgba(255,255,255,0.7);" />
                    </HBox>
                </VBox>

            </VBox>
        </content>
    </ScrollPane>
</VBox>
