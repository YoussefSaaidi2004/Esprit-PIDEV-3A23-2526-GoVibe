<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.effect.DropShadow?>

<?import javafx.scene.control.Separator?>
<StackPane fx:id="rootStackPane" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.DetailsForumController">

    <!-- Premium Image Background (Can be light) -->
    <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" styleClass="premium-bg" />
    
    <!-- Neutral Overlay for readability if needed -->
    <Region styleClass="premium-bg-overlay" mouseTransparent="true" />

    <BorderPane fx:id="mainBorderPane" style="-fx-background-color: transparent;" prefHeight="900" prefWidth="1400">

        <!-- ==================== TOP HEADER (User) ==================== -->
        <top>
            <StackPane fx:id="userHeaderStack" styleClass="header-glass">
                <fx:include source="../components/UserHeader.fxml"/>
            </StackPane>
        </top>

        <!-- ==================== LEFT SIDEBAR (Admin) ==================== -->
        <left>
            <StackPane fx:id="adminSidebarStack" managed="false" visible="false">
                <fx:include source="../org/example/AdminSidebar.fxml" fx:id="adminSidebar"/>
            </StackPane>
        </left>

        <!-- Main Content Area -->
        <center>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox alignment="TOP_CENTER" spacing="30" style="-fx-background-color: transparent; -fx-padding: 0 0 50 0;">
                    
                    <!-- Hero/Cover Section -->
                    <StackPane alignment="BOTTOM_LEFT" maxWidth="1100" prefHeight="300.0" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 0);">
                        <ImageView fx:id="coverImage" fitHeight="300.0" fitWidth="1100.0" preserveRatio="false" style="-fx-opacity: 0.9; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 5);" />
                        
                        <!-- Gradient Overlay for Readability -->
                        <Region style="-fx-background-color: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.1) 100%);" />
                        
                        <!-- Forum Info Overlay (Glass Panel) -->
                        <VBox spacing="10" styleClass="glass-panel" style="-fx-padding: 30; -fx-background-color: rgba(255, 255, 255, 0.15); -fx-background-radius: 15; -fx-border-radius: 15;" StackPane.alignment="BOTTOM_LEFT">
                            <StackPane.margin>
                                <Insets bottom="20" left="20" right="20"/>
                            </StackPane.margin>
                            <Label fx:id="forumNameLabel" style="-fx-text-fill: white; -fx-font-size: 38px; -fx-font-weight: 900; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 5, 0, 0, 2);" text="Nom du Forum" />
                            <Label fx:id="forumDescriptionLabel" maxWidth="800" text="Description du forum..." wrapText="true" style="-fx-text-fill: #F0F0F0; -fx-font-size: 16px; -fx-font-weight: 500; -fx-line-spacing: 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 3, 0, 0, 1);" />
                            
                            <HBox spacing="15" style="-fx-padding: 15 0 0 0;" alignment="CENTER_LEFT">
                                <Label style="-fx-text-fill: #50C878; -fx-font-size: 12; -fx-font-weight: 800;
                                  -fx-background-color: rgba(80,200,120,0.2); -fx-padding: 5 14;
                                  -fx-background-radius: 20; -fx-letter-spacing: 1;" text="✦ Communauté GoVibe" />
                                <Label fx:id="creatorLabel" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 5 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0, 0, 1);" text="Créé par Admin" />
                            </HBox>
                        </VBox>
                        
                    </StackPane>

                    <!-- Content Container (Centered Limited Width) -->
                    <VBox maxWidth="1100" spacing="25" style="-fx-padding: 0 20;">
                        
                        <!-- Actions Bar -->
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="5" style="-fx-padding: 0 0 10 0;">
                                <Label style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: 900;
                                              -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.4),6,0,0,2);" text="💬  Discussions" />
                                <Region style="-fx-background-color: linear-gradient(to right,#50C878,transparent); -fx-min-height: 3; -fx-pref-width: 80; -fx-background-radius: 2;" />
                            </VBox>
                            
                            <Region HBox.hgrow="ALWAYS" />
                            
                             <HBox alignment="CENTER_RIGHT" spacing="10">
                                 <Button fx:id="joinButton" managed="false" onAction="#handleJoinRequest" style="-fx-background-color: linear-gradient(to right, #50C878, #3DAF62); -fx-text-fill: white; -fx-font-weight: 800; -fx-border-radius: 20; -fx-padding: 9 22; -fx-background-radius: 20; -fx-cursor: hand;" text="🤝  Rejoindre le forum" visible="false" />
                                 <Label fx:id="pendingLabel" managed="false" style="-fx-text-fill: #FBC02D; -fx-font-weight: 800; -fx-background-color: rgba(251,192,45,0.15); -fx-padding: 9 22; -fx-background-radius: 20;" text="⏳  Demande en attente" visible="false" />
                                 <Button fx:id="leaveButton" onAction="#handleLeaveForum" style="-fx-background-color: transparent; -fx-text-fill: #ff4d4d; -fx-font-weight: bold; -fx-border-color: #ff4d4d; -fx-border-radius: 20; -fx-padding: 5 15; -fx-cursor: hand;" text="Quitter le forum" visible="false" managed="false" />
                                <Button text="📰  Toutes les publications" onAction="#handleGoToPosts"
                                        style="-fx-background-color: rgba(80,200,120,0.15); -fx-text-fill: #50C878;
                                               -fx-border-color: rgba(80,200,120,0.4); -fx-border-radius: 20;
                                               -fx-font-size: 13; -fx-font-weight: 800; -fx-padding: 9 22;
                                               -fx-background-radius: 20; -fx-cursor: hand; -fx-border-width: 1;"/>
                                <Button onAction="#handleAjoutPost" style="-fx-background-color: transparent; -fx-cursor: hand;">
                                    <graphic>
                                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@images/add.png" />
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                            </HBox>
                        </HBox>

                        <HBox alignment="TOP_CENTER" spacing="25">
                            <!-- Posts Feed (Left) -->
                            <VBox fx:id="postsContainer" spacing="20" HBox.hgrow="ALWAYS" maxWidth="750">
                                <!-- Posts will be loaded here dynamically -->
                            </VBox>

                            <!-- Members Sidebar (Right) -->
                            <VBox minWidth="300" maxWidth="300" spacing="15"
                                  style="-fx-padding: 20; -fx-background-color: rgba(4,20,12,0.92);
                                         -fx-background-radius: 18; -fx-border-color: rgba(80,200,120,0.28);
                                         -fx-border-radius: 18; -fx-border-width: 1;
                                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.5),20,0,0,6);">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="👥  Membres" style="-fx-font-size: 14; -fx-font-weight: 900; -fx-text-fill: white; -fx-letter-spacing: 1;" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="membersCountLabel"
                                           style="-fx-background-color: rgba(80,200,120,0.2); -fx-text-fill: #50C878;
                                                  -fx-font-size: 12; -fx-font-weight: 900; -fx-padding: 3 12;
                                                  -fx-background-radius: 14;"
                                           text="0" />
                                </HBox>
                                <Region style="-fx-min-height: 1; -fx-background-color: rgba(80,200,120,0.18);" />
                                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" prefHeight="400">
                                    <content>
                                        <VBox fx:id="membersContainer" spacing="10" style="-fx-background-color: transparent;">
                                            <!-- Members will be loaded here -->
                                        </VBox>
                                    </content>
                                </ScrollPane>
                                
                                <!-- Creator Controls (Add Member) -->
                                <VBox fx:id="creatorControls" managed="false" visible="false" spacing="10"
                                      style="-fx-border-color: rgba(80,200,120,0.2); -fx-border-width: 1 0 0 0; -fx-padding: 15 0 0 0;">
                                    <Label text="Ajouter un membre" style="-fx-font-size: 13; -fx-font-weight: 800; -fx-text-fill: rgba(255,255,255,0.85);" />
                                    <javafx.scene.control.TextField fx:id="memberEmailField" promptText="Email du membre..."
                                          style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: white;
                                                 -fx-prompt-text-fill: rgba(255,255,255,0.3); -fx-background-radius: 10;
                                                 -fx-padding: 10; -fx-border-color: rgba(80,200,120,0.25);
                                                 -fx-border-radius: 10; -fx-border-width: 1;" />
                                    <Button onAction="#handleAddMember" text="+ Ajouter" maxWidth="Infinity"
                                           style="-fx-background-color: linear-gradient(to right,#50C878,#3DAF62);
                                                  -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 10;
                                                  -fx-padding: 10; -fx-cursor: hand;
                                                  -fx-effect: dropshadow(gaussian,rgba(80,200,120,0.4),10,0,0,3);"/>
                                </VBox>
                                
                                <!-- Join Requests section -->
                                <VBox fx:id="requestsBox" managed="false" spacing="10" style="-fx-border-color: rgba(251,192,45,0.2); -fx-border-width: 1 0 0 0; -fx-padding: 15 0 0 0;" visible="false">
                                    <Label style="-fx-font-size: 13; -fx-font-weight: 800; -fx-text-fill: #FBC02D;" text="Demandes d'adhésion" />
                                    <VBox fx:id="requestsContainer" spacing="8" />
                                </VBox>
                            </VBox>
                        </HBox>
                        
                        <!-- Footer / End of List -->
                        <HBox alignment="CENTER" style="-fx-padding: 20;">
                            <Label style="-fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 13;" text="✓  Vous avez vu toutes les publications" />
                        </HBox>
                        
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    </BorderPane>

    <!-- Modal Form Overlay -->
    <StackPane fx:id="formOverlay" managed="false" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false">
        <VBox fx:id="formContainer" alignment="CENTER" maxHeight="700" maxWidth="800" style="-fx-background-color: transparent;">
            <!-- Modal forms injected here -->
        </VBox>
    </StackPane>

</StackPane>
