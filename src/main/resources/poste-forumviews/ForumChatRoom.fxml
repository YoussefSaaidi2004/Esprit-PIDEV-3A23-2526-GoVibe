<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<!--
  VOYA – GoVibe AI Chat Room
  World places chat with Gemini AI and emotion-aware personality
-->

<StackPane fx:id="rootStack"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controllers.ForumChatRoomController"
           stylesheets="@../styles.css"
           style="-fx-background-color: #011c14;">

    <!-- Background image -->
    <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" styleClass="premium-bg"/>
    <Pane styleClass="premium-bg-overlay" mouseTransparent="true"/>

    <BorderPane style="-fx-background-color: transparent;" prefHeight="900" prefWidth="1400">

        <!-- ═══ CHAT HEADER ═══ -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="18" styleClass="chat-header">
                <padding><Insets top="14" bottom="14" left="24" right="24"/></padding>

                <!-- Back button -->
                <Button onAction="#handleBack" styleClass="chat-back-btn">
                    <graphic>
                        <SVGPath styleClass="chat-back-svg"
                                 content="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
                                 scaleX="0.9" scaleY="0.9"/>
                    </graphic>
                </Button>

                <!-- Voya avatar -->
                <StackPane styleClass="voya-avatar">
                    <Label text="🌍" style="-fx-font-size: 26;"/>
                    <!-- Online dot -->
                    <StackPane StackPane.alignment="BOTTOM_RIGHT">
                        <Circle radius="5" style="-fx-fill: #50C878; -fx-stroke: #011c14; -fx-stroke-width: 2;"/>
                    </StackPane>
                </StackPane>

                <VBox spacing="2">
                    <Label text="Voya" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 18;"/>
                    <Label fx:id="statusLabel" text="● En ligne — Guide de voyage IA"
                           style="-fx-text-fill: #50C878; -fx-font-size: 11;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="🌏 Explorez le monde avec Voya"
                       style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 12;"/>
            </HBox>
        </top>

        <!-- ═══ CHAT BODY ═══ -->
        <center>
            <VBox style="-fx-background-color: transparent;">
                <!-- Messages scroll area -->
                <ScrollPane fx:id="chatScrollPane" fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                    <content>
                        <VBox fx:id="messagesContainer" spacing="16"
                              style="-fx-background-color: transparent; -fx-padding: 24 40 16 40;"/>
                    </content>
                </ScrollPane>

                <!-- Typing indicator (hidden by default) -->
                <HBox fx:id="typingIndicator" visible="false" managed="false"
                      alignment="CENTER_LEFT" spacing="10"
                      style="-fx-padding: 0 40 8 40;">
                    <StackPane styleClass="voya-avatar-tiny">
                        <Label text="🌍" style="-fx-font-size: 14;"/>
                    </StackPane>
                    <HBox alignment="CENTER" spacing="5" styleClass="chat-bubble-ai"
                          style="-fx-padding: 12 18;">
                        <Label fx:id="dot1" text="●" styleClass="typing-dot"/>
                        <Label fx:id="dot2" text="●" styleClass="typing-dot"/>
                        <Label fx:id="dot3" text="●" styleClass="typing-dot"/>
                    </HBox>
                </HBox>

                <!-- Suggested topics (shown at start) -->
                <VBox fx:id="suggestionsPanel" spacing="10"
                      style="-fx-padding: 0 40 12 40; -fx-background-color: transparent;">
                    <Label text="✨ Suggestions de destinations"
                           style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 12; -fx-font-weight: 600;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="🗼 Paris" onAction="#handleSuggestion" styleClass="suggestion-chip"/>
                        <Button text="🗻 Japon" onAction="#handleSuggestion" styleClass="suggestion-chip"/>
                        <Button text="🏜 Sahara" onAction="#handleSuggestion" styleClass="suggestion-chip"/>
                        <Button text="🏔 Machu Picchu" onAction="#handleSuggestion" styleClass="suggestion-chip"/>
                        <Button text="🏝 Maldives" onAction="#handleSuggestion" styleClass="suggestion-chip"/>
                        <Button text="🌋 Islande" onAction="#handleSuggestion" styleClass="suggestion-chip"/>
                    </HBox>
                </VBox>
            </VBox>
        </center>

        <!-- ═══ INPUT BAR ═══ -->
        <bottom>
            <HBox alignment="CENTER" spacing="14" styleClass="chat-input-bar">
                <padding><Insets top="16" bottom="16" left="40" right="40"/></padding>

                <TextField fx:id="inputField"
                           promptText="Parlez de Paris, Tokyo, Sahara... Voya vous guide! 🌍"
                           styleClass="chat-input-field"
                           onAction="#handleSend"
                           HBox.hgrow="ALWAYS"/>

                <Button fx:id="sendButton" onAction="#handleSend" styleClass="chat-send-btn">
                    <graphic>
                        <SVGPath styleClass="chat-send-svg"
                                 content="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                                 scaleX="0.95" scaleY="0.95"/>
                    </graphic>
                </Button>

            </HBox>
        </bottom>

    </BorderPane>
</StackPane>
