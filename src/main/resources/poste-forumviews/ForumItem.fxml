<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="800.0" spacing="0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ForumItemController">
    <padding><Insets bottom="20" left="0" right="0" top="0" /></padding>
    <HBox alignment="CENTER_LEFT" spacing="18" styleClass="forum-card" style="-fx-background-color: rgba(255,255,255,0.85); -fx-background-radius: 18px; -fx-effect: dropshadow(gaussian, rgba(80,200,120,0.15), 20, 0, 0, 5);">
        <padding><Insets bottom="15" left="25" right="25" top="20" /></padding>
        <!-- Avatar/Profile -->
        <VBox alignment="CENTER" styleClass="avatar">
            <ImageView fx:id="forumImageView" fitHeight="48" fitWidth="48" pickOnBounds="true" preserveRatio="true" styleClass="avatar-image">
                <image><Image url="@images/logo.png" /></image>
            </ImageView>
        </VBox>
        <!-- Main Content -->
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="nameLabel" style="-fx-text-fill: #013220; -fx-font-size: 20px; -fx-font-weight: bold;" text="Nom du Forum" />
                <Label fx:id="privateBadge" style="-fx-background-color: rgba(231,76,60,0.1); -fx-text-fill: #e74c3c; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 2 8; -fx-background-radius: 10;" text="PRIVÉ" visible="false" />
            </HBox>
            <Label fx:id="descriptionLabel" style="-fx-text-fill: #555; -fx-font-size: 15px; -fx-font-weight: 400;" text="Description du forum..." wrapText="true" />
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 5 0 0 0;">
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-text-fill: #50C878; -fx-font-weight: bold;" text="👥" />
                    <Label fx:id="membersLabel" style="-fx-text-fill: #50C878; -fx-font-size: 13px;" text="0 Membres" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-text-fill: #50C878; -fx-font-weight: bold;" text="📝" />
                    <Label fx:id="postsLabel" style="-fx-text-fill: #50C878; -fx-font-size: 13px;" text="0 Publications" />
                </HBox>
                <Label style="-fx-text-fill: #A0E0C9;" text="•" />
                <Label fx:id="creatorLabel" style="-fx-text-fill: #084E36; -fx-font-size: 12px; -fx-font-weight: bold;" text="Par Admin" />
                <Label style="-fx-text-fill: #A0E0C9;" text="•" />
                <Label fx:id="dateLabel" style="-fx-text-fill: #A0E0C9; -fx-font-size: 12px;" text="Créé le 01/01/2024" />
            </HBox>
        </VBox>
        <!-- Actions -->
        <VBox alignment="CENTER_RIGHT" spacing="10">
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="leaveButton" onAction="#handleLeaveForum" styleClass="leave-btn" text="Quitter" visible="false" managed="false" />
                <Button onAction="#handleViewDetails" styleClass="button-primary action-btn" text="Voir" />
                <Button fx:id="editButton" onAction="#handleEditForum" styleClass="icon-btn">
                    <graphic>
                        <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/write.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="deleteButton" onAction="#handleDeleteForum" styleClass="icon-btn">
                    <graphic>
                        <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/delete.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </HBox>
</VBox>
