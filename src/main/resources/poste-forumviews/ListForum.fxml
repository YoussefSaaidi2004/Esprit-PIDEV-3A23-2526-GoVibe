<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<!-- 
  PAGE FORUMS PROFESSIONNELLE
  Design moderne avec navigation commune et gestion des forums
-->

<StackPane fx:id="rootStackPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controllers.ListForumController" stylesheets="../styles.css">
    <!-- Premium Image Background -->
    <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" styleClass="premium-bg" />
    
    <BorderPane fx:id="mainBorderPane" style="-fx-background-color: transparent;"
                prefHeight="900" prefWidth="1400" styleClass="glass-pane">

    <!-- ==================== TOP HEADER (Commun) ==================== -->
    <top>
        <fx:include source="../components/UserHeader.fxml"/>
    </top>

    <!-- ==================== CONTENU CENTRAL ==================== -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;"
                    VBox.vgrow="ALWAYS" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="0" style="-fx-background-color: transparent;">
                    
                    <!-- Header Section -->
                    <VBox spacing="8" styleClass="page-header" >
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <StackPane styleClass="header-icon">
                                <Circle radius="35" />
                                <Label text="💬" />
                            </StackPane>
                            <VBox spacing="4">
                                <Label text="Forums &amp; Discussions" styleClass="header-title" />
                                <Label text="Rejoignez des communautés et participez aux discussions" styleClass="header-subtitle" />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            
                            <!-- Statistiques -->
                            <HBox spacing="25" alignment="CENTER">
                                <VBox alignment="CENTER" spacing="2" styleClass="stat">
                                    <Label text="25+" styleClass="stat-number" />
                                    <Label text="Forums" styleClass="stat-label" />
                                </VBox>
                                <Separator orientation="VERTICAL" />
                                <VBox alignment="CENTER" spacing="2" styleClass="stat">
                                    <Label text="1.2K+" styleClass="stat-number" />
                                    <Label text="Membres" styleClass="stat-label" />
                                </VBox>
                                <Separator orientation="VERTICAL" />
                                <VBox alignment="CENTER" spacing="2" styleClass="stat">
                                    <Label text="5K+" styleClass="stat-number" />
                                    <Label text="Publications" styleClass="stat-label" />
                                </VBox>
                            </HBox>
                        </HBox>
                    </VBox>
                    
                    <!-- Section Forums -->
                    <VBox spacing="20" style="-fx-padding: 0 50 50 50;">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label text="Tous les forums" styleClass="section-title" />
                            <Region HBox.hgrow="ALWAYS"/>
                            
                            <!-- Onglets -->
                            <HBox spacing="8" alignment="CENTER">
                                <ToggleButton text="🔥 Populaires" selected="true" styleClass="tab-toggle" />
                                <ToggleButton text="🆕 Récents" styleClass="tab-toggle" />
                                <ToggleButton text="👤 Mes forums" styleClass="tab-toggle" />
                            </HBox>
                            
                            <!-- Action: Créer Forum -->
                            <Button text="➕ Créer forum" onAction="#handleAjoutForum" styleClass="create-btn"/>
                        </HBox>
                        
                        <!-- Liste des Forums -->
                                                <VBox fx:id="forumsContainer" spacing="15" styleClass="forums-list">
                            <padding><Insets bottom="20" right="10"/></padding>
                            <!-- Forums will be loaded here -->
                        </VBox>
                        
                        <!-- État Vide -->
                           <VBox fx:id="emptyState" alignment="CENTER" spacing="15" styleClass="empty-state" visible="false">
                            <Label text="💬" styleClass="empty-state-icon" />
                            <Label text="Aucun forum trouvé" styleClass="empty-state-title" />
                            <Label text="Créez le premier forum ou modifiez vos critères de recherche" styleClass="empty-state-subtitle" />
                            <Button text="➕ Créer un forum" onAction="#handleAjoutForum" styleClass="create-btn large" />
                           </VBox>
                    </VBox>
                    
                    <!-- Footer -->
                    <VBox alignment="CENTER" spacing="20" styleClass="page-footer">
                        <HBox alignment="CENTER" spacing="12" styleClass="footer-brand">
                            <StackPane>
                                <Circle radius="25" styleClass="footer-logo-circle" />
                                <Label text="G" styleClass="footer-logo-letter" />
                            </StackPane>
                            <Label text="Go" styleClass="footer-go" />
                            <Label text="Vibe" styleClass="footer-vibe" />
                        </HBox>
                        <Label text="© 2024 GoVibe. Tous droits réservés." styleClass="footer-copy" />
                        <HBox alignment="CENTER" spacing="25" styleClass="footer-links">
                            <Hyperlink text="À propos" />
                            <Hyperlink text="Confidentialité" />
                            <Hyperlink text="Conditions" />
                            <Hyperlink text="Contact" />
                        </HBox>
                    </VBox>
                    
                </VBox>
            </content>
        </ScrollPane>
    </center>

    </BorderPane>
</StackPane>
