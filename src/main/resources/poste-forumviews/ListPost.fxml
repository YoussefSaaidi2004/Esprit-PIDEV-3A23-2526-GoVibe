<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane fx:id="rootStackPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controllers.ListPostController" stylesheets="@../styles.css"
           style="-fx-background-color: #012E20;">

    <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" styleClass="premium-bg"/>
    <Pane styleClass="premium-bg-overlay" mouseTransparent="true"/>

    <BorderPane style="-fx-background-color: transparent;" prefHeight="900" prefWidth="1400">

        <!-- TOP HEADER -->
        <top>
            <StackPane styleClass="header-glass">
                <fx:include source="../components/UserHeader.fxml"/>
            </StackPane>
        </top>

        <!-- CENTRAL CONTENT -->
        <center>
            <ScrollPane fitToWidth="true"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                        VBox.vgrow="ALWAYS" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox spacing="0" style="-fx-background-color: transparent;">

                        <!-- ── Hero Header ── -->
                        <HBox alignment="CENTER_LEFT" spacing="25" styleClass="glass-panel"
                              style="-fx-padding: 28 36;">
                            <VBox.margin><Insets top="0"/></VBox.margin>
                            <StackPane styleClass="icon-circle-emerald">
                                <Label text="📰" style="-fx-font-size: 32;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label text="Publications"
                                       style="-fx-font-size: 30; -fx-font-weight: 900; -fx-text-fill: white;
                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 8, 0, 0, 2);"/>
                                <Label text="Consultez, modifiez ou supprimez les publications"
                                       style="-fx-font-size: 14; -fx-text-fill: rgba(255,255,255,0.8);"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <!-- Dynamic stats -->
                            <HBox spacing="12" alignment="CENTER">
                                <VBox alignment="CENTER" spacing="4" styleClass="glass-tile-mini" prefWidth="90">
                                    <Label fx:id="statTotalLabel" text="0" styleClass="tile-value-emerald" style="-fx-font-size: 20;"/>
                                    <Label text="POSTS" styleClass="tile-label-tiny"/>
                                </VBox>
                                <VBox alignment="CENTER" spacing="4" styleClass="glass-tile-mini" prefWidth="90">
                                    <Label fx:id="statLikesLabel" text="0" styleClass="tile-value-emerald" style="-fx-font-size: 20;"/>
                                    <Label text="LIKES" styleClass="tile-label-tiny"/>
                                </VBox>
                            </HBox>
                        </HBox>

                        <!-- ── Search + Actions ── -->
                        <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-padding: 20 40 0 40;">
                            <!-- Search bar -->
                            <HBox alignment="CENTER_LEFT" spacing="0" styleClass="search-bar-wrap" HBox.hgrow="ALWAYS">
                                <StackPane prefWidth="38" prefHeight="38">
                                    <SVGPath styleClass="search-icon-svg"
                                             content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                             scaleX="0.85" scaleY="0.85"/>
                                </StackPane>
                                <TextField fx:id="searchField" promptText="Rechercher dans les publications..."
                                           onKeyReleased="#handleSearch"
                                           styleClass="search-input" HBox.hgrow="ALWAYS"/>
                            </HBox>

                            <!-- PDF Export -->
                            <Button onAction="#handleExportPdf" styleClass="lf-btn-secondary">
                                <graphic>
                                    <HBox alignment="CENTER" spacing="8">
                                        <SVGPath styleClass="lf-btn-svg-dark"
                                                 content="M20 2H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8.5 7.5c0 .83-.67 1.5-1.5 1.5H9v2H7.5V7H10c.83 0 1.5.67 1.5 1.5v1zm5 2c0 .83-.67 1.5-1.5 1.5h-2.5V7H15c.83 0 1.5.67 1.5 1.5v3zm4-3H19v1h1.5V11H19v2h-1.5V7h3v1.5zM4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6z"
                                                 scaleX="0.85" scaleY="0.85"/>
                                        <Label text="Exporter PDF" styleClass="lf-btn-text-dark"/>
                                    </HBox>
                                </graphic>
                            </Button>

                            <!-- Back to Forums -->
                            <Button onAction="#handleGoToForums" styleClass="lf-btn-secondary">
                                <graphic>
                                    <HBox alignment="CENTER" spacing="8">
                                        <SVGPath styleClass="lf-btn-svg-dark"
                                                 content="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
                                                 scaleX="0.85" scaleY="0.85"/>
                                        <Label text="Forums" styleClass="lf-btn-text-dark"/>
                                    </HBox>
                                </graphic>
                            </Button>

                            <!-- New Post -->
                            <Button onAction="#handleAjoutPost" styleClass="lf-btn-primary">
                                <graphic>
                                    <HBox alignment="CENTER" spacing="8">
                                        <SVGPath styleClass="lf-btn-svg-light"
                                                 content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                                 scaleX="0.9" scaleY="0.9"/>
                                        <Label text="Nouvelle publication" styleClass="lf-btn-text-light"/>
                                    </HBox>
                                </graphic>
                            </Button>
                        </HBox>

                        <!-- ── Statistics Panel ── -->
                        <VBox style="-fx-padding: 18 50 0 50;">
                            <VBox fx:id="statsPanel" spacing="12" styleClass="stats-panel">
                                    <Label text="🏆 Top Publications par Likes"
                                           style="-fx-text-fill: #012E20; -fx-font-weight: 900; -fx-font-size: 16;"/>
                                    <HBox fx:id="topPostsRow" spacing="14" alignment="CENTER_LEFT"/>
                                </VBox>
                        </VBox>

                        <!-- ── Posts List ── -->
                        <VBox spacing="20" style="-fx-padding: 18 50 50 50;">
                                <Label text="Toutes les publications"
                                       style="-fx-font-size: 18; -fx-font-weight: 800; -fx-text-fill: white;
                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 6, 0, 0, 1);"/>
                                <VBox fx:id="postsContainer" spacing="15" styleClass="forums-list">
                                    <padding><Insets bottom="20" right="10"/></padding>
                                </VBox>
                        </VBox>

                        <!-- Footer -->
                        <VBox alignment="CENTER" spacing="20" styleClass="page-footer">
                            <HBox alignment="CENTER" spacing="12" styleClass="footer-brand">
                                <StackPane>
                                    <Circle radius="25" styleClass="footer-logo-circle"/>
                                    <Label text="G" styleClass="footer-logo-letter"/>
                                </StackPane>
                                <Label text="Go" styleClass="footer-go"/>
                                <Label text="Vibe" styleClass="footer-vibe"/>
                            </HBox>
                            <Label text="© 2024 GoVibe. Tous droits réservés." styleClass="footer-copy"/>
                        </VBox>

                    </VBox>
                </content>
            </ScrollPane>
        </center>

    </BorderPane>

    <!-- Modal Overlay -->
    <StackPane fx:id="formOverlay" managed="false" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false">
        <VBox fx:id="formContainer" alignment="CENTER" maxHeight="700" maxWidth="800"
              style="-fx-background-color: transparent;"/>
    </StackPane>

</StackPane>
