<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox alignment="CENTER" stylesheets="@../styles.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.ModifierForumController">

    <VBox maxWidth="620" minWidth="500" spacing="0"
          style="-fx-background-color: rgba(4,20,12,0.97);
                 -fx-background-radius: 24; -fx-border-color: rgba(80,200,120,0.38);
                 -fx-border-radius: 24; -fx-border-width: 1;
                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.75),50,0,0,12);">

        <!-- Header Bar -->
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-padding: 22 28 18 28;
                     -fx-background-color: linear-gradient(to right,rgba(80,200,120,0.2),rgba(61,175,98,0.06));
                     -fx-background-radius: 24 24 0 0;
                     -fx-border-color: transparent transparent rgba(80,200,120,0.25) transparent;
                     -fx-border-width: 0 0 1 0;">
            <StackPane>
                <Circle radius="24" fill="rgba(80,200,120,0.2)"
                        style="-fx-effect: dropshadow(gaussian,rgba(80,200,120,0.3),10,0,0,0);"/>
                <Label text="✏️" style="-fx-font-size: 20;"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="Modifier le Forum"
                       style="-fx-font-size: 19; -fx-font-weight: 900; -fx-text-fill: white;"/>
                <Label text="Mettez à jour les informations de ce forum"
                       style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 11;"/>
            </VBox>
        </HBox>

        <!-- Form Body -->
        <VBox spacing="16" style="-fx-padding: 24 28 28 28;">

            <!-- Forum Name -->
            <VBox spacing="6">
                <Label text="NOM DU FORUM"
                       style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: #50C878; -fx-letter-spacing: 2;"/>
                <TextField fx:id="nameField" promptText="Ex: Passion Tunisie, Aventures Sahara..."
                           style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: white;
                                  -fx-prompt-text-fill: rgba(255,255,255,0.3); -fx-background-radius: 12;
                                  -fx-padding: 11 16; -fx-border-color: rgba(80,200,120,0.22);
                                  -fx-border-radius: 12; -fx-border-width: 1; -fx-font-size: 14;"/>
            </VBox>

            <!-- Description -->
            <VBox spacing="6">
                <Label text="DESCRIPTION"
                       style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: #50C878; -fx-letter-spacing: 2;"/>
                <TextArea fx:id="descriptionArea" prefRowCount="4" wrapText="true"
                          promptText="Décrivez l'objectif de ce forum..."
                          style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: white;
                                 -fx-prompt-text-fill: rgba(255,255,255,0.3); -fx-background-radius: 12;
                                 -fx-padding: 10 14; -fx-border-color: rgba(80,200,120,0.22);
                                 -fx-border-radius: 12; -fx-border-width: 1; -fx-font-size: 13;
                                 -fx-control-inner-background: rgba(4,20,12,0.8);"/>
            </VBox>

            <!-- Visibility + Image -->
            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="VISIBILITÉ"
                           style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: #50C878; -fx-letter-spacing: 2;"/>
                    <ToggleButton fx:id="privateToggle" text="🔒  Rendre Privé" maxWidth="Infinity"
                                  style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: rgba(255,255,255,0.8);
                                         -fx-font-weight: 700; -fx-background-radius: 12; -fx-cursor: hand;
                                         -fx-padding: 10 18; -fx-border-color: rgba(80,200,120,0.22);
                                         -fx-border-radius: 12; -fx-border-width: 1; -fx-font-size: 13;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="IMAGE DE COUVERTURE"
                           style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: #50C878; -fx-letter-spacing: 2;"/>
                    <HBox spacing="10">
                        <TextField fx:id="imagePathField" promptText="Aucune image sélectionnée..."
                                   editable="false" HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: rgba(255,255,255,0.7);
                                          -fx-prompt-text-fill: rgba(255,255,255,0.3); -fx-background-radius: 10;
                                          -fx-padding: 10 12; -fx-border-color: rgba(80,200,120,0.22);
                                          -fx-border-radius: 10; -fx-border-width: 1; -fx-font-size: 12;"/>
                        <Button onAction="#handleChooseImage" text="Choisir"
                                style="-fx-background-color: rgba(80,200,120,0.18); -fx-text-fill: #50C878;
                                       -fx-font-weight: 700; -fx-padding: 10 16; -fx-background-radius: 10;
                                       -fx-cursor: hand; -fx-border-color: rgba(80,200,120,0.35);
                                       -fx-border-radius: 10; -fx-border-width: 1;"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Divider -->
            <Region prefHeight="1" style="-fx-background-color: rgba(80,200,120,0.18);"/>

            <!-- Action Buttons -->
            <HBox spacing="14" alignment="CENTER_RIGHT" style="-fx-padding: 6 0 0 0;">
                <Button onAction="#handleCancel" text="Annuler"
                        style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: rgba(255,255,255,0.75);
                               -fx-font-size: 13; -fx-font-weight: 600; -fx-padding: 11 26;
                               -fx-background-radius: 20; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 20; -fx-border-width: 1;"/>
                <Button onAction="#handleUpdate" text="✦  Mettre à jour"
                        style="-fx-background-color: linear-gradient(to right,#50C878,#3DAF62);
                               -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;
                               -fx-padding: 11 28; -fx-background-radius: 20; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian,rgba(80,200,120,0.55),14,0,0,4);"/>
            </HBox>
        </VBox>
    </VBox>
</VBox>
