<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox alignment="CENTER" stylesheets="@../styles.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.ModifierPostController">

    <VBox maxWidth="680" minWidth="520" spacing="0"
          style="-fx-background-color: rgba(4,20,12,0.97);
                 -fx-background-radius: 24; -fx-border-color: rgba(80,200,120,0.38);
                 -fx-border-radius: 24; -fx-border-width: 1;
                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.75),50,0,0,12);">

        <!-- ── Header Bar ── -->
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-padding: 22 28 18 28;
                     -fx-background-color: linear-gradient(to right,rgba(80,200,120,0.2),rgba(61,175,98,0.06));
                     -fx-background-radius: 24 24 0 0;
                     -fx-border-color: transparent transparent rgba(80,200,120,0.25) transparent;
                     -fx-border-width: 0 0 1 0;">
            <StackPane>
                <Circle radius="24" fill="rgba(80,200,120,0.2)"
                        style="-fx-effect: dropshadow(gaussian,rgba(80,200,120,0.3),10,0,0,0);"/>
                <Label text="✏️" style="-fx-font-size: 22;"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="Modifier la Publication"
                       style="-fx-font-size: 19; -fx-font-weight: 900; -fx-text-fill: white;"/>
                <Label text="Mettez à jour votre publication GoVibe"
                       style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 11;"/>
            </VBox>
        </HBox>

        <!-- ── Form Body ── -->
        <VBox spacing="16" style="-fx-padding: 24 28 28 28;">

            <!-- FORMAT -->
            <VBox spacing="8">
                <Label text="FORMAT DE PUBLICATION"
                       style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: #50C878; -fx-letter-spacing: 2;"/>
                <HBox spacing="12">
                    <ToggleButton fx:id="statusToggle" selected="true" text="💬  Statut Texte"
                                  maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: rgba(80,200,120,0.18); -fx-text-fill: #50C878;
                                         -fx-font-weight: 700; -fx-background-radius: 12; -fx-cursor: hand;
                                         -fx-padding: 10 18; -fx-border-color: rgba(80,200,120,0.45);
                                         -fx-border-radius: 12; -fx-border-width: 1; -fx-font-size: 13;"/>
                    <ToggleButton fx:id="mediaToggle" text="🖼  Photo / Vidéo"
                                  maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: rgba(255,255,255,0.75);
                                         -fx-font-weight: 700; -fx-background-radius: 12; -fx-cursor: hand;
                                         -fx-padding: 10 18; -fx-border-color: rgba(80,200,120,0.22);
                                         -fx-border-radius: 12; -fx-border-width: 1; -fx-font-size: 13;"/>
                </HBox>
            </VBox>

            <!-- MESSAGE -->
            <VBox spacing="8">
                <Label text="VOTRE MESSAGE"
                       style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: #50C878; -fx-letter-spacing: 2;"/>
                <TextArea fx:id="contenuArea" prefRowCount="5" wrapText="true"
                          promptText="Modifiez votre message..."
                          style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: white;
                                 -fx-prompt-text-fill: rgba(255,255,255,0.3); -fx-background-radius: 12;
                                 -fx-padding: 10 14; -fx-border-color: rgba(80,200,120,0.22);
                                 -fx-border-radius: 12; -fx-border-width: 1; -fx-font-size: 13;
                                 -fx-control-inner-background: rgba(4,20,12,0.8);"/>
                <HBox alignment="CENTER_RIGHT">
                    <Label fx:id="charCountLabel" text="0 / 500"
                           style="-fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 11;"/>
                </HBox>
            </VBox>

            <!-- MÉDIA (conditional) -->
            <VBox fx:id="mediaUrlContainer" managed="false" spacing="10" visible="false">
                <Label text="SÉLECTION MÉDIA"
                       style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: #50C878; -fx-letter-spacing: 2;"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <TextField fx:id="urlField" editable="false" HBox.hgrow="ALWAYS"
                               promptText="Choisissez un fichier image ou vidéo..."
                               style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: rgba(255,255,255,0.7);
                                      -fx-prompt-text-fill: rgba(255,255,255,0.3); -fx-background-radius: 10;
                                      -fx-padding: 11 14; -fx-border-color: rgba(80,200,120,0.22);
                                      -fx-border-radius: 10; -fx-border-width: 1; -fx-font-size: 13;"/>
                    <Button fx:id="uploadButton" onAction="#handleUploadMedia" text="Parcourir"
                            style="-fx-background-color: rgba(80,200,120,0.18); -fx-text-fill: #50C878;
                                   -fx-font-weight: 700; -fx-padding: 11 20; -fx-background-radius: 10;
                                   -fx-cursor: hand; -fx-border-color: rgba(80,200,120,0.35);
                                   -fx-border-radius: 10; -fx-border-width: 1;"/>
                </HBox>
            </VBox>

            <!-- Preview -->
            <VBox fx:id="previewContainer" alignment="CENTER" managed="false" spacing="10" visible="false"
                  style="-fx-background-color: rgba(255,255,255,0.04); -fx-background-radius: 14;
                         -fx-border-color: rgba(80,200,120,0.2); -fx-border-radius: 14; -fx-border-width: 1;
                         -fx-padding: 16;">
                <Label text="Aperçu du média"
                       style="-fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 12;"/>
                <ImageView fx:id="mediaPreview" fitHeight="200" fitWidth="360" preserveRatio="true"/>
            </VBox>

            <!-- Divider -->
            <Region prefHeight="1"
                    style="-fx-background-color: rgba(80,200,120,0.18); -fx-pref-height: 1;"/>

            <!-- Actions -->
            <HBox spacing="14" alignment="CENTER_RIGHT">
                <Button onAction="#handleCancel" text="Annuler"
                        style="-fx-background-color: rgba(255,255,255,0.07); -fx-text-fill: rgba(255,255,255,0.75);
                               -fx-font-size: 13; -fx-font-weight: 600; -fx-padding: 11 26;
                               -fx-background-radius: 20; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 20; -fx-border-width: 1;"/>
                <Button onAction="#handleUpdate" text="✦  Enregistrer"
                        style="-fx-background-color: linear-gradient(to right,#50C878,#3DAF62);
                               -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;
                               -fx-padding: 11 28; -fx-background-radius: 20; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian,rgba(80,200,120,0.55),14,0,0,4);"/>
            </HBox>
        </VBox>
    </VBox>
</VBox>
