<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.SignUpController">
   <children>
      <VBox alignment="CENTER" layoutX="300.0" layoutY="50.0" prefHeight="500.0" prefWidth="300.0" spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
         <children>
            <Label text="Inscription" textFill="#084E36">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <VBox spacing="5.0">
               <children>
                  <Label text="Nom" textFill="#5F6368" />
                  <TextField fx:id="nomField" promptText="Votre nom" style="-fx-background-radius: 5; -fx-border-color: #dadce0; -fx-border-radius: 5;" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Prénom" textFill="#5F6368" />
                  <TextField fx:id="prenomField" promptText="Votre prénom" style="-fx-background-radius: 5; -fx-border-color: #dadce0; -fx-border-radius: 5;" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Email" textFill="#5F6368" />
                  <TextField fx:id="emailField" promptText="Votre email" style="-fx-background-radius: 5; -fx-border-color: #dadce0; -fx-border-radius: 5;" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Mot de passe" textFill="#5F6368" />
                  <PasswordField fx:id="passwordField" promptText="Votre mot de passe" style="-fx-background-radius: 5; -fx-border-color: #dadce0; -fx-border-radius: 5;" />
               </children>
            </VBox>
             <VBox spacing="5.0">
               <children>
                  <Label text="Rôle" textFill="#5F6368" />
                  <ComboBox fx:id="roleComboBox" prefWidth="300.0" style="-fx-background-radius: 5; -fx-border-color: #dadce0; -fx-border-radius: 5;" />
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#handleConfigureFaceID" prefWidth="300.0" style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="📸 Configurer Face ID (Optionnel)">
               <padding>
                  <Insets bottom="10.0" top="10.0" />
               </padding>
            </Button>
            <Button fx:id="registerButton" mnemonicParsing="false" onAction="#handleRegister" prefWidth="300.0" style="-fx-background-color: #50C878; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="S'inscrire">
               <padding>
                  <Insets bottom="10.0" top="10.0" />
               </padding>
            </Button>
            <Hyperlink onAction="#handleGoToLogin" text="Déjà un compte ? Se connecter" textFill="#50C878" />
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
