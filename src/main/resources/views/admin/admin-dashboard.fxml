<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.TextFlow?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.gestionvol.controller.admin.AdminDashboardController"
            styleClass="main-bg">
    
    <left>
        <VBox styleClass="sidebar" spacing="20">
            <!-- Logo Section -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 20 10;">
                <SVGPath content="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" style="-fx-fill: #50C878;" scaleX="1.2" scaleY="1.2"/>
                <TextFlow>
                    <Text text="Go" style="-fx-fill: #50C878; -fx-font-weight: bold; -fx-font-size: 24px;"/>
                    <Text text="Vibe" style="-fx-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 24px;"/>
                </TextFlow>
            </HBox>
            
            <Button fx:id="dashBtn" onAction="#navDashboard" styleClass="nav-button, nav-button-active" text="Dashboard">
                <graphic>
                    <SVGPath content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" styleClass="nav-icon" scaleX="1.1" scaleY="1.1"/>
                </graphic>
            </Button>
            
            <Button onAction="#navFlights" styleClass="nav-button" text="Flights">
                <graphic>
                    <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" styleClass="nav-icon" scaleX="1.1" scaleY="1.1"/>
                </graphic>
            </Button>
            
            <Button onAction="#navBookings" styleClass="nav-button" text="Bookings">
                <graphic>
                    <SVGPath content="M22 10V6c0-1.11-.9-2-2-2H4c-1.1 0-1.99.89-1.99 2v4c1.1 0 1.99.9 1.99 2s-.89 2-2 2v4c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2v-4c-1.1 0-2-.9-2-2s.9-2 2-2zm-9 7.5h-2v-2h2v2zm0-4.5h-2v-2h2v2zm0-4.5h-2v-2h2v2z" styleClass="nav-icon" scaleX="1.1" scaleY="1.1"/>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

            <Button onAction="#handleThemeToggle" styleClass="nav-button" text="Theme">
                <graphic>
                    <SVGPath content="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-3.03 0-5.5-2.47-5.5-5.5 0-1.82.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" styleClass="nav-icon" scaleX="1.1" scaleY="1.1"/>
                </graphic>
            </Button>
            
            <Button onAction="#navUser" styleClass="nav-button" text="User View">
                <graphic>
                    <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z" styleClass="nav-icon" scaleX="1.1" scaleY="1.1"/>
                </graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="35" style="-fx-padding: 40;">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Text text="Overview &amp; Statistics" styleClass="title"/>
                        <Text text="Quick summary of your flight system performance" styleClass="subtitle"/>
                    </VBox>
                </HBox>

                <FlowPane hgap="30" vgap="30">
                    <!-- Pending Approvals Card -->
                    <HBox styleClass="metric-card-modern" spacing="20" alignment="CENTER_LEFT">
                        <StackPane styleClass="icon-container-modern" style="-fx-background-color: rgba(255, 209, 102, 0.15);">
                            <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" style="-fx-fill: #FFD166;" scaleX="1.5" scaleY="1.5"/>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="2">
                            <Text fx:id="pendingCount" styleClass="metric-value-modern" text="12"/>
                            <Text text="Pending Approvals" styleClass="metric-label-modern"/>
                            <Button styleClass="text-btn" onAction="#navPending" style="-fx-padding: 5 0 0 0;">
                                <graphic>
                                    <HBox spacing="5" alignment="CENTER_LEFT">
                                        <Text text="Review Now" style="-fx-fill: #013220; -fx-font-weight: bold; -fx-font-size: 11;"/>
                                        <SVGPath content="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" style="-fx-fill: #013220;" scaleX="0.8" scaleY="0.8"/>
                                    </HBox>
                                </graphic>
                            </Button>
                        </VBox>
                    </HBox>

                    <!-- Total Flights Card -->
                    <HBox styleClass="metric-card-modern" spacing="20" alignment="CENTER_LEFT">
                        <StackPane styleClass="icon-container-modern" style="-fx-background-color: rgba(80, 200, 120, 0.1);">
                            <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" style="-fx-fill: #50C878;" scaleX="1.5" scaleY="1.5"/>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="2">
                            <Text fx:id="flightCount" styleClass="metric-value-modern" text="0"/>
                            <Text text="Active Flights" styleClass="metric-label-modern"/>
                        </VBox>
                    </HBox>
                    
                    <!-- Total Bookings Card -->
                    <HBox styleClass="metric-card-modern" spacing="20" alignment="CENTER_LEFT">
                        <StackPane styleClass="icon-container-modern" style="-fx-background-color: rgba(211, 84, 0, 0.1);">
                            <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" style="-fx-fill: #D35400;" scaleX="1.5" scaleY="1.5"/>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="2">
                            <Text fx:id="totalBookingsText" styleClass="metric-value-modern" text="0"/>
                            <Text text="Total Bookings" styleClass="metric-label-modern"/>
                        </VBox>
                    </HBox>
                    
                    <!-- Total Revenue Card -->
                    <HBox styleClass="metric-card-modern" spacing="20" alignment="CENTER_LEFT">
                        <StackPane styleClass="icon-container-modern" style="-fx-background-color: rgba(192, 57, 43, 0.1);">
                            <SVGPath content="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" style="-fx-fill: #C0392B;" scaleX="1.5" scaleY="1.5"/>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="2">
                            <Text fx:id="revenueText" styleClass="metric-value-modern" text="0 DT"/>
                            <Text text="Total Revenue" styleClass="metric-label-modern"/>
                        </VBox>
                    </HBox>
                    
                    <!-- Avg Occupancy Card -->
                    <HBox styleClass="metric-card-modern" spacing="20" alignment="CENTER_LEFT">
                        <StackPane styleClass="icon-container-modern" style="-fx-background-color: rgba(17, 120, 100, 0.1);">
                            <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" style="-fx-fill: #117864;" scaleX="1.5" scaleY="1.5"/>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="2">
                            <Text fx:id="occupancyText" styleClass="metric-value-modern" text="0%"/>
                            <Text text="Avg. Occupancy" styleClass="metric-label-modern"/>
                        </VBox>
                    </HBox>
                </FlowPane>

                <VBox spacing="20">
                    <HBox alignment="CENTER_LEFT">
                        <Text text="Recent Pending Approvals" styleClass="title" style="-fx-font-size: 18;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#navBookings" styleClass="icon-btn">
                            <graphic>
                                <SVGPath content="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" style="-fx-fill: #50C878;" scaleX="1.2" scaleY="1.2"/>
                            </graphic>
                        </Button>
                    </HBox>
                    <FlowPane fx:id="pendingGrid" hgap="25" vgap="25" alignment="CENTER" style="-fx-padding: 20;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
