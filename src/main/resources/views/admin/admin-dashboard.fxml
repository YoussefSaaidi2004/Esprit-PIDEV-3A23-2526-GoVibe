<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.TextFlow?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.gestionvol.controller.admin.AdminDashboardController"
            styleClass="main-bg">
    
    <left>
        <VBox styleClass="sidebar" spacing="20">
            <!-- Logo Section -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 20 10;">
                <SVGPath content="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" style="-fx-fill: #50C878;" scaleX="1.2" scaleY="1.2"/>
                <TextFlow>
                    <Text text="Go" style="-fx-fill: #50C878; -fx-font-weight: bold; -fx-font-size: 24px;"/>
                    <Text text="Vibe" style="-fx-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 24px;"/>
                </TextFlow>
            </HBox>
            
            <Button fx:id="dashBtn" onAction="#navDashboard" styleClass="nav-button, nav-button-active" text="Dashboard">
                <graphic>
                    <SVGPath content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" styleClass="nav-icon" scaleX="1.1" scaleY="1.1"/>
                </graphic>
            </Button>
            
            <Button onAction="#navFlights" styleClass="nav-button" text="Flights">
                <graphic>
                    <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" styleClass="nav-icon" scaleX="1.1" scaleY="1.1"/>
                </graphic>
            </Button>
            
            <Button onAction="#navBookings" styleClass="nav-button" text="Bookings">
                <graphic>
                    <SVGPath content="M22 10V6c0-1.11-.9-2-2-2H4c-1.1 0-1.99.89-1.99 2v4c1.1 0 1.99.9 1.99 2s-.89 2-2 2v4c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2v-4c-1.1 0-2-.9-2-2s.9-2 2-2zm-9 7.5h-2v-2h2v2zm0-4.5h-2v-2h2v2zm0-4.5h-2v-2h2v2z" styleClass="nav-icon" scaleX="1.1" scaleY="1.1"/>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

            <Button onAction="#handleThemeToggle" styleClass="nav-button" text="Theme">
                <graphic>
                    <SVGPath content="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-3.03 0-5.5-2.47-5.5-5.5 0-1.82.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" styleClass="nav-icon" scaleX="1.1" scaleY="1.1"/>
                </graphic>
            </Button>
            
            <Button onAction="#navUser" styleClass="nav-button" text="User View">
                <graphic>
                    <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z" styleClass="nav-icon" scaleX="1.1" scaleY="1.1"/>
                </graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="35" style="-fx-padding: 40;">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Text text="Overview &amp; Statistics" styleClass="title"/>
                        <Text text="Quick summary of your flight system performance" styleClass="subtitle"/>
                    </VBox>
                </HBox>

                <FlowPane hgap="25" vgap="25">
                    <VBox styleClass="card, metric-card" alignment="CENTER" spacing="12">
                        <Text text="🕒" style="-fx-font-size: 28px; -fx-fill: #FFD166;"/>
                        <Text fx:id="pendingCount" style="-fx-font-size: 26; -fx-font-weight: bold;" text="12"/>
                        <Text text="PENDING" styleClass="subtitle" style="-fx-font-size: 10; -fx-font-weight: bold;"/>
                        <Button styleClass="text-btn" onAction="#navPending">
                            <graphic>
                                <HBox spacing="5" alignment="CENTER">
                                    <Text text="View All" style="-fx-fill: #2E8B57; -fx-font-weight: bold;"/>
                                    <Text text="►" style="-fx-fill: #2E8B57; -fx-font-size: 10;"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </VBox>
                    <HBox styleClass="card, metric-card" spacing="15" alignment="CENTER_LEFT">
                        <StackPane styleClass="icon-container" prefWidth="60" prefHeight="60" style="-fx-background-color: rgba(46, 139, 87, 0.1); -fx-background-radius: 30;">
                            <Text text="✈" style="-fx-font-size: 24; -fx-fill: #2E8B57;"/>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT">
                            <Text fx:id="flightCount" styleClass="metric-value" text="0"/>
                            <Text text="Total Flights" styleClass="metric-label"/>
                        </VBox>
                    </HBox>
                    
                    <HBox styleClass="card, metric-card" spacing="15" alignment="CENTER_LEFT">
                        <StackPane styleClass="icon-container" prefWidth="60" prefHeight="60" style="-fx-background-color: rgba(211, 84, 0, 0.1); -fx-background-radius: 30;">
                            <Text text="👥" style="-fx-font-size: 24; -fx-fill: #D35400;"/>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT">
                            <Text fx:id="totalBookingsText" styleClass="metric-value" text="0"/>
                            <Text text="Total Bookings" styleClass="metric-label"/>
                        </VBox>
                    </HBox>
                    
                    <HBox styleClass="card, metric-card" spacing="15" alignment="CENTER_LEFT">
                        <StackPane styleClass="icon-container" prefWidth="60" prefHeight="60" style="-fx-background-color: rgba(192, 57, 43, 0.1); -fx-background-radius: 30;">
                            <Text text="💰" style="-fx-font-size: 24; -fx-fill: #C0392B;"/>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT">
                            <Text fx:id="revenueText" styleClass="metric-value" text="0 DT"/>
                            <Text text="Total Revenue" styleClass="metric-label"/>
                        </VBox>
                    </HBox>
                    
                    <HBox styleClass="card, metric-card" spacing="15" alignment="CENTER_LEFT">
                        <StackPane styleClass="icon-container" prefWidth="60" prefHeight="60" style="-fx-background-color: rgba(17, 120, 100, 0.1); -fx-background-radius: 30;">
                            <Text text="📊" style="-fx-font-size: 24; -fx-fill: #117864;"/>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT">
                            <Text fx:id="occupancyText" styleClass="metric-value" text="0%"/>
                            <Text text="Avg. Occupancy" styleClass="metric-label"/>
                        </VBox>
                    </HBox>
                </FlowPane>

                <VBox spacing="20">
                    <HBox alignment="CENTER_LEFT">
                        <Text text="Recent Pending Approvals" styleClass="title" style="-fx-font-size: 18;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#navBookings" styleClass="icon-btn">
                            <graphic><Text text="➡️" style="-fx-font-size: 18px; -fx-fill: #50C878;"/></graphic>
                        </Button>
                    </HBox>
                    <FlowPane fx:id="pendingGrid" hgap="25" vgap="25" alignment="CENTER" style="-fx-padding: 20;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
