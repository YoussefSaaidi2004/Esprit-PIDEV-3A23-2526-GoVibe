<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.TextFlow?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.gestionvol.controller.admin.CheckoutManagementController"
            styleClass="main-bg">
    
    <left>
        <VBox styleClass="sidebar" spacing="20">
            <!-- Logo Section -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 20 10;">
                <SVGPath content="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" style="-fx-fill: #50C878;" scaleX="1.2" scaleY="1.2"/>
                <TextFlow>
                    <Text text="Go" style="-fx-fill: #50C878; -fx-font-weight: bold; -fx-font-size: 24px;"/>
                    <Text text="Vibe" style="-fx-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 24px;"/>
                </TextFlow>
            </HBox>
            
            <Button onAction="#navDashboard" styleClass="nav-button" text="Dashboard">
                <graphic><Text text="📊" styleClass="nav-icon"/></graphic>
            </Button>
            
            <Button onAction="#navFlights" styleClass="nav-button" text="Flights">
                <graphic><Text text="✈️" styleClass="nav-icon"/></graphic>
            </Button>
            
            <Button styleClass="nav-button, nav-button-active" text="Bookings">
                <graphic><Text text="🎫" styleClass="nav-icon"/></graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

            <Button onAction="#handleThemeToggle" styleClass="nav-button" text="Theme">
                <graphic><Text text="🌗" styleClass="nav-icon"/></graphic>
            </Button>
            
            <Button onAction="#navUser" styleClass="nav-button" text="User View">
                <graphic><Text text="🔄" styleClass="nav-icon"/></graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox spacing="30" style="-fx-padding: 40;">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Text text="Reservations Tracking" styleClass="title"/>
                    <Text text="Monitor and moderate all passenger bookings" styleClass="subtitle"/>
                </VBox>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
                <FlowPane fx:id="checkoutGrid" hgap="25" vgap="25" alignment="CENTER" style="-fx-padding: 20;"/>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
