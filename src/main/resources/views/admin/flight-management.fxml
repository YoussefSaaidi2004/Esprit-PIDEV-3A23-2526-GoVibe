<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.TextFlow?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.gestionvol.controller.admin.FlightManagementController"
            styleClass="main-bg">
    
    <left>
        <VBox styleClass="sidebar" spacing="20">
            <!-- Logo Section -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 20 10;">
                <SVGPath content="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" style="-fx-fill: #50C878;" scaleX="1.2" scaleY="1.2"/>
                <TextFlow>
                    <Text text="Go" style="-fx-fill: #50C878; -fx-font-weight: bold; -fx-font-size: 24px;"/>
                    <Text text="Vibe" style="-fx-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 24px;"/>
                </TextFlow>
            </HBox>
            
            <Button onAction="#navDashboard" styleClass="nav-button" text="Dashboard">
                <graphic>
                    <SVGPath content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" styleClass="nav-icon" scaleX="1.1" scaleY="1.1"/>
                </graphic>
            </Button>
            
            <Button styleClass="nav-button, nav-button-active" text="Flights">
                <graphic>
                    <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" styleClass="nav-icon" scaleX="1.1" scaleY="1.1"/>
                </graphic>
            </Button>
            
            <Button onAction="#navBookings" styleClass="nav-button" text="Bookings">
                <graphic>
                    <SVGPath content="M22 10V6c0-1.11-.9-2-2-2H4c-1.1 0-1.99.89-1.99 2v4c1.1 0 1.99.9 1.99 2s-.89 2-2 2v4c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2v-4c-1.1 0-2-.9-2-2s.9-2 2-2zm-9 7.5h-2v-2h2v2zm0-4.5h-2v-2h2v2zm0-4.5h-2v-2h2v2z" styleClass="nav-icon" scaleX="1.1" scaleY="1.1"/>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

            <Button onAction="#handleThemeToggle" styleClass="nav-button" text="Theme">
                <graphic>
                    <SVGPath content="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-3.03 0-5.5-2.47-5.5-5.5 0-1.82.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" styleClass="nav-icon" scaleX="1.1" scaleY="1.1"/>
                </graphic>
            </Button>
            
            <Button onAction="#navUser" styleClass="nav-button" text="User View">
                <graphic>
                    <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z" styleClass="nav-icon" scaleX="1.1" scaleY="1.1"/>
                </graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox spacing="25" style="-fx-padding: 40;">
            <!-- Header Section -->
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Text text="Flight Management" styleClass="title"/>
                    <Text text="Create, update, or remove flights from the system" styleClass="subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleAdd" styleClass="btn-success" prefHeight="45" prefWidth="50" style="-fx-background-radius: 25;">
                     <tooltip><Tooltip text="Add New Flight"/></tooltip>
                    <graphic>
                        <HBox spacing="0" alignment="CENTER">
                            <Text text="➕" style="-fx-font-size: 20px; -fx-fill: white;"/>
                        </HBox>
                    </graphic>
                </Button>
            </HBox>

            <!-- Quick Stats -->
            <HBox spacing="20" alignment="CENTER_LEFT">
                <VBox spacing="4" styleClass="glass-card" style="-fx-padding: 15 25; -fx-background-radius: 15;">
                    <HBox spacing="8" alignment="CENTER">
                        <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" style="-fx-fill: #013220;" scaleX="1.2" scaleY="1.2"/>
                        <Text fx:id="totalFlightsText" text="0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-fill: #013220;"/>
                    </HBox>
                    <Text text="Total Flights" style="-fx-font-size: 10; -fx-fill: #8D99AE; -fx-font-weight: bold;"/>
                </VBox>
                
                <VBox spacing="4" styleClass="glass-card" style="-fx-padding: 15 25; -fx-background-radius: 15;">
                    <HBox spacing="8" alignment="CENTER">
                        <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" style="-fx-fill: #50C878;" scaleX="1.2" scaleY="1.2"/>
                        <Text fx:id="totalSeatsText" text="0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-fill: #50C878;"/>
                    </HBox>
                    <Text text="Available Seats" style="-fx-font-size: 10; -fx-fill: #8D99AE; -fx-font-weight: bold;"/>
                </VBox>
                
                <VBox spacing="4" styleClass="glass-card" style="-fx-padding: 15 25; -fx-background-radius: 15;">
                    <HBox spacing="8" alignment="CENTER">
                        <SVGPath content="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12.29,18.09V20h-2.67v-1.93c-1.71-0.36-3.15-1.46-3.27-3.4h1.96c0.1,1.05,1.18,1.91,2.53,1.91c1.29,0,2.13-0.72,2.13-1.55c0-0.8-0.68-1.38-2.6-1.92c-2-0.57-4.14-1.23-4.14-3.79c0-2.02,1.38-3.32,3.39-3.79V3.5h2.67v1.93c1.45,0.32,2.77,1.21,3.11,2.97h-1.96c-0.19-0.96-0.99-1.57-2.18-1.57c-1.28,0-2.06,0.73-2.06,1.48c0,0.85,0.7,1.42,2.71,1.95c2.19,0.58,4.03,1.35,4.03,3.74C15.6,15.93,14.35,17.73,12.29,18.09z" style="-fx-fill: #013220;" scaleX="1.2" scaleY="1.2"/>
                        <Text fx:id="avgPriceText" text="0 DT" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-fill: #013220;"/>
                    </HBox>
                    <Text text="Avg. Price" style="-fx-font-size: 10; -fx-fill: #8D99AE; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- Filter Bar -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="filter-bar">
                <HBox styleClass="input-with-icon" spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" style="-fx-max-width: 350;">
                    <Text text="🔍" style="-fx-font-size: 14px; -fx-fill: #8D99AE;"/>
                    <TextField fx:id="searchField" promptText="Search by destination, airline, or ID..." 
                               style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS"/>
                </HBox>
                
                <Separator orientation="VERTICAL" style="-fx-padding: 0 5;"/>
                
                <HBox spacing="8" alignment="CENTER">
                    <Text text="Sort:" style="-fx-font-size: 12; -fx-fill: #8D99AE; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="sortCombo" promptText="Choose..." prefWidth="150" 
                              styleClass="combo-box" style="-fx-background-radius: 20; -fx-border-radius: 20;"/>
                </HBox>
                
                <Button onAction="#handleRefresh" styleClass="icon-btn" style="-fx-background-color: #F5F3E7; -fx-background-radius: 20;">
                    <graphic><Text text="🔄" style="-fx-font-size: 16px;"/></graphic>
                </Button>
            </HBox>

            <!-- Flights Grid -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
                <FlowPane fx:id="flightGrid" hgap="25" vgap="25" alignment="TOP_LEFT" style="-fx-padding: 20;"/>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
