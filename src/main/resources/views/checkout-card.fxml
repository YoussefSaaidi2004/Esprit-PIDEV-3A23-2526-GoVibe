<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.CheckoutCardController"
      spacing="0" prefWidth="340"
      style="-fx-background-color: #0b2a1c;
             -fx-background-radius: 18;
             -fx-border-color: rgba(78,232,138,0.18);
             -fx-border-width: 1;
             -fx-border-radius: 18;
             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.55),22,0,0,6);
             -fx-cursor: hand;">

    <!-- ── Top accent bar ─────────────────────────────────────── -->
    <Region prefHeight="4"
            style="-fx-background-color: linear-gradient(to right, #1a8f4e, #4de88a);
                   -fx-background-radius: 18 18 0 0;"/>

    <!-- ── Card body ─────────────────────────────────────────── -->
    <VBox spacing="14" style="-fx-padding: 20 22 20 22;">

        <!-- Header row: icon + route + status badge -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <!-- Plane icon pill -->
            <StackPane minWidth="42" minHeight="42"
                       style="-fx-background-color: rgba(26,143,78,0.22);
                              -fx-background-radius: 12;">
                <Label text="✈" style="-fx-font-size: 20; -fx-text-fill: #4de88a;"/>
            </StackPane>

            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label fx:id="dateText" text="DATE RESERVATION"
                       style="-fx-font-size: 9; -fx-font-weight: 900;
                              -fx-text-fill: rgba(255,255,255,0.45);
                              -fx-letter-spacing: 1;"/>
                <Label fx:id="routeText" text="TUN → DXB"
                       style="-fx-font-size: 17; -fx-font-weight: 900;
                              -fx-text-fill: white;"/>
            </VBox>

            <!-- Status badge -->
            <Label fx:id="statusText" text="CONFIRMED"
                   style="-fx-font-size: 9; -fx-font-weight: 900;
                          -fx-text-fill: #4de88a;
                          -fx-background-color: rgba(78,232,138,0.15);
                          -fx-background-radius: 50;
                          -fx-border-color: rgba(78,232,138,0.35);
                          -fx-border-radius: 50;
                          -fx-border-width: 1;
                          -fx-padding: 3 10 3 10;"/>
        </HBox>

        <!-- Divider -->
        <Region prefHeight="1"
                style="-fx-background-color: rgba(255,255,255,0.07);"/>

        <!-- Info grid: passenger | airline -->
        <GridPane hgap="12" vgap="0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
            </columnConstraints>

            <VBox spacing="3" GridPane.columnIndex="0">
                <Label text="PASSAGERS"
                       style="-fx-font-size: 8; -fx-font-weight: 900;
                              -fx-text-fill: rgba(255,255,255,0.38);
                              -fx-letter-spacing: 0.8;"/>
                <Label fx:id="passengerText" text="2 Passagers"
                       style="-fx-font-size: 13; -fx-font-weight: 700;
                              -fx-text-fill: rgba(255,255,255,0.9);"/>
            </VBox>

            <VBox spacing="3" GridPane.columnIndex="1">
                <Label text="COMPAGNIE"
                       style="-fx-font-size: 8; -fx-font-weight: 900;
                              -fx-text-fill: rgba(255,255,255,0.38);
                              -fx-letter-spacing: 0.8;"/>
                <Label fx:id="airlineText" text="Tunisair"
                       style="-fx-font-size: 13; -fx-font-weight: 700;
                              -fx-text-fill: rgba(255,255,255,0.9);"/>
            </VBox>
        </GridPane>

        <!-- Divider -->
        <Region prefHeight="1"
                style="-fx-background-color: rgba(255,255,255,0.07);"/>

        <!-- Price row -->
        <HBox alignment="CENTER_LEFT" spacing="0">
            <VBox spacing="1" HBox.hgrow="ALWAYS">
                <Label text="TOTAL PAYE"
                       style="-fx-font-size: 8; -fx-font-weight: 900;
                              -fx-text-fill: rgba(255,255,255,0.38);
                              -fx-letter-spacing: 0.8;"/>
                <HBox alignment="BASELINE_LEFT" spacing="4">
                    <Label fx:id="priceText" text="0"
                           style="-fx-font-size: 24; -fx-font-weight: 900;
                                  -fx-text-fill: #4de88a;"/>
                    <Label text="DT"
                           style="-fx-font-size: 13; -fx-font-weight: 700;
                                  -fx-text-fill: rgba(78,232,138,0.7);
                                  -fx-padding: 0 0 3 0;"/>
                </HBox>
            </VBox>
        </HBox>

        <!-- Divider before actions -->
        <Region prefHeight="1"
                style="-fx-background-color: rgba(255,255,255,0.07);"/>

        <!-- Action buttons row -->
        <HBox fx:id="actionBox" alignment="CENTER_RIGHT" spacing="10">
            <!-- Buttons injected dynamically by CheckoutCardController -->
        </HBox>

    </VBox>
</VBox>
