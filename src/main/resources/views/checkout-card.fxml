<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="org.example.controllers.CheckoutCardController"
      styleClass="interactive-card, glass-pane-premium" spacing="15" prefWidth="350" 
      style="-fx-padding: 22; -fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 20; -fx-border-radius: 20;">
    
    <!-- Ticket Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <StackPane style="-fx-background-color: rgba(80, 200, 120, 0.1); -fx-background-radius: 12; -fx-padding: 10;">
            <SVGPath content="M5 2c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2H5zm0 2h14v16H5V4zm2 2v2h10V6H7zm0 4v2h10v-2H7zm0 4v2h10v-2H7z" 
                     styleClass="svg-icon-emerald" scaleX="1.2" scaleY="1.2"/>
        </StackPane>
        <VBox HBox.hgrow="ALWAYS">
            <Text fx:id="dateText" style="-fx-font-size: 10; -fx-font-weight: 900; -fx-fill: #8D99AE; -fx-letter-spacing: 0.5;" text="RESERVATION DATE"/>
            <Text fx:id="routeText" style="-fx-font-weight: 900; -fx-font-size: 17; -fx-fill: #013220;" text="TUNIS → DUBAI"/>
        </VBox>
        <VBox alignment="CENTER_RIGHT">
             <Text fx:id="statusText" style="-fx-font-size: 10; -fx-font-weight: 900; -fx-fill: #50C878;" text="CONFIRMED"/>
        </VBox>
    </HBox>

    <Separator style="-fx-opacity: 0.1; -fx-border-style: dashed; -fx-border-color: #d1f2eb; -fx-border-width: 0 0 1 0;"/>

    <!-- Passenger & Airline Info -->
    <GridPane hgap="15" vgap="10">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="100" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="100" />
        </columnConstraints>
        
        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Text text="PASSENGER" style="-fx-font-size: 8; -fx-font-weight: 900; -fx-fill: #8D99AE;"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" 
                         styleClass="svg-icon-muted" scaleX="0.8" scaleY="0.8"/>
                <Text fx:id="passengerText" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-fill: #013220;" text="2 Passengers"/>
            </HBox>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Text text="AIRLINE" style="-fx-font-size: 8; -fx-font-weight: 900; -fx-fill: #8D99AE;"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" 
                         styleClass="svg-icon-muted" scaleX="0.8" scaleY="0.8"/>
                <Text fx:id="airlineText" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-fill: #013220;" text="Tunisair"/>
            </HBox>
        </VBox>
    </GridPane>

    <Separator style="-fx-opacity: 0.1;"/>

    <!-- Price Section -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Text text="TOTAL PAID" style="-fx-font-size: 9; -fx-font-weight: 900; -fx-fill: #8D99AE;"/>
            <HBox spacing="6" alignment="BASELINE_LEFT">
                <Text fx:id="priceText" style="-fx-font-weight: 900; -fx-font-size: 22; -fx-fill: #013220;" text="2,450"/>
                <Text text="DT" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-fill: #50C878;"/>
            </HBox>
        </VBox>
        
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button onAction="#handleViewDetails" style="-fx-background-color: transparent; -fx-border-color: #d1f2eb; -fx-border-radius: 10; -fx-padding: 8; -fx-cursor: hand;">
                <graphic>
                    <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" 
                             styleClass="svg-icon-muted"/>
                </graphic>
            </Button>
        </HBox>
    </HBox>

    <!-- Action Buttons -->
    <HBox fx:id="actionBox" alignment="CENTER" spacing="12">
        <!-- Buttons injected dynamically -->
    </HBox>
</VBox>
