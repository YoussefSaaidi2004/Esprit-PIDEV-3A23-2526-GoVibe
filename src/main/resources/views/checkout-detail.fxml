<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:id="rootPane"
           fx:controller="org.example.controllers.CheckoutDetailController"
           stylesheets="@../styles/unified-styles.css"
           styleClass="main-bg">
    
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="0" alignment="TOP_CENTER" styleClass="form-container">
            <VBox styleClass="form-card" spacing="35" maxWidth="700">
                <!-- Header -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" style="-fx-fill: #50C878;" scaleX="1.5" scaleY="1.5"/>
                            <Text text="Booking Details" styleClass="title"/>
                        </HBox>
                        <Text text="View and manage your flight reservation" styleClass="subtitle"/>
                    </VBox>
                    <Label fx:id="statusBadge" text="PENDING" styleClass="badge, badge-pending" style="-fx-font-size: 12; -fx-padding: 8 16;"/>
                </HBox>

                <Separator/>

                <!-- Flight Information -->
                <VBox spacing="15">
                    <Text text="FLIGHT INFORMATION" style="-fx-font-weight: bold; -fx-fill: -fx-gv-text-primary; -fx-font-size: 14;"/>
                    <VBox spacing="12" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-background-radius: 10;">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" style="-fx-fill: #50C878;" scaleX="1.2" scaleY="1.2"/>
                            <VBox>
                                <Text fx:id="flightRoute" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-fill: -fx-gv-text-primary;" text="Route"/>
                                <Text fx:id="flightDetails" styleClass="subtitle" text="Flight details"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <Separator/>

                <!-- Passenger Details (Editable) -->
                <VBox spacing="20">
                    <HBox alignment="CENTER_LEFT">
                        <Text text="PASSENGER DETAILS" style="-fx-font-weight: bold; -fx-fill: -fx-gv-text-primary; -fx-font-size: 14;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="editBtn" onAction="#toggleEditMode" styleClass="btn-primary" prefHeight="40">
                            <graphic>
                                <HBox alignment="CENTER" spacing="8">
                                    <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" style="-fx-fill: white;" scaleX="0.8" scaleY="0.8"/>
                                    <Text fx:id="editBtnText" text="Edit" style="-fx-fill: white; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>

                    <GridPane hgap="20" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="50" />
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="50" />
                        </columnConstraints>

                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="FULL NAME" styleClass="subtitle" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                            <TextField fx:id="nameField" styleClass="text-field" prefHeight="45" disable="true"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="EMAIL ADDRESS" styleClass="subtitle" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                            <TextField fx:id="emailField" styleClass="text-field" prefHeight="45" disable="true"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="PHONE NUMBER" styleClass="subtitle" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                            <TextField fx:id="phoneField" styleClass="text-field" prefHeight="45" disable="true"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="PASSENGERS" styleClass="subtitle" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                            <Spinner fx:id="passengerSpinner" prefWidth="Infinity" prefHeight="45" disable="true"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <Separator/>

                <!-- Preferences -->
                <VBox spacing="20">
                    <Text text="BOOKING PREFERENCES" style="-fx-font-weight: bold; -fx-fill: -fx-gv-text-primary; -fx-font-size: 14;"/>
                    
                    <GridPane hgap="20" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="33" />
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="33" />
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="34" />
                        </columnConstraints>

                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Travel Class" styleClass="subtitle" style="-fx-font-size: 11;"/>
                            <Text fx:id="travelClassText" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-fill: -fx-gv-text-primary;" text="Economy"/>
                        </VBox>

                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Seat Preference" styleClass="subtitle" style="-fx-font-size: 11;"/>
                            <Text fx:id="seatPrefText" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-fill: -fx-gv-text-primary;" text="Window"/>
                        </VBox>

                        <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label text="Payment Method" styleClass="subtitle" style="-fx-font-size: 11;"/>
                            <Text fx:id="paymentText" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-fill: -fx-gv-text-primary;" text="Credit Card"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <Separator/>

                <!-- Price -->
                <HBox alignment="CENTER" style="-fx-background-color: #f0fdf4; -fx-padding: 20; -fx-background-radius: 10;">
                    <Text text="Total Amount" styleClass="subtitle" style="-fx-font-size: 14;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Text fx:id="totalPrice" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-fill: #50C878;" text="0 DT"/>
                </HBox>

                <!-- Action Buttons -->
                <VBox spacing="15" alignment="CENTER">
                    <HBox spacing="15" alignment="CENTER" fx:id="editModeButtons" visible="false" managed="false">
                        <Button onAction="#handleUpdate" styleClass="btn-success" prefHeight="50" prefWidth="200">
                            <graphic>
                                <HBox alignment="CENTER" spacing="10">
                                    <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" style="-fx-fill: #013220;" scaleX="1.2" scaleY="1.2"/>
                                    <Text text="UPDATE" style="-fx-fill: #013220; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Button>
                        <Button onAction="#toggleEditMode" style="-fx-background-color: #8D99AE;" prefHeight="50" prefWidth="200">
                            <graphic>
                                <HBox alignment="CENTER" spacing="10">
                                    <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" style="-fx-fill: white;" scaleX="1.2" scaleY="1.2"/>
                                    <Text text="CANCEL" style="-fx-fill: white; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER">
                        <Button onAction="#handleDelete" styleClass="btn-danger" prefHeight="50" prefWidth="250">
                            <graphic>
                                <HBox alignment="CENTER" spacing="10">
                                    <SVGPath content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" style="-fx-fill: white;" scaleX="1.2" scaleY="1.2"/>
                                    <Text text="CANCEL BOOKING" style="-fx-fill: white; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Button>
                        
                        <Button onAction="#handleBack" styleClass="icon-btn" prefWidth="80" prefHeight="50">
                            <graphic>
                                <HBox alignment="CENTER" spacing="8">
                                    <SVGPath content="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" style="-fx-fill: #8D99AE;" scaleX="1.2" scaleY="1.2"/>
                                    <Text text="Back" style="-fx-fill: #8D99AE;"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>
    
    <!-- Loading Overlay -->
    <StackPane fx:id="loadingOverlay" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.5);">
        <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 15;">
            <ProgressIndicator prefWidth="60" prefHeight="60"/>
            <Text text="Processing..." style="-fx-font-size: 16; -fx-font-weight: bold; -fx-fill: -fx-gv-text-primary;"/>
        </VBox>
    </StackPane>
</StackPane>
