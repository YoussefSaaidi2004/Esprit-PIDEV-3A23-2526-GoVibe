<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.CheckoutFormController"
            stylesheets="@../styles.css">

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 40;">
            <VBox maxWidth="600" spacing="15" styleClass="form-container" style="-fx-padding: 30; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0); -fx-background-radius: 10;">
                
                <Text fx:id="formTitle" text="Add New Checkout" styleClass="label-section" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                
                <Separator/>
                
                <GridPane vgap="15" hgap="20">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0"/>
                    </columnConstraints>

                    <!-- Row 0 -->
                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Flight ID *" styleClass="label"/>
                        <ComboBox fx:id="cmbFlightId" promptText="Select Flight ID" maxWidth="Infinity"/>
                    </VBox>
                    
                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="User ID *" styleClass="label"/>
                        <TextField fx:id="txtUserId" promptText="User ID"/>
                    </VBox>

                    <!-- Row 1 -->
                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Number of Passengers *" styleClass="label"/>
                        <TextField fx:id="txtPassengers" promptText="e.g., 2"/>
                    </VBox>
                    
                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Status *" styleClass="label"/>
                        <ComboBox fx:id="cmbStatus" promptText="Select status" maxWidth="Infinity">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="PENDING"/>
                                    <String fx:value="CONFIRMED"/>
                                    <String fx:value="CANCELLED"/>
                                    <String fx:value="COMPLETED"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>

                    <!-- Row 2 -->
                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Total Price (DT) *" styleClass="label"/>
                        <TextField fx:id="txtTotalPrice" promptText="Total price"/>
                    </VBox>
                    
                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Reservation Date" styleClass="label"/>
                        <TextField fx:id="txtReservationDate" promptText="Auto-generated" editable="false" style="-fx-background-color: #F5F5F5;"/>
                    </VBox>
                </GridPane>
                
                <Separator/>
                
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Button fx:id="btnCancel" text="❌ Cancel" styleClass="button, btn-cancel" 
                            onAction="#handleCancel"/>
                    <Button fx:id="btnSave" text="✅ Save" styleClass="button, btn-save" 
                            onAction="#handleSave"/>
                </HBox>
                
            </VBox>
        </VBox>
    </center>

</BorderPane>
