<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.CheckoutManagementController"
      stylesheets="@../styles/unified-styles.css"
      styleClass="main-bg">
    
    <!-- Sidebar -->
    <fx:include source="../org/example/AdminSidebar.fxml" fx:id="adminSidebar"/>

    <!-- Main Content -->
    <StackPane fx:id="rootStackPane" HBox.hgrow="ALWAYS" minWidth="0">
            <!-- Background Hero Image -->
            <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" />
            <Region style="-fx-background-color: rgba(245, 243, 231, 0.7);" />
            
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox spacing="20" style="-fx-padding: 24;">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Text text="Reservations Tracking" styleClass="title" style="-fx-fill: #013220; -fx-font-size: 22px;"/>
                        <Text text="Monitor and moderate all passenger bookings" styleClass="subtitle" style="-fx-fill: #5a7d6e; -fx-font-size: 13px;"/>
                    </VBox>
                    <HBox spacing="10" alignment="CENTER">
                         <Button onAction="#handleRefresh" styleClass="icon-btn" style="-fx-background-color: rgba(80, 200, 120, 0.1); -fx-background-radius: 50;">
                            <graphic><Text text="🔄" style="-fx-font-size: 18px; -fx-fill: #50C878;"/></graphic>
                        </Button>
                    </HBox>
                </HBox>

                <FlowPane fx:id="checkoutGrid" hgap="20" vgap="20" alignment="TOP_LEFT" style="-fx-padding: 10 0;"/>

                    </VBox>
                </content>
            </ScrollPane>
    </StackPane>
</HBox>
