<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:id="rootPane"
           fx:controller="org.example.controllers.BookingController"
           stylesheets="@../styles/unified-styles.css"
           styleClass="main-bg">
    
    <HBox spacing="0" VBox.vgrow="ALWAYS">
        <!-- Sidebar -->
        <VBox prefWidth="240" spacing="10" alignment="TOP_CENTER"
              style="-fx-background-color: #013220; -fx-padding: 24 16;">
            <VBox alignment="CENTER" spacing="6">
                <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
                         style="-fx-fill: #A0E0C9;" scaleX="1.1" scaleY="1.1"/>
                <Text text="GoVibe" style="-fx-fill: #D1F2EB; -fx-font-size: 18; -fx-font-weight: bold;"/>
                <Text text="Espace client" style="-fx-fill: #A0E0C9; -fx-font-size: 10;"/>
            </VBox>

            <Region prefHeight="8"/>

            <Button onAction="#handleHome" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 10 14; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <SVGPath content="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"
                                 style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
                        <Text text="Accueil" style="-fx-fill: #A0E0C9;"/>
                    </HBox>
                </graphic>
            </Button>

            <Button onAction="#handleFlights" maxWidth="Infinity"
                    style="-fx-background-color: rgba(80,200,120,0.2); -fx-text-fill: #D1F2EB; -fx-font-size: 14px; -fx-padding: 10 14; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
                                 style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
                        <Text text="Vols" style="-fx-fill: #D1F2EB;"/>
                    </HBox>
                </graphic>
            </Button>

            <Button onAction="#handleLocations" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 10 14; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <SVGPath content="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"
                                 style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
                        <Text text="Locations" style="-fx-fill: #A0E0C9;"/>
                    </HBox>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Button onAction="#handleLogout" maxWidth="Infinity"
                    style="-fx-background-color: rgba(231,76,60,0.15); -fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-padding: 10 14; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <SVGPath content="M16 13v-2H7V8l-5 4 5 4v-3zM20 3H9c-1.1 0-2 .9-2 2v3h2V5h11v14H9v-3H7v3c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"
                                 style="-fx-fill: #e74c3c;" scaleX="0.9" scaleY="0.9"/>
                        <Text text="Deconnexion" style="-fx-fill: #e74c3c;"/>
                    </HBox>
                </graphic>
            </Button>
        </VBox>

        <!-- Main Content -->
        <VBox spacing="0" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="0" alignment="TOP_CENTER" styleClass="form-container">
                    <VBox styleClass="form-card" spacing="35" maxWidth="700">
                <!-- Header -->
                <BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.CheckoutController"
            stylesheets="@../styles.css"
            styleClass="glass-pane-premium"
            style="-fx-background-color: transparent;">

    <top>
        <VBox spacing="25" style="-fx-padding: 40 40 20 40;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <StackPane style="-fx-background-color: rgba(80, 200, 120, 0.2); -fx-background-radius: 12; -fx-padding: 12;">
                    <SVGPath content="M5 2c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2H5zm0 2h14v16H5V4zm2 2v2h10V6H7zm0 4v2h10v-2H7zm0 4v2h10v-2H7z" 
                             styleClass="svg-icon-emerald" scaleX="1.5" scaleY="1.5"/>
                </StackPane>
                <VBox>
                    <Text text="Reservations Ledger" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 2);"/>
                    <Text text="Manage and track all customer bookings" style="-fx-font-size: 14px; -fx-fill: rgba(255,255,255,0.7);"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="12">
                    <Button onAction="#handleRefresh" styleClass="btn-secondary" 
                            style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 12 20;">
                        <graphic>
                            <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" 
                                     styleClass="svg-icon-white"/>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="glass-pane-premium" style="-fx-padding: 15; -fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 15;">
                <StackPane style="-fx-padding: 0 0 0 10;">
                    <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                             styleClass="svg-icon-white" opacity="0.6"/>
                </StackPane>
                <TextField fx:id="searchField" promptText="Filter by passenger name, destination or status..." HBox.hgrow="ALWAYS" 
                           style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4); -fx-font-size: 14;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0 40 40 40;">
            <FlowPane fx:id="checkoutContainer" hgap="25" vgap="25" alignment="TOP_LEFT">
                <!-- Checkout cards will be loaded here -->
            </FlowPane>
        </ScrollPane>
    </center>

</BorderPane>
                <VBox spacing="10" alignment="CENTER">
                    <HBox alignment="CENTER" spacing="15">
                        <SVGPath content="M19.5 6h-15c-.83 0-1.5.67-1.5 1.5v3c0 .55.45 1 1 1s1 .45 1 1-.45 1-1 1v3c0 .83.67 1.5 1.5 1.5h15c.83 0 1.5-.67 1.5-1.5v-3c0-.55-.45-1-1-1s-1-.45-1-1 .45-1 1-1v-3c0-.83-.67-1.5-1.5-1.5z" style="-fx-fill: #50C878;" scaleX="2.0" scaleY="2.0"/>
                        <Text text="Complete Your Booking" styleClass="title"/>
                    </HBox>
                    <Text text="Please fill in your details to confirm your flight reservation" styleClass="subtitle"/>
                </VBox>

                <!-- Flight Summary -->
                <VBox spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12;">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" style="-fx-fill: #50C878;" scaleX="1.5" scaleY="1.5"/>
                        <VBox VBox.vgrow="ALWAYS">
                            <Text fx:id="flightRoute" style="-fx-font-weight: bold; -fx-font-size: 20;-fx-fill: -fx-gv-text-primary;" text="Loading..."/>
                            <Text fx:id="flightDetails" styleClass="subtitle" style="-fx-font-size: 13;" text="Flight details"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Passenger Details Section -->
                <VBox spacing="20">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" style="-fx-fill: #50C878;" scaleX="1.2" scaleY="1.2"/>
                        <Text text="PASSENGER INFORMATION" style="-fx-font-weight: bold; -fx-fill: -fx-gv-text-primary; -fx-font-size: 14;"/>
                    </HBox>
                    
                    <GridPane hgap="20" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="50" />
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="50" />
                        </columnConstraints>

                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="FULL NAME *" styleClass="subtitle" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                            <TextField fx:id="nameField" promptText="John Doe" styleClass="text-field" prefHeight="45"/>
                            <Text fx:id="nameError" style="-fx-fill: #EF476F; -fx-font-size: 11;" visible="false" text="Name is required"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="EMAIL ADDRESS *" styleClass="subtitle" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                            <TextField fx:id="emailField" promptText="john.doe@example.com" styleClass="text-field" prefHeight="45"/>
                            <Text fx:id="emailError" style="-fx-fill: #EF476F; -fx-font-size: 11;" visible="false" text="Valid email required"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="PHONE NUMBER *" styleClass="subtitle" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                            <TextField fx:id="phoneField" promptText="+216-12-345-678" styleClass="text-field" prefHeight="45"/>
                            <Text fx:id="phoneError" style="-fx-fill: #EF476F; -fx-font-size: 11;" visible="false" text="Valid phone required"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="PASSENGERS" styleClass="subtitle" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                            <Spinner fx:id="passengerSpinner" prefWidth="Infinity" prefHeight="45" editable="true" styleClass="text-field"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <Separator/>

                <!-- Travel Preferences Section -->
                <VBox spacing="20">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <SVGPath content="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.57 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" style="-fx-fill: #50C878;" scaleX="1.2" scaleY="1.2"/>
                        <Text text="TRAVEL PREFERENCES" style="-fx-font-weight: bold; -fx-fill: -fx-gv-text-primary; -fx-font-size: 14;"/>
                    </HBox>

                    <GridPane hgap="20" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="50" />
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="50" />
                        </columnConstraints>

                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="TRAVEL CLASS" styleClass="subtitle" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                            <ComboBox fx:id="classCombo" prefWidth="Infinity" prefHeight="45" promptText="Select Class"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="PAYMENT METHOD" styleClass="subtitle" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                            <ComboBox fx:id="paymentCombo" prefWidth="Infinity" prefHeight="45" promptText="Select Payment"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                            <Label text="SEAT PREFERENCE" styleClass="subtitle" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                            <HBox spacing="15">
                                <ToggleButton fx:id="windowBtn" text="WINDOW SEAT" styleClass="nav-button" prefWidth="250" prefHeight="50" style="-fx-alignment: center; -fx-font-size: 13;">
                                    <graphic><SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-8-2h2v-2h-2v2zm0-4h2v-2h-2v2zm0-4h2V7h-2v2zm-4 8h2v-2H7v2zm0-4h2v-2H7v2zm0-4h2V7H7v2zm8 8h2v-2h-2v2zm0-4h2v-2h-2v2zm0-4h2V7h-2v2z" style="-fx-fill: #566573;" scaleX="0.8" scaleY="0.8"/></graphic> 
                                </ToggleButton>
                                <ToggleButton fx:id="aisleBtn" text="AISLE SEAT" styleClass="nav-button" prefWidth="250" prefHeight="50" style="-fx-alignment: center; -fx-font-size: 13;">
                                    <graphic><SVGPath content="M7 19c-1.1 0-2-.9-2-2h14c0 1.1-.9 2-2 2H7zM15 3H5c-1.1 0-2 .9-2 2v9h10V3zm2 0v9h2V5c0-1.1-.9-2-2-2zm-2 11H5l-2 5h14l-2-5z" style="-fx-fill: #566573;" scaleX="0.8" scaleY="0.8"/></graphic> 
                                </ToggleButton>
                            </HBox>
                        </VBox>
                    </GridPane>
                </VBox>

                <Separator/>

                <!-- Price Summary -->
                <HBox alignment="CENTER" style="-fx-background-color: #f0fdf4; -fx-padding: 20; -fx-background-radius: 10;">
                    <VBox alignment="CENTER_LEFT">
                        <Text text="Total Amount" styleClass="subtitle" style="-fx-font-size: 14;"/>
                        <Text text="Including all taxes and fees" styleClass="subtitle" style="-fx-font-size: 11;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Text fx:id="totalPrice" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-fill: #50C878;" text="0 DT"/>
                </HBox>

                <!-- Action Buttons -->
                <VBox spacing="15" alignment="CENTER">
                    <Button fx:id="confirmBtn" onAction="#handleConfirm" styleClass="btn-success" prefHeight="55" prefWidth="400">
                        <graphic>
                            <HBox alignment="CENTER" spacing="12">
                                <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" style="-fx-fill: #013220;" scaleX="1.2" scaleY="1.2"/>
                                <Text text="CONFIRM BOOKING" style="-fx-fill: #013220; -fx-font-weight: bold; -fx-font-size: 14;"/>
                            </HBox>
                        </graphic>
                    </Button>
                    
                    <Button onAction="#handleBack" styleClass="icon-btn" prefWidth="80" prefHeight="45" alignment="CENTER">
                        <graphic>
                            <HBox alignment="CENTER" spacing="8">
                                <SVGPath content="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" style="-fx-fill: #8D99AE;" scaleX="1.0" scaleY="1.0"/>
                                <Text text="Back" style="-fx-fill: #8D99AE;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </HBox>
    
    <!-- Loading Overlay -->
    <StackPane fx:id="loadingOverlay" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.5);">
        <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 15;">
            <ProgressIndicator prefWidth="60" prefHeight="60"/>
            <Text text="Processing your booking..." style="-fx-font-size: 16; -fx-font-weight: bold; -fx-fill: -fx-gv-text-primary;"/>
        </VBox>
    </StackPane>
</StackPane>
