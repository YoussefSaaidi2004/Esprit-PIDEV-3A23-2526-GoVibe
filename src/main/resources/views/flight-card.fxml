<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.example.gestionvol.controller.FlightCardController"
      styleClass="interactive-card" spacing="15" prefWidth="320" style="-fx-padding: 20;">
    
    <!-- Header with Status Badge -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" style="-fx-fill: #2E8B57;" scaleX="1.2" scaleY="1.2"/>
        <VBox HBox.hgrow="ALWAYS">
            <Text fx:id="routeText" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-fill: #117864;" text="TUNIS → DUBAI"/>
            <Text fx:id="airlineText" styleClass="subtitle" style="-fx-font-size: 11;" text="GoVibe Air"/>
        </VBox>
        <HBox fx:id="statusBadge" styleClass="badge" alignment="CENTER" style="-fx-padding: 5 10; -fx-background-radius: 15;">
            <Text fx:id="statusText" style="-fx-font-size: 9; -fx-font-weight: bold;" text="ON TIME"/>
        </HBox>
    </HBox>

    <!-- Flight Details -->
    <VBox spacing="10">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z M12.5 7H11v6l5.25 3.15.75-1.23-4.5-2.67z" style="-fx-fill: #566573;"/>
            <Text fx:id="timeText" styleClass="subtitle" text="10:30 - 20:30"/>
        </HBox>
        
        <HBox spacing="10" alignment="CENTER_LEFT">
            <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" style="-fx-fill: #566573;"/>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Text fx:id="seatsText" styleClass="subtitle" style="-fx-font-size: 12;" text="45/180 seats"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Text fx:id="occupancyText" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-fill: #2E8B57;" text="75%"/>
                </HBox>
                <!-- Occupancy Progress Bar -->
                <ProgressBar fx:id="occupancyBar" prefWidth="200" prefHeight="6" styleClass="progress-bar" progress="0.75"/>
            </VBox>
        </HBox>
        
        <HBox spacing="10" alignment="CENTER_LEFT">
            <SVGPath content="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" style="-fx-fill: #D35400;"/>
            <Text fx:id="classText" styleClass="subtitle" text="Economy"/>
        </HBox>
    </VBox>

    <Separator style="-fx-background-color: #D1F2EB; -fx-padding: 0;"/>

    <!-- Revenue/Price Section -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Text text="TICKET PRICE" style="-fx-font-size: 9; -fx-font-weight: bold; -fx-fill: #8D99AE;"/>
            <HBox spacing="5" alignment="BASELINE_LEFT">
                <SVGPath content="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12.29,18.09V20h-2.67v-1.93c-1.71-0.36-3.15-1.46-3.27-3.4h1.96c0.1,1.05,1.18,1.91,2.53,1.91c1.29,0,2.13-0.72,2.13-1.55c0-0.8-0.68-1.38-2.6-1.92c-2-0.57-4.14-1.23-4.14-3.79c0-2.02,1.38-3.32,3.39-3.79V3.5h2.67v1.93c1.45,0.32,2.77,1.21,3.11,2.97h-1.96c-0.19-0.96-0.99-1.57-2.18-1.57c-1.28,0-2.06,0.73-2.06,1.48c0,0.85,0.7,1.42,2.71,1.95c2.19,0.58,4.03,1.35,4.03,3.74C15.6,15.93,14.35,17.73,12.29,18.09z" style="-fx-fill: #2E8B57;" scaleX="0.9" scaleY="0.9"/>
                <Text fx:id="priceText" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-fill: #50C878;" text="1,000"/>
                <Text text="DT" style="-fx-font-size: 12; -fx-fill: #013220;"/>
            </HBox>
        </VBox>
        
        <!-- Revenue estimate for admin -->
        <VBox fx:id="revenueBox" spacing="2" alignment="TOP_RIGHT" visible="false" managed="false">
            <Text text="EST. REVENUE" style="-fx-font-size: 9; -fx-font-weight: bold; -fx-fill: #8D99AE;"/>
            <Text fx:id="revenueText" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-fill: #013220;" text="135,000 DT"/>
        </VBox>
    </HBox>

    <Separator style="-fx-background-color: #D1F2EB; -fx-padding: 0;"/>

    <!-- Action Buttons -->
    <HBox fx:id="actionBox" alignment="CENTER" spacing="10">
        <!-- Buttons will be injected here dynamically -->
    </HBox>
</VBox>
