<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.FlightListController"
            stylesheets="@../styles.css"
            styleClass="glass-pane-premium"
            style="-fx-background-color: transparent;">

    <top>
        <VBox spacing="25" style="-fx-padding: 40 40 20 40;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <StackPane style="-fx-background-color: rgba(80, 200, 120, 0.2); -fx-background-radius: 12; -fx-padding: 12;">
                    <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" 
                             styleClass="svg-icon-emerald" scaleX="1.5" scaleY="1.5"/>
                </StackPane>
                <VBox>
                    <Text text="Global Flights Fleet" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 2);"/>
                    <Text text="Real-time airline schedule and availability" style="-fx-font-size: 14px; -fx-fill: rgba(255,255,255,0.7);"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="12">
                    <Button onAction="#handleAddFlight" styleClass="btn-primary" 
                            style="-fx-background-color: #50C878; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 12 25; -fx-font-weight: 900;">
                        <graphic>
                            <HBox spacing="8" alignment="CENTER">
                                <SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" styleClass="svg-icon-white"/>
                                <Text text="ADD FLIGHT" style="-fx-fill: white; -fx-font-weight: 900; -fx-font-size: 12;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="glass-pane-premium" style="-fx-padding: 15; -fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 15;">
                <StackPane style="-fx-padding: 0 0 0 10;">
                    <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                             styleClass="svg-icon-white" opacity="0.6"/>
                </StackPane>
                <TextField fx:id="searchField" promptText="Search by airline, route or status..." HBox.hgrow="ALWAYS" 
                           style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4); -fx-font-size: 14;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center: Cards ScrollPane -->
    <center>
        <StackPane fx:id="flightCenterStack" style="-fx-padding: 15px;">
            <ScrollPane fitToWidth="true" styleClass="cards-scroll">
                <content>
                    <FlowPane fx:id="cardsFlow" hgap="20" vgap="20" prefWrapLength="1000" alignment="TOP_CENTER" style="-fx-padding: 20;">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                    </FlowPane>
                </content>
            </ScrollPane>
        </StackPane>
    </center>

</BorderPane>

