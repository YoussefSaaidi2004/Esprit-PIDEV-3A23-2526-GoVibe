<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.FlightManagementController"
            stylesheets="@../styles/unified-styles.css"
            styleClass="main-bg">
    
    <left>
        <fx:include source="../org/example/AdminSidebar.fxml" fx:id="adminSidebar"/>
    </left>

    <center>
        <StackPane fx:id="rootStackPane">
            <!-- Background Hero Image -->
            <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" />
            <Region style="-fx-background-color: rgba(245, 243, 231, 0.7);" />
            
            <VBox spacing="25" style="-fx-padding: 40;">
                <!-- Header Section -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Text text="Flight Management" styleClass="title" style="-fx-fill: #013220;"/>
                        <Text text="Create, update, or remove flights from the system" styleClass="subtitle" style="-fx-fill: #5a7d6e;"/>
                    </VBox>
                    <HBox spacing="15" alignment="CENTER">
                        <Button onAction="#handleCheckouts" prefHeight="45" 
                                style="-fx-background-color: rgba(255, 255, 255, 0.6); -fx-text-fill: #013220; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-border-color: rgba(1, 50, 32, 0.1); -fx-border-width: 1;">
                            <graphic>
                                <HBox spacing="10" alignment="CENTER">
                                    <SVGPath content="M19.5 6h-15c-.83 0-1.5.67-1.5 1.5v3c0 .55.45 1 1 1s1 .45 1 1-.45 1-1 1v3c0 .83.67 1.5 1.5 1.5h15c.83 0 1.5-.67 1.5-1.5v-3c0-.55-.45-1-1-1s-1-.45-1-1 .45-1 1-1v-3c0-.83-.67-1.5-1.5-1.5z"
                                             style="-fx-fill: #013220;" scaleX="0.8" scaleY="0.8"/>
                                    <Text text="Voir Checkouts" style="-fx-fill: #013220; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Button>
                        <Button onAction="#handleAdd" styleClass="btn-success" prefHeight="45" style="-fx-background-radius: 25; -fx-padding: 0 25; -fx-effect: dropshadow(gaussian, rgba(80, 200, 120, 0.3), 10, 0, 0, 5);">
                             <tooltip><Tooltip text="Add New Flight"/></tooltip>
                            <graphic>
                                <HBox spacing="10" alignment="CENTER">
                                    <Text text="➕" style="-fx-font-size: 16px; -fx-fill: white;"/>
                                    <Text text="AJOUTER" style="-fx-fill: white; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                </HBox>

                <!-- Quick Stats -->
                <HBox spacing="25" alignment="CENTER_LEFT">
                    <VBox spacing="6" styleClass="glass-card" style="-fx-padding: 20 30; -fx-background-radius: 20; -fx-min-width: 200;">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" style="-fx-fill: #013220;" scaleX="1.3" scaleY="1.3"/>
                            <Text fx:id="totalFlightsText" text="0" style="-fx-font-size: 28; -fx-font-weight: 900; -fx-fill: #013220;"/>
                        </HBox>
                        <Text text="TOTAL FLIGHTS" style="-fx-font-size: 11; -fx-fill: #8D99AE; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
                    </VBox>
                    
                    <VBox spacing="6" styleClass="glass-card" style="-fx-padding: 20 30; -fx-background-radius: 20; -fx-min-width: 200;">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" style="-fx-fill: #50C878;" scaleX="1.3" scaleY="1.3"/>
                            <Text fx:id="totalSeatsText" text="0" style="-fx-font-size: 28; -fx-font-weight: 900; -fx-fill: #50C878;"/>
                        </HBox>
                        <Text text="AVAILABLE SEATS" style="-fx-font-size: 11; -fx-fill: #8D99AE; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
                    </VBox>
                    
                    <VBox spacing="6" styleClass="glass-card" style="-fx-padding: 20 30; -fx-background-radius: 20; -fx-min-width: 200;">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <SVGPath content="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12.29,18.09V20h-2.67v-1.93c-1.71-0.36-3.15-1.46-3.27-3.4h1.96c0.1,1.05,1.18,1.91,2.53,1.91c1.29,0,2.13-0.72,2.13-1.55c0-0.8-0.68-1.38-2.6-1.92c-2-0.57-4.14-1.23-4.14-3.79c0-2.02,1.38-3.32,3.39-3.79V3.5h2.67v1.93c1.45,0.32,2.77,1.21,3.11,2.97h-1.96c-0.19-0.96-0.99-1.57-2.18-1.57c-1.28,0-2.06,0.73-2.06,1.48c0,0.85,0.7,1.42,2.71,1.95c2.19,0.58,4.03,1.35,4.03,3.74C15.6,15.93,14.35,17.73,12.29,18.09z" style="-fx-fill: #013220;" scaleX="1.3" scaleY="1.3"/>
                            <Text fx:id="avgPriceText" text="0 DT" style="-fx-font-size: 28; -fx-font-weight: 900; -fx-fill: #013220;"/>
                        </HBox>
                        <Text text="AVG. TICKET PRICE" style="-fx-font-size: 11; -fx-fill: #8D99AE; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
                    </VBox>
                </HBox>

                <!-- Filter Bar -->
                <HBox spacing="20" alignment="CENTER_LEFT" styleClass="glass-card" style="-fx-padding: 15 30; -fx-background-radius: 40;">
                    <HBox spacing="15" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <Text text="🔍" style="-fx-font-size: 18px; -fx-fill: #8D99AE;"/>
                        <TextField fx:id="searchField" promptText="Search flights, airlines, destinations..." 
                                   style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 14;" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    
                    <Separator orientation="VERTICAL" style="-fx-opacity: 0.2;"/>
                    
                    <HBox spacing="10" alignment="CENTER">
                        <Text text="SORT BY" style="-fx-font-size: 10; -fx-fill: #8D99AE; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="sortCombo" promptText="Select sort..." prefWidth="180" 
                                  style="-fx-background-color: rgba(255, 255, 255, 0.5); -fx-background-radius: 20;"/>
                    </HBox>
                    
                    <Button onAction="#handleRefresh" styleClass="icon-btn" style="-fx-background-color: rgba(80, 200, 120, 0.1); -fx-background-radius: 50;">
                        <graphic><Text text="🔄" style="-fx-font-size: 18px; -fx-fill: #50C878;"/></graphic>
                    </Button>
                </HBox>

                <!-- Flights Grid -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
                    <FlowPane fx:id="flightGrid" hgap="30" vgap="30" alignment="TOP_LEFT" style="-fx-padding: 10 0;"/>
                </ScrollPane>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
