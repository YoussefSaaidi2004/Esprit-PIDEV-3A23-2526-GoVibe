<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.FlightManagementController"
            stylesheets="@../styles/unified-styles.css, @../styles.css"
            styleClass="main-bg">

    <left>
        <fx:include source="../org/example/AdminSidebar.fxml" fx:id="adminSidebar"/>
    </left>

    <center>
        <StackPane fx:id="rootStackPane">
            <!-- Blurred hero bg image (bound/loaded by controller) -->
            <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" />
            <!-- Semi-transparent dark overlay so the image shows through -->
            <Region style="-fx-background-color: linear-gradient(to bottom right, rgba(0,8,4,0.58) 0%, rgba(1,20,11,0.52) 40%, rgba(1,30,16,0.60) 100%);" />

            <VBox spacing="28" style="-fx-padding: 40;">

                <!-- ── Hero Header ── -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <StackPane style="-fx-background-color: rgba(80,200,120,0.18); -fx-background-radius: 16; -fx-padding: 14; -fx-effect: dropshadow(gaussian, rgba(80,200,120,0.45), 20, 0, 0, 0);">
                        <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
                                 style="-fx-fill: #50C878;" scaleX="1.4" scaleY="1.4"/>
                    </StackPane>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Text text="Flight Management"
                              style="-fx-font-size: 30px; -fx-font-weight: 900; -fx-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 12, 0, 0, 2);"/>
                        <Text text="Create, update, or remove flights from the system"
                              style="-fx-font-size: 14px; -fx-fill: rgba(180,230,210,0.72);"/>
                    </VBox>
                    <HBox spacing="14" alignment="CENTER">
                        <!-- Checkouts ghost button -->
                        <Button onAction="#handleCheckouts" prefHeight="48"
                                style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 14; -fx-border-color: rgba(255,255,255,0.22); -fx-border-width: 1.5; -fx-border-radius: 14; -fx-padding: 10 22; -fx-cursor: hand;">
                            <graphic>
                                <HBox spacing="10" alignment="CENTER">
                                    <SVGPath content="M19.5 6h-15c-.83 0-1.5.67-1.5 1.5v3c0 .55.45 1 1 1s1 .45 1 1-.45 1-1 1v3c0 .83.67 1.5 1.5 1.5h15c.83 0 1.5-.67 1.5-1.5v-3c0-.55-.45-1-1-1s-1-.45-1-1 .45-1 1-1v-3c0-.83-.67-1.5-1.5-1.5z"
                                             style="-fx-fill: rgba(180,230,210,0.88);" scaleX="0.85" scaleY="0.85"/>
                                    <Text text="Voir Checkouts" style="-fx-fill: rgba(220,250,235,0.92); -fx-font-weight: 700; -fx-font-size: 13;"/>
                                </HBox>
                            </graphic>
                        </Button>
                        <!-- ADD FLIGHT – glowing emerald -->
                        <Button onAction="#handleAdd" prefHeight="48"
                                style="-fx-background-color: linear-gradient(to bottom right, #50C878, #2e9952); -fx-background-radius: 14; -fx-border-width: 0; -fx-padding: 10 28; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(80,200,120,0.65), 22, 0, 0, 5);">
                            <tooltip><Tooltip text="Add New Flight (Ctrl+N)"/></tooltip>
                            <graphic>
                                <HBox spacing="10" alignment="CENTER">
                                    <SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" style="-fx-fill: white;" scaleX="1.1" scaleY="1.1"/>
                                    <Text text="AJOUTER" style="-fx-fill: white; -fx-font-weight: 900; -fx-font-size: 13;"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                </HBox>

                <!-- ── Stats Tiles ── -->
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(255,255,255,0.07); -fx-background-radius: 20; -fx-border-color: rgba(80,200,120,0.28); -fx-border-width: 1.5; -fx-border-radius: 20; -fx-padding: 22 28; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 20, 0, 0, 8); -fx-min-width: 200;">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: rgba(80,200,120,0.15); -fx-background-radius: 10; -fx-padding: 9;">
                                <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" style="-fx-fill: #50C878;" scaleX="1.2" scaleY="1.2"/>
                            </StackPane>
                            <Text fx:id="totalFlightsText" text="0"
                                  style="-fx-font-size: 34; -fx-font-weight: 900; -fx-fill: #50C878; -fx-effect: dropshadow(gaussian, rgba(80,200,120,0.55), 10, 0, 0, 1);"/>
                        </HBox>
                        <Text text="TOTAL FLIGHTS" style="-fx-font-size: 10; -fx-fill: rgba(180,220,200,0.65); -fx-font-weight: 800;"/>
                    </VBox>

                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(255,255,255,0.07); -fx-background-radius: 20; -fx-border-color: rgba(80,200,120,0.28); -fx-border-width: 1.5; -fx-border-radius: 20; -fx-padding: 22 28; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 20, 0, 0, 8); -fx-min-width: 200;">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: rgba(80,200,120,0.15); -fx-background-radius: 10; -fx-padding: 9;">
                                <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" style="-fx-fill: #50C878;" scaleX="1.2" scaleY="1.2"/>
                            </StackPane>
                            <Text fx:id="totalSeatsText" text="0"
                                  style="-fx-font-size: 34; -fx-font-weight: 900; -fx-fill: #50C878; -fx-effect: dropshadow(gaussian, rgba(80,200,120,0.55), 10, 0, 0, 1);"/>
                        </HBox>
                        <Text text="AVAILABLE SEATS" style="-fx-font-size: 10; -fx-fill: rgba(180,220,200,0.65); -fx-font-weight: 800;"/>
                    </VBox>

                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(255,255,255,0.07); -fx-background-radius: 20; -fx-border-color: rgba(80,200,120,0.28); -fx-border-width: 1.5; -fx-border-radius: 20; -fx-padding: 22 28; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 20, 0, 0, 8); -fx-min-width: 200;">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: rgba(80,200,120,0.15); -fx-background-radius: 10; -fx-padding: 9;">
                                <SVGPath content="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12.29,18.09V20h-2.67v-1.93c-1.71-0.36-3.15-1.46-3.27-3.4h1.96c0.1,1.05,1.18,1.91,2.53,1.91c1.29,0,2.13-0.72,2.13-1.55c0-0.8-0.68-1.38-2.6-1.92c-2-0.57-4.14-1.23-4.14-3.79c0-2.02,1.38-3.32,3.39-3.79V3.5h2.67v1.93c1.45,0.32,2.77,1.21,3.11,2.97h-1.96c-0.19-0.96-0.99-1.57-2.18-1.57c-1.28,0-2.06,0.73-2.06,1.48c0,0.85,0.7,1.42,2.71,1.95c2.19,0.58,4.03,1.35,4.03,3.74C15.6,15.93,14.35,17.73,12.29,18.09z" style="-fx-fill: #50C878;" scaleX="1.2" scaleY="1.2"/>
                            </StackPane>
                            <Text fx:id="avgPriceText" text="0 DT"
                                  style="-fx-font-size: 34; -fx-font-weight: 900; -fx-fill: #50C878; -fx-effect: dropshadow(gaussian, rgba(80,200,120,0.55), 10, 0, 0, 1);"/>
                        </HBox>
                        <Text text="AVG. TICKET PRICE" style="-fx-font-size: 10; -fx-fill: rgba(180,220,200,0.65); -fx-font-weight: 800;"/>
                    </VBox>
                </HBox>

                <!-- ── Search / Filter Bar ── -->
                <HBox spacing="16" alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(255,255,255,0.07); -fx-background-radius: 18; -fx-border-color: rgba(80,200,120,0.38); -fx-border-width: 1.5; -fx-border-radius: 18; -fx-padding: 4 18 4 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.32), 14, 0, 0, 5);">
                    <StackPane style="-fx-padding: 0 4 0 10;">
                        <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                 style="-fx-fill: rgba(80,200,120,0.65);" scaleX="0.9" scaleY="0.9"/>
                    </StackPane>
                    <TextField fx:id="searchField" promptText="Search flights, airlines, destinations..." HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: rgba(180,220,200,0.48); -fx-font-size: 14; -fx-border-width: 0; -fx-padding: 15 8;"/>
                    <Separator orientation="VERTICAL" style="-fx-background-color: rgba(255,255,255,0.18); -fx-pref-height: 28;"/>
                    <Text text="SORT BY" style="-fx-font-size: 9; -fx-fill: rgba(180,220,200,0.65); -fx-font-weight: 900;"/>
                    <ComboBox fx:id="sortCombo" prefWidth="185"
                              style="-fx-background-color: transparent; -fx-border-width: 0; -fx-text-fill: rgba(220,250,235,0.92); -fx-font-size: 13;"/>
                    <Button onAction="#handleRefresh"
                            style="-fx-background-color: rgba(80,200,120,0.15); -fx-background-radius: 50; -fx-border-color: rgba(80,200,120,0.42); -fx-border-width: 1.5; -fx-border-radius: 50; -fx-padding: 10; -fx-cursor: hand; -fx-min-width: 40; -fx-max-width: 40; -fx-min-height: 40; -fx-max-height: 40;">
                        <graphic>
                            <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                     style="-fx-fill: #50C878;" scaleX="0.9" scaleY="0.9"/>
                        </graphic>
                    </Button>
                </HBox>

                <!-- ── Flight Cards Grid ── -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0; -fx-border-width: 0;">
                    <FlowPane fx:id="flightGrid" hgap="24" vgap="24" alignment="TOP_LEFT"
                              style="-fx-padding: 8 4 24 4; -fx-background: transparent; -fx-background-color: transparent;"/>
                </ScrollPane>

            </VBox>
        </StackPane>
    </center>
</BorderPane>
