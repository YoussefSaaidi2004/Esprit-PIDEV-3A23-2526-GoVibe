<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.MyReservationsController"
            stylesheets="@../styles.css"
            style="-fx-background-color: transparent;">

    <top>
        <StackPane styleClass="header-glass">
            <fx:include source="../components/UserHeader.fxml"/>
        </StackPane>
    </top>

    <center>
        <StackPane>
            <!-- Background with Overlay -->
            <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" styleClass="premium-bg"/>
            <Region styleClass="premium-bg-overlay"/>

            <VBox spacing="0">
                <!-- Header with Back Button -->
                <HBox alignment="CENTER_LEFT" spacing="25" styleClass="glass-panel"
                      style="-fx-padding: 28 36; -fx-background-radius: 0 0 20 20;">
                    <VBox.margin>
                        <Insets bottom="30"/>
                    </VBox.margin>
                    
                    <!-- Back Button -->
                    <Button onAction="#handleBack" styleClass="lf-btn-secondary" style="-fx-padding: 8 16;">
                        <graphic>
                            <Label text="←" style="-fx-font-size: 20; -fx-text-fill: white;"/>
                        </graphic>
                    </Button>

                    <StackPane styleClass="icon-circle-emerald">
                        <Label text="🏨" style="-fx-font-size: 32;"/>
                    </StackPane>
                    
                    <VBox spacing="4">
                        <Label text="Mes Réservations Hôtels"
                               style="-fx-font-size: 30; -fx-font-weight: 900; -fx-text-fill: white;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 8, 0, 0, 2);"/>
                        <Label text="Consultez et gérez vos séjours réservés sur GoVibe." 
                               style="-fx-font-size: 14; -fx-text-fill: rgba(255,255,255,0.8);"/>
                    </VBox>
                    
                    <Region HBox.hgrow="ALWAYS"/>
                    
                    <!-- Stats -->
                    <HBox spacing="12" alignment="CENTER">
                        <VBox alignment="CENTER" spacing="4" styleClass="glass-tile-mini" prefWidth="120">
                            <Label fx:id="lblTotalReservations" text="0" styleClass="tile-value-emerald" style="-fx-font-size: 20;"/>
                            <Label text="RÉSERVATIONS" styleClass="tile-label-tiny"/>
                        </VBox>
                        <Button onAction="#loadReservations" styleClass="lf-btn-secondary" style="-fx-padding: 12; -fx-background-radius: 50;">
                            <graphic>
                                <Label text="↻" style="-fx-font-size: 18; -fx-text-fill: #50C878;"/>
                            </graphic>
                        </Button>
                    </HBox>
                </HBox>

                <!-- Grid of Reservations -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparent-scroll">
                    <content>
                        <VBox spacing="20">
                            <FlowPane fx:id="reservationsGrid" hgap="30" vgap="30" alignment="TOP_LEFT" style="-fx-padding: 0 50 50 50;">
                                <!-- Reservation cards go here -->
                            </FlowPane>
                            
                            <!-- Empty State -->
                            <VBox fx:id="emptyState" alignment="CENTER" spacing="20" visible="false" managed="false" style="-fx-padding: 100 0;">
                                <Label text="📭" style="-fx-font-size: 80; -fx-opacity: 0.3;"/>
                                <Label text="Aucune réservation trouvée" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="Vous n'avez pas encore réservé d'hôtel. Explorez nos offres!" style="-fx-text-fill: rgba(255,255,255,0.6);"/>
                                <Button text="Découvrir les hôtels" onAction="#handleBack" styleClass="lf-btn-primary"/>
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
