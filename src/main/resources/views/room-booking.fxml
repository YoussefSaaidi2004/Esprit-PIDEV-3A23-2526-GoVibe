<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<!-- 
  PAGE HÔTELS PROFESSIONNELLE
  Design moderne avec navigation commune et réservation de chambres
-->

<StackPane fx:id="rootStackPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controllers.RoomBookingController" stylesheets="@../styles.css">
    
    <!-- Background Image with Overlay -->
    <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" styleClass="premium-bg" />
    <Pane styleClass="premium-bg-overlay" mouseTransparent="true"/>
    
    <BorderPane fx:id="mainBorderPane" style="-fx-background-color: transparent;" prefHeight="900" prefWidth="1400">

        <!-- TOP HEADER -->
        <top>
            <StackPane styleClass="header-glass">
                <fx:include source="../components/UserHeader.fxml"/>
            </StackPane>
        </top>

        <!-- CENTRAL CONTENT -->
        <center>
            <ScrollPane fitToWidth="true" styleClass="transparent-scroll" style="-fx-background-color: transparent;"
                        VBox.vgrow="ALWAYS" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox spacing="0" style="-fx-background-color: transparent;">
                        
                        <!-- ── Hero Header ── -->
                        <HBox alignment="CENTER_LEFT" spacing="25" styleClass="glass-panel"
                              style="-fx-padding: 28 36; -fx-background-radius: 20;">
                            <VBox.margin>
                                <Insets top="40" right="50" bottom="20" left="50"/>
                            </VBox.margin>
                            <StackPane styleClass="icon-circle-emerald">
                                <Label text="🏨" style="-fx-font-size: 32;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label text="Réservation d'Hôtels"
                                       style="-fx-font-size: 30; -fx-font-weight: 900; -fx-text-fill: white;
                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 8, 0, 0, 2);"/>
                                <Label text="Trouvez et réservez la chambre parfaite pour votre séjour premium." 
                                       style="-fx-font-size: 14; -fx-text-fill: rgba(255,255,255,0.8);"/>
                            </VBox>
                            
                            <Region HBox.hgrow="ALWAYS"/>
                            
                            <!-- Statistiques -->
                            <HBox spacing="12" alignment="CENTER">
                                <VBox alignment="CENTER" spacing="4" styleClass="glass-tile-mini" prefWidth="90">
                                    <Label text="80+" styleClass="tile-value-emerald" style="-fx-font-size: 20;"/>
                                    <Label text="HÔTELS" styleClass="tile-label-tiny"/>
                                </VBox>
                                <VBox alignment="CENTER" spacing="4" styleClass="glass-tile-mini" prefWidth="90">
                                    <Label text="500+" styleClass="tile-value-emerald" style="-fx-font-size: 20;"/>
                                    <Label text="CHAMBRES" styleClass="tile-label-tiny"/>
                                </VBox>
                                <VBox alignment="CENTER" spacing="4" styleClass="glass-tile-mini" prefWidth="90">
                                    <Label text="4.7" styleClass="tile-value-emerald" style="-fx-font-size: 20;"/>
                                    <Label text="NOTE" styleClass="tile-label-tiny"/>
                                </VBox>
                            </HBox>
                        </HBox>

                        <!-- ── Search + Actions ── -->
                        <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-padding: 20 50 0 50;">

                            <!-- Search bar -->
                            <HBox alignment="CENTER_LEFT" spacing="0" styleClass="search-bar-wrap" HBox.hgrow="ALWAYS">
                                <StackPane prefWidth="38" prefHeight="38">
                                    <SVGPath styleClass="search-icon-svg"
                                             content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                             scaleX="0.85" scaleY="0.85"/>
                                </StackPane>
                                <TextField fx:id="searchField" promptText="Rechercher une chambre, hôtel..."
                                           onKeyReleased="#searchChambres"
                                           styleClass="search-input" HBox.hgrow="ALWAYS"/>
                            </HBox>

                            <!-- Filtres rapides -->
                            <HBox spacing="8" alignment="CENTER" styleClass="lf-tab-bar">
                                <ToggleButton text="🔲 Grille" selected="true" styleClass="lf-tab lf-tab-active" />
                                <ToggleButton text="☰ Liste" styleClass="lf-tab" />
                            </HBox>

                            <!-- Chatbot IA button -->
                            <Button text="🤖 Assistant IA" onAction="#openChatbot"
                                    style="-fx-background-color: rgba(80,200,120,0.2); -fx-text-fill: #50C878;
                                           -fx-padding: 8 16; -fx-background-radius: 20; -fx-cursor: hand;
                                           -fx-font-size: 13px; -fx-font-weight: bold;
                                           -fx-border-color: rgba(80,200,120,0.4); -fx-border-radius: 20; -fx-border-width: 1;" />
                            
                            <!-- My Reservations button -->
                            <Button text="📅 Mes Réservations" onAction="#goToMyReservations"
                                    styleClass="lf-btn-primary" 
                                    style="-fx-font-size: 13px; -fx-padding: 8 20;"/>
                        </HBox>
                        
                        <!-- Ligne des filtres avancés (Hôtel, Dates) -->
                        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 14 50 0 50;">
                            <ComboBox fx:id="filterHotelCombo" promptText="🏨 Filtrer par hôtel"
                                      onAction="#filterByHotel"
                                      styleClass="lf-btn-secondary"/>
                            
                            <ComboBox promptText="🛏️ Type de chambre"
                                      styleClass="lf-btn-secondary"/>
                            
                            <Region HBox.hgrow="ALWAYS"/>
                            
                            <!-- Date arrivée / départ style bouton -->
                            <DatePicker promptText="📅 Arrivée" styleClass="lf-btn-secondary"/>
                            <DatePicker promptText="📅 Départ" styleClass="lf-btn-secondary"/>
                        </HBox>

                        <!-- ── Section Chambres Disponibles ── -->
                        <HBox alignment="TOP_CENTER" style="-fx-padding: 30 0 50 0;">
                            <VBox spacing="14" maxWidth="1200" prefWidth="1200">
                                
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Tous les hébergements"
                                           style="-fx-font-size: 18; -fx-font-weight: 800; -fx-text-fill: white;
                                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 6, 0, 0, 1);"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <ComboBox promptText="Trier par : Recommandé" 
                                              styleClass="lf-btn-secondary"/>
                                </HBox>

                                <!-- Grille de Chambres -->
                                <FlowPane fx:id="chambreCardsContainer" 
                                          hgap="20" vgap="20"
                                          style="-fx-background-color: transparent;">
                                    <padding><Insets bottom="20" right="10"/></padding>
                                </FlowPane>
                                
                                <!-- État Vide -->
                                <VBox fx:id="emptyState" alignment="CENTER" spacing="15" 
                                      styleClass="empty-state" visible="false" managed="false">
                                    <Label text="🏨" styleClass="empty-state-icon"/>
                                    <Label text="Aucune chambre trouvée" styleClass="empty-state-title"/>
                                    <Label text="Modifiez vos critères de recherche ou essayez d'autres dates" 
                                           styleClass="empty-state-subtitle"/>
                                    <Button text="↺ Réinitialiser les filtres" onAction="#handleResetFilters"
                                            styleClass="lf-btn-primary"/>
                                </VBox>
                            </VBox>
                        </HBox>
                        
                        <!-- Footer -->
                        <fx:include source="../components/Footer.fxml" fx:id="footer"/>
                        
                    </VBox>
                </content>
            </ScrollPane>
        </center>

    </BorderPane>
</StackPane>
