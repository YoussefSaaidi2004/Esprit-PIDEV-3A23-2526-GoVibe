<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.gestionvol.controller.UserDashboardController"
           styleClass="main-bg">
    
    <VBox spacing="0" VBox.vgrow="ALWAYS">
        <!-- Header Bar -->
        <HBox alignment="CENTER_LEFT" spacing="30" style="-fx-background: linear-gradient(to right, #084E36, #50C878); -fx-padding: 20 40;">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" style="-fx-fill: white;" scaleX="1.5" scaleY="1.5"/>
                <VBox spacing="2">
                    <Text text="GoVibe" style="-fx-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
                    <Text text="Your Journey Begins Here" style="-fx-fill: #A0E0C9; -fx-font-size: 11;"/>
                </VBox>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Button onAction="#handleThemeToggle" styleClass="icon-btn" prefWidth="45" prefHeight="45">
                    <graphic><Text text="🌗" style="-fx-font-size: 20px; -fx-fill: white;"/></graphic>
                </Button>
                <Button onAction="#handleAdminSwap" styleClass="icon-btn" prefWidth="45" prefHeight="45">
                    <graphic><Text text="🛡️" style="-fx-font-size: 20px; -fx-fill: white;"/></graphic>
                    <tooltip><Tooltip text="Switch to Admin Dashboard"/></tooltip>
                </Button>
                <Button styleClass="icon-btn" prefWidth="45" prefHeight="45">
                    <graphic><Text text="👤" style="-fx-font-size: 20px; -fx-fill: white;"/></graphic>
                    <tooltip><Tooltip text="User Account"/></tooltip>
                </Button>
            </HBox>
        </HBox>

        <!-- Main Content -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="50" style="-fx-padding: 40;">
                <!-- Flight Search Section -->
                <VBox spacing="25">
                    <HBox alignment="CENTER_LEFT" spacing="30">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Text text="Explore Destinations" styleClass="title"/>
                            <Text text="Find and book your next adventure with confidence" styleClass="subtitle"/>
                        </VBox>
                        
                        <HBox spacing="20" alignment="CENTER_RIGHT">
                            <VBox spacing="8" alignment="CENTER">
                                <HBox alignment="CENTER" spacing="10">
                                    <Text text="💰" style="-fx-font-size: 14px; -fx-fill: #2E8B57;"/>
                                    <Text fx:id="priceLabel" text="5000 DT" style="-fx-fill: -fx-gv-primary; -fx-font-weight: bold; -fx-font-size: 12;"/>
                                </HBox>
                                <Slider fx:id="priceSlider" min="0" max="5000" value="5000" prefWidth="180"/>
                            </VBox>
                            
                            <HBox styleClass="search-container" alignment="CENTER_LEFT" spacing="12" prefWidth="320" prefHeight="45" style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 0 20; -fx-border-color: -fx-gv-border-color; -fx-border-radius: 25; -fx-border-width: 2;">
                                <Text text="🔍" style="-fx-font-size: 16px; -fx-fill: #566573;"/>
                                <TextField fx:id="searchField" promptText="Search by airline, destination..." prefWidth="Infinity" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0; -fx-text-fill: #2d3436; -fx-prompt-text-fill: #a4b0be; -fx-font-size: 14px;"/>
                            </HBox>
                        </HBox>
                    </HBox>
                    
                    <FlowPane fx:id="flightGrid" hgap="25" vgap="25" alignment="CENTER" style="-fx-padding: 20;"/>
                </VBox>

                <Separator/>

                <!-- My Bookings Section -->
                <VBox spacing="25">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="5">
                            <Text text="My Active Bookings" styleClass="title" style="-fx-font-size: 20;"/>
                            <Text text="View and manage your upcoming flights" styleClass="subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#handleRefresh" styleClass="btn-primary" prefHeight="45" prefWidth="120">
                            <graphic>
                                <HBox alignment="CENTER" spacing="8">
                                    <Text text="🔄" style="-fx-font-size: 16px; -fx-fill: white;"/>
                                    <Text text="Refresh" style="-fx-fill: white; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                    <FlowPane fx:id="bookingGrid" hgap="25" vgap="25" alignment="CENTER" style="-fx-padding: 20;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </VBox>
</StackPane>
