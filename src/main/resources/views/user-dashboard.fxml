<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.controllers.UserDashboardController"
           stylesheets="@../styles/unified-styles.css"
           styleClass="main-bg">

    <HBox spacing="0" VBox.vgrow="ALWAYS">
        <!-- Sidebar -->
        <VBox prefWidth="240" spacing="10" alignment="TOP_CENTER"
              style="-fx-background-color: #013220; -fx-padding: 24 16;">
            <VBox alignment="CENTER" spacing="6">
                <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
                         style="-fx-fill: #A0E0C9;" scaleX="1.1" scaleY="1.1"/>
                <Text text="GoVibe" style="-fx-fill: #D1F2EB; -fx-font-size: 18; -fx-font-weight: bold;"/>
                <Text text="Espace client" style="-fx-fill: #A0E0C9; -fx-font-size: 10;"/>
            </VBox>

            <Region prefHeight="8"/>

            <Button onAction="#handleHome" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 10 14; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <SVGPath content="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"
                                 style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
                        <Text text="Accueil" style="-fx-fill: #A0E0C9;"/>
                    </HBox>
                </graphic>
            </Button>

            <Button onAction="#handleFlights" maxWidth="Infinity"
                    style="-fx-background-color: rgba(80,200,120,0.2); -fx-text-fill: #D1F2EB; -fx-font-size: 14px; -fx-padding: 10 14; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
                                 style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
                        <Text text="Vols" style="-fx-fill: #D1F2EB;"/>
                    </HBox>
                </graphic>
            </Button>

            <Button onAction="#handleLocations" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #A0E0C9; -fx-font-size: 14px; -fx-padding: 10 14; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <SVGPath content="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"
                                 style="-fx-fill: #A0E0C9;" scaleX="0.9" scaleY="0.9"/>
                        <Text text="Locations" style="-fx-fill: #A0E0C9;"/>
                    </HBox>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Button onAction="#handleLogout" maxWidth="Infinity"
                    style="-fx-background-color: rgba(231,76,60,0.15); -fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-padding: 10 14; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <SVGPath content="M16 13v-2H7V8l-5 4 5 4v-3zM20 3H9c-1.1 0-2 .9-2 2v3h2V5h11v14H9v-3H7v3c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"
                                 style="-fx-fill: #e74c3c;" scaleX="0.9" scaleY="0.9"/>
                        <Text text="Deconnexion" style="-fx-fill: #e74c3c;"/>
                    </HBox>
                </graphic>
            </Button>
        </VBox>

        <!-- Main Content -->
        <VBox spacing="0" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
            <!-- Top Bar -->
            <HBox alignment="CENTER_LEFT" spacing="20"
                  style="-fx-background-color: #0B4F35; -fx-padding: 14 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 12, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
                             style="-fx-fill: white;" scaleX="1.4" scaleY="1.4"/>
                    <VBox spacing="2">
                        <Text text="GoVibe" style="-fx-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
                        <Text text="Your Journey Begins Here" style="-fx-fill: #A0E0C9; -fx-font-size: 10;"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button onAction="#handleThemeToggle" styleClass="icon-btn" prefWidth="42" prefHeight="42">
                        <graphic>
                            <SVGPath content="M9.37 5.51A7 7 0 0 0 12 19a7 7 0 0 0 2.63-13.49A9 9 0 0 1 9.37 5.51z"
                                     style="-fx-fill: white;" scaleX="0.9" scaleY="0.9"/>
                        </graphic>
                    </Button>
                    <MenuButton fx:id="userMenu" styleClass="icon-btn" prefWidth="42" prefHeight="42"
                                style="-fx-background-color: transparent;">
                        <graphic>
                            <SVGPath content="M12 12c2.7 0 4.88-2.18 4.88-4.88S14.7 2.25 12 2.25 7.12 4.43 7.12 7.12 9.3 12 12 12zm0 2.25c-3.24 0-9.75 1.62-9.75 4.88V22h19.5v-2.87c0-3.26-6.51-4.88-9.75-4.88z"
                                     style="-fx-fill: white;" scaleX="0.9" scaleY="0.9"/>
                        </graphic>
                        <items>
                            <MenuItem text="Book a Flight" onAction="#handleBookMenu"/>
                            <MenuItem text="My Bookings" onAction="#handleBookingsMenu"/>
                            <SeparatorMenuItem />
                            <MenuItem text="Logout" onAction="#handleLogout"/>
                        </items>
                    </MenuButton>
                </HBox>
            </HBox>

            <ScrollPane fx:id="mainScroll" fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="contentRoot" spacing="28" style="-fx-padding: 28 36 50 36;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <ToggleButton fx:id="bookTab" text="Book a Flight"
                                      style="-fx-background-color: #D1F2EB; -fx-text-fill: #013220; -fx-font-weight: bold; -fx-background-radius: 18; -fx-padding: 8 16;"/>
                        <ToggleButton fx:id="bookingsTab" text="My Bookings"
                                      style="-fx-background-color: #D1F2EB; -fx-text-fill: #013220; -fx-font-weight: bold; -fx-background-radius: 18; -fx-padding: 8 16;"/>
                    </HBox>

                    <!-- Book a Flight Section -->
                    <VBox fx:id="flightsSection" spacing="22">
                        <HBox alignment="CENTER_LEFT" spacing="20">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Text text="Book a Flight" styleClass="title"/>
                                <Text text="Find and book your next adventure" styleClass="subtitle"/>
                            </VBox>
                            <HBox spacing="16" alignment="CENTER_RIGHT">
                                <VBox spacing="6" alignment="CENTER">
                                    <HBox alignment="CENTER" spacing="8">
                                        <Text text="\$" style="-fx-font-size: 12px; -fx-fill: #2E8B57;"/>
                                        <Text fx:id="priceLabel" text="5000 DT"
                                              style="-fx-fill: #2E8B57; -fx-font-weight: bold; -fx-font-size: 11;"/>
                                    </HBox>
                                    <Slider fx:id="priceSlider" min="0" max="5000" value="5000" prefWidth="170"/>
                                </VBox>

                                <HBox alignment="CENTER_LEFT" spacing="10" prefWidth="300" prefHeight="42"
                                      style="-fx-background-color: white; -fx-background-radius: 22; -fx-padding: 0 16; -fx-border-color: #D0D0D0; -fx-border-radius: 22; -fx-border-width: 2;">
                                    <SVGPath content="M15.5 14h-.79l-.28-.27A6 6 0 1 0 14 15.5l.27.28v.79L20 21.5 21.5 20l-6-6zM10 15a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"
                                             style="-fx-fill: #566573;" scaleX="0.7" scaleY="0.7"/>
                                    <TextField fx:id="searchField" promptText="Search by airline, destination..." prefWidth="Infinity"
                                               style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0; -fx-text-fill: #2d3436; -fx-prompt-text-fill: #a4b0be; -fx-font-size: 13px;"/>
                                </HBox>
                            </HBox>
                        </HBox>

                        <FlowPane fx:id="flightGrid" hgap="22" vgap="22" alignment="TOP_LEFT" style="-fx-padding: 10 0 0 0;"/>
                    </VBox>

                    <!-- My Bookings Section -->
                    <VBox fx:id="bookingsSection" spacing="22">
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="5">
                                <Text text="My Active Bookings" styleClass="title" style="-fx-font-size: 20;"/>
                                <Text text="View and manage your upcoming flights" styleClass="subtitle"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button onAction="#handleRefresh" styleClass="btn-primary" prefHeight="40" prefWidth="120">
                                <graphic>
                                    <HBox alignment="CENTER" spacing="8">
                                        <SVGPath content="M17.65 6.35A7.95 7.95 0 0 0 12 4V1L7 6l5 5V7a5 5 0 1 1-5 5H5a7 7 0 1 0 12.65-5.65z"
                                                 style="-fx-fill: white;" scaleX="0.8" scaleY="0.8"/>
                                        <Text text="Refresh" style="-fx-fill: white; -fx-font-weight: bold;"/>
                                    </HBox>
                                </graphic>
                            </Button>
                        </HBox>
                        <FlowPane fx:id="bookingGrid" hgap="22" vgap="22" alignment="TOP_LEFT" style="-fx-padding: 10 0 0 0;"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </HBox>
</StackPane>

