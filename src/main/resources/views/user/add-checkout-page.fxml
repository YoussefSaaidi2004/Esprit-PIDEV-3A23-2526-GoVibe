<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="800" prefHeight="600">
    <children>
        <VBox spacing="12" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
            <Text text="Add Checkout" style="-fx-font-size:20px; -fx-font-weight:bold;" />
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="30"/>
                    <ColumnConstraints percentWidth="70"/>
                </columnConstraints>
                <RowConstraints />
                <Label text="User ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField GridPane.rowIndex="0" GridPane.columnIndex="1" fx:id="txtUserId" />

                <Label text="Passengers:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <TextField GridPane.rowIndex="1" GridPane.columnIndex="1" fx:id="txtPassengers" />

                <Label text="Status:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <ComboBox GridPane.rowIndex="2" GridPane.columnIndex="1" fx:id="cmbStatus" />

                <Label text="Total Price:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <TextField GridPane.rowIndex="3" GridPane.columnIndex="1" fx:id="txtTotalPrice" />

                <Label text="Reservation Date:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <DatePicker GridPane.rowIndex="4" GridPane.columnIndex="1" fx:id="dpReservationDate" />
            </GridPane>

            <HBox spacing="8">
                <Button text="Save" />
                <Button text="Cancel" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>
