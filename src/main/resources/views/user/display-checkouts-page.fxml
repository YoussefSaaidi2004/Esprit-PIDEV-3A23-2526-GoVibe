<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="900" prefHeight="600">
    <top>
        <HBox style="-fx-padding:12px; -fx-alignment:center-left; -fx-spacing:10px;">
            <Text text="Display Checkouts" style="-fx-font-size:18px; -fx-font-weight:bold;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="10" style="-fx-padding:10px;" fx:id="displayContainer">
                <Text text="(Placeholder) Checkout display page. Replace with cards or table as needed." />
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
