<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.gestionvol.controller.user.UserDashboardController"
            styleClass="main-bg">
    
    <VBox spacing="0" VBox.vgrow="ALWAYS">
        <!-- Header Bar -->
        <HBox alignment="CENTER_LEFT" spacing="30" styleClass="user-header">
            <!-- Brand / Logo -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" style="-fx-fill: #50C878;" scaleX="1.4" scaleY="1.4"/>
                <VBox spacing="0">
                    <HBox spacing="0" alignment="BASELINE_LEFT">
                        <Text text="Go" style="-fx-fill: #50C878; -fx-font-weight: bold; -fx-font-size: 24px;"/>
                        <Text text="Vibe" style="-fx-fill: white; -fx-font-weight: bold; -fx-font-size: 24px;"/>
                    </HBox>
                    <Text text="Your Journey Begins Here" style="-fx-fill: #E0F2F1; -fx-font-size: 11px; -fx-font-style: italic;"/>
                </VBox>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- Action Icons -->
            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Button onAction="#handleThemeToggle" styleClass="icon-btn" prefWidth="45" prefHeight="45">
                    <graphic>
                        <SVGPath content="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-3.03 0-5.5-2.47-5.5-5.5 0-1.82.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" styleClass="header-icon" scaleX="1.2" scaleY="1.2"/>
                    </graphic>
                    <tooltip><Tooltip text="Toggle Theme"/></tooltip>
                </Button>
                
                <Button onAction="#handleAdminSwap" styleClass="icon-btn" prefWidth="45" prefHeight="45">
                    <graphic>
                        <SVGPath content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" styleClass="header-icon" scaleX="1.2" scaleY="1.2"/>
                    </graphic>
                    <tooltip><Tooltip text="Switch to Admin Dashboard"/></tooltip>
                </Button>
                
                <!-- Profile Button with Hover Logic -->
                <VBox alignment="TOP_RIGHT">
                     <Button fx:id="profileBtn" styleClass="icon-btn" prefWidth="45" prefHeight="45">
                        <graphic>
                            <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" styleClass="header-icon" scaleX="1.2" scaleY="1.2"/>
                        </graphic>
                    </Button>
                </VBox>
            </HBox>
        </HBox>

        <!-- Main Content Area -->
        <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
           <!-- Views will be loaded here -->
        </StackPane>
    </VBox>
    
    <!-- Drop-down Navigation Menu (Initially Hidden) -->
    <VBox fx:id="navMenu" visible="false" styleClass="nav-dropdown" maxWidth="200" maxHeight="200" spacing="5" StackPane.alignment="TOP_RIGHT" translateX="-20" translateY="70">
        <Button text="Book a Flight" onAction="#showFlights" styleClass="nav-item" prefWidth="180">
            <graphic>
                <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" style="-fx-fill: #2d3436;" scaleX="1.0" scaleY="1.0"/>
            </graphic>
        </Button>
        <Button text="My Bookings" onAction="#showBookings" styleClass="nav-item" prefWidth="180">
            <graphic>
                <SVGPath content="M18 17h-11c-1.1 0-2-.9-2-2v-11c0-1.1.9-2 2-2h11c1.1 0 2 .9 2 2v11c0 1.1-.9 2-2 2zm0-13h-11v11h11v-11zm-2 9h-7v-2h7v2zm0-3h-7v-2h7v2zm0-3h-7v-2h7v2z" style="-fx-fill: #2d3436;" scaleX="1.0" scaleY="1.0"/>
            </graphic>
        </Button>
        <Separator/>
        <Button text="Logout" onAction="#handleLogout" styleClass="nav-item" prefWidth="180"/>
    </VBox>

</StackPane>
