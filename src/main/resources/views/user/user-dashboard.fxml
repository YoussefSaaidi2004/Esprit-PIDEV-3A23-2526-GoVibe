<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.gestionvol.controller.user.UserDashboardController"
           styleClass="main-bg">
    
    <VBox spacing="0" VBox.vgrow="ALWAYS">
        <!-- Header Bar -->
        <!-- Header Bar -->
        <HBox alignment="CENTER_LEFT" spacing="30" styleClass="user-header">
            <!-- Brand / Logo -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" style="-fx-fill: #50C878;" scaleX="1.4" scaleY="1.4"/>
                <VBox spacing="0">
                    <HBox spacing="0" alignment="BASELINE_LEFT">
                        <Text text="Go" style="-fx-fill: #50C878; -fx-font-weight: bold; -fx-font-size: 24px;"/>
                        <Text text="Vibe" style="-fx-fill: white; -fx-font-weight: bold; -fx-font-size: 24px;"/>
                    </HBox>
                    <Text text="Your Journey Begins Here" style="-fx-fill: #E0F2F1; -fx-font-size: 11px; -fx-font-style: italic;"/>
                </VBox>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- Action Icons -->
            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Button onAction="#handleThemeToggle" styleClass="icon-btn" prefWidth="45" prefHeight="45">
                    <graphic>
                        <SVGPath content="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-3.03 0-5.5-2.47-5.5-5.5 0-1.82.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" styleClass="header-icon" scaleX="1.2" scaleY="1.2"/>
                    </graphic>
                    <tooltip><Tooltip text="Toggle Theme"/></tooltip>
                </Button>
                
                <Button onAction="#handleAdminSwap" styleClass="icon-btn" prefWidth="45" prefHeight="45">
                    <graphic>
                        <SVGPath content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" styleClass="header-icon" scaleX="1.2" scaleY="1.2"/>
                    </graphic>
                    <tooltip><Tooltip text="Switch to Admin Dashboard"/></tooltip>
                </Button>
                
                <Button styleClass="icon-btn" prefWidth="45" prefHeight="45">
                    <graphic>
                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" styleClass="header-icon" scaleX="1.2" scaleY="1.2"/>
                    </graphic>
                    <tooltip><Tooltip text="My Profile"/></tooltip>
                </Button>
            </HBox>
        </HBox>

        <!-- Main Content -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="50" style="-fx-padding: 40;">
                <!-- Flight Search Section -->
                <VBox spacing="25">
                    <HBox alignment="CENTER_LEFT" spacing="30">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Text text="Explore Destinations" styleClass="title"/>
                            <Text text="Find and book your next adventure with confidence" styleClass="subtitle"/>
                        </VBox>
                        
                        <HBox spacing="20" alignment="CENTER_RIGHT">
                            <VBox spacing="8" alignment="CENTER">
                                <HBox alignment="CENTER" spacing="10">
                                    <SVGPath content="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" style="-fx-fill: #2E8B57;" scaleX="1.2" scaleY="1.2"/>
                                    <Text fx:id="priceLabel" text="5000 DT" style="-fx-fill: -fx-gv-primary; -fx-font-weight: bold; -fx-font-size: 12;"/>
                                </HBox>
                                <Slider fx:id="priceSlider" min="0" max="5000" value="5000" prefWidth="180"/>
                            </VBox>
                            
                            <HBox styleClass="search-container" alignment="CENTER_LEFT" spacing="12" prefWidth="320" prefHeight="45" style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 0 20; -fx-border-color: -fx-gv-border-color; -fx-border-radius: 25; -fx-border-width: 2;">
                                <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" style="-fx-fill: #566573;" scaleX="1.2" scaleY="1.2"/>
                                <TextField fx:id="searchField" promptText="Search by airline, destination..." prefWidth="Infinity" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0; -fx-text-fill: #2d3436; -fx-prompt-text-fill: #a4b0be; -fx-font-size: 14px;"/>
                            </HBox>
                        </HBox>
                    </HBox>
                    
                    <FlowPane fx:id="flightGrid" hgap="25" vgap="25" alignment="CENTER" style="-fx-padding: 20;"/>
                </VBox>

                <Separator/>

                <!-- My Bookings Section -->
                <VBox spacing="25">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="5">
                            <Text text="My Active Bookings" styleClass="title" style="-fx-font-size: 20;"/>
                            <Text text="View and manage your upcoming flights" styleClass="subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#handleRefresh" styleClass="btn-primary" prefHeight="45" prefWidth="120">
                            <graphic>
                                <HBox alignment="CENTER" spacing="8">
                                    <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" style="-fx-fill: white;" scaleX="1.2" scaleY="1.2"/>
                                    <Text text="Refresh" style="-fx-fill: white; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                    <FlowPane fx:id="bookingGrid" hgap="25" vgap="25" alignment="CENTER" style="-fx-padding: 20;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </VBox>
</StackPane>
